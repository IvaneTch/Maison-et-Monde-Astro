  'grand-menage': {
    variant: 'sweep',
    title: 'Un nettoyage approfondi, préparé dans le détail.',
    label: 'UN NOUVEAU DÉPART POUR VOTRE LOGEMENT',
    icon: 'broom',
    points: [
      { icon: 'house', title: 'Les bonnes priorités', text: 'Des pièces et surfaces définies ensemble' },
      { icon: 'clock', title: 'Le temps nécessaire', text: 'Une durée adaptée à l’état du logement' },
      { icon: 'check', title: 'Un devis clair', text: 'Le périmètre et le tarif avant intervention' },
    ],
  },
  linge: {
    variant: 'ribbon',
    title: 'Chaque pli compte. Votre temps aussi.',
    label: 'LE SOIN DU LINGE À DOMICILE',
    icon: 'linen',
    points: [
      { icon: 'linen', title: 'Vos textiles', text: 'Un repassage attentif à vos consignes' },
      { icon: 'clock', title: 'Votre temps', text: 'Une tâche du quotidien déléguée' },
      { icon: 'calendar', title: 'Votre rythme', text: 'Ponctuellement ou avec votre ménage' },
    ],
  },
  bureaux: {
    variant: 'diagonal',
    title: 'Un cadre net. Une organisation claire.',
    label: 'POUR VOS ÉQUIPES ET VOS VISITEURS',
    icon: 'building',
    points: [
      { icon: 'building', title: 'Vos locaux', text: 'Un programme selon leur usage' },
      { icon: 'key', title: 'Vos accès', text: 'Des passages organisés avec vous' },
      { icon: 'calendar', title: 'Votre activité', text: 'Des horaires et une fréquence convenus' },
    ],
  },
  contact: {
    variant: 'panel',
    title: 'Un projet commence par une conversation.',
    label: 'À VOTRE ÉCOUTE DE 9 H À 20 H',
    icon: 'phone',
    points: [
      { icon: 'phone', title: 'Par téléphone', text: 'Un échange direct avec notre équipe' },
      { icon: 'user', title: 'Par message', text: 'Le temps de préciser votre demande' },
      { icon: 'pin', title: 'Près de chez vous', text: 'Paris et Île-de-France' },
    ],
  },
  regulier: {
    variant: 'flow',
    title: 'Un intérieur entretenu, un quotidien plus léger.',
    label: 'UNE PRÉSENCE RÉGULIÈRE, DES HABITUDES RESPECTÉES',
    icon: 'house',
    points: [
      { icon: 'calendar', title: 'La régularité', text: 'Des passages selon votre rythme' },
      { icon: 'shield', title: 'La confiance', text: 'Des consignes connues et partagées' },
      { icon: 'sparkle', title: 'Vos priorités', text: 'Une prestation adaptée à votre foyer' },
    ],
  },
  occasionnel: {
    variant: 'diagonal',
    title: 'Ce qu’il vous faut, au bon moment.',
    label: 'UNE INTERVENTION SELON VOTRE BESOIN',
    icon: 'sparkle',
    points: [
      { icon: 'broom', title: 'Nettoyer', text: 'Un entretien ponctuel ou approfondi' },
      { icon: 'linen', title: 'Prendre soin', text: 'Du linge et des espaces du quotidien' },
      { icon: 'calendar', title: 'Organiser', text: 'Une date et un périmètre convenus' },
    ],
  },
  test: {
    variant: 'panel',
    title: 'Faisons connaissance, chez vous.',
    label: 'VOTRE PREMIÈRE INTERVENTION',
    icon: 'house',
    points: [
      { icon: 'user', title: 'Un premier échange', text: 'Vous nous présentez vos attentes' },
      { icon: 'broom', title: 'Une prestation définie', text: 'Les priorités sont précisées ensemble' },
      { icon: 'check', title: 'Votre retour', text: 'Nous faisons le point avec vous' },
    ],
  },
  gestion: {
    variant: 'diagonal',
