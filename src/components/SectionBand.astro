      { icon: 'phone', title: 'Un échange direct', text: '07 45 29 25 85' },
      { icon: 'house', title: 'Votre logement', text: 'Une proposition personnalisée' },
      { icon: 'shield', title: 'Sans engagement', text: 'Le temps de bien choisir' },
    ],
  },
  'devis-menage': {
    variant: 'compact',
    title: 'Le soin commence par vos priorités.',
    label: 'VOTRE DEMANDE DE DEVIS MÉNAGE',
    icon: 'broom',
    points: [
      { icon: 'house', title: 'Votre logement', text: 'Ses caractéristiques' },
      { icon: 'broom', title: 'Vos besoins', text: 'Les tâches souhaitées' },
      { icon: 'calendar', title: 'Votre rythme', text: 'Les disponibilités utiles' },
    ],
  },
  'devis-conciergerie': {
    variant: 'compact',
    title: 'Un projet locatif qui vous ressemble.',
    label: 'CONSTRUISONS VOTRE ACCOMPAGNEMENT',
    icon: 'key',
    points: [
      { icon: 'house', title: 'Votre bien', text: 'Son espace et ses voyageurs' },
      { icon: 'key', title: 'Vos services', text: 'La formule qui vous convient' },
      { icon: 'user', title: 'Notre échange', text: 'Une proposition personnalisée' },
    ],
  },
};
const { theme = 'regulier', title: customTitle, label: customLabel, className = '' } = Astro.props;
const profil = profils[theme] || profils.regulier;
const title = customTitle || profil.title;
const label = customLabel || profil.label;
const points = profil.points;
const side = ['grand-menage', 'gestion', 'suivi', 'devis-conciergerie'].includes(theme) ? 'right' : 'left';
---

<section class:list={['mm-section-band', className]} data-theme={theme} data-variant={profil.variant} data-side={side} aria-label="Nos engagements">
  <svg class="mm-band-lines" viewBox="0 0 1440 340" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="mm-home-band-gradient" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1440" y2="0">
        <stop offset="0%" stop-color="var(--mm-band-blue-start)" />
        <stop offset="28%" stop-color="var(--mm-band-blue-mid)" />
        <stop offset="63%" stop-color="var(--mm-band-blue-deep)" />
        <stop offset="100%" stop-color="var(--mm-band-blue-end)" />
      </linearGradient>
    </defs>
    <path
      class="mm-band-fill"
      fill="url(#mm-home-band-gradient)"
      d={
        side === 'left'
          ? 'M-20 58 C330 8 830 42 1460 20 L1460 315 C1060 355 480 295 -20 325 Z'
          : 'M-20 20 C610 48 1110 3 1460 58 L1460 325 C960 295 380 355 -20 315 Z'
      }
    />
    <path
      d={
        side === 'left'
          ? 'M-30 54 C330 4 830 38 1470 16 M-30 321 C480 291 1060 351 1470 311'
          : 'M-30 16 C610 44 1110 0 1470 54 M-30 311 C380 351 960 291 1470 321'
      }
    />
    <path
      d={
        side === 'left'
          ? 'M-30 64 C340 14 850 48 1470 26 M-30 331 C480 301 1070 361 1470 321'
          : 'M-30 26 C620 54 1120 10 1470 64 M-30 321 C390 361 970 301 1470 331'
      }
    />
  </svg>
  <div class="mm-band-watermark" aria-hidden="true">
    <Icon name={profil.icon} />
  </div>
  <div class="mm-band-inner">
    <div class="mm-band-heading">
      <p>{label}</p>
      <h2>{title}</h2>
    </div>
    <div class="mm-band-points">
      {points.map((point) => (
        <div>
          <span class="mm-band-icon">
            <Icon name={point.icon} />
          </span>
          <h3>{point.title}</h3>
          <p>{point.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

