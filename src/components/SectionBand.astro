    label: 'COORDONNER LES SÉJOURS ET LES INTERVENTIONS',
    icon: 'key',
    points: [
      { icon: 'calendar', title: 'Planifier', text: 'Les interventions liées aux séjours' },
      { icon: 'key', title: 'Accueillir', text: 'Les arrivées selon votre organisation' },
      { icon: 'shield', title: 'Suivre', text: 'Les besoins de votre logement' },
    ],
  },
  preparation: {
    variant: 'sweep',
    title: 'Le plaisir d’arriver dans un logement prêt.',
    label: 'ENTRE DEUX SÉJOURS, CHAQUE DÉTAIL COMPTE',
    icon: 'broom',
    points: [
      { icon: 'broom', title: 'Un espace soigné', text: 'Une préparation selon les consignes' },
      { icon: 'linen', title: 'Le linge prévu', text: 'Une mise en place organisée avec vous' },
