    ],
  },
  suivi: {
    variant: 'panel',
    title: 'Un regard attentif, même à distance.',
    label: 'VOUS GARDEZ LA MAÎTRISE DE VOTRE LOGEMENT',
    icon: 'tools',
    points: [
      { icon: 'house', title: 'Observer', text: 'Les points prévus lors du passage' },
      { icon: 'phone', title: 'Vous informer', text: 'Les anomalies et besoins repérés' },
      { icon: 'check', title: 'Agir avec accord', text: 'Les interventions définies ensemble' },
    ],
  },
  carte: {
    variant: 'diagonal',
    title: 'Vos besoins dessinent votre conciergerie.',
    label: 'L’ESSENTIEL, LES COMPLÉMENTS, VOTRE CHOIX',
    icon: 'basket',
    points: [
      { icon: 'linen', title: 'Le linge', text: 'L’entretien et la préparation prévus' },
      { icon: 'basket', title: 'Les essentiels', text: 'Les courses et le réassort convenus' },
      { icon: 'sparkle', title: 'Les attentions', text: 'Des demandes étudiées au cas par cas' },
