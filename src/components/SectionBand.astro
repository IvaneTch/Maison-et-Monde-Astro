    points: [
      { icon: 'house', title: 'Le logement', text: 'Sa surface et sa configuration' },
      { icon: 'calendar', title: 'Les séjours', text: 'Leur rythme et leur organisation' },
      { icon: 'check', title: 'Les prestations', text: 'Les missions et frais explicités' },
