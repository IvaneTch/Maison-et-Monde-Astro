---
import '../styles/section-band.css';
import Icon from './ConciergerieIcon.astro';
interface Props {
  title?: string;
  label?: string;
  conciergerie?: boolean;
  theme?: string;
  className?: string;
}
const profils: Record<
  string,
  {
    variant: string;
    title: string;
    label: string;
    icon: string;
    points: { icon: string; title: string; text: string }[];
  }
