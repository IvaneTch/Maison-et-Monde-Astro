---
import { secteurs } from '../data/secteurs';
import '../styles/secteurs.css';
interface Props {
  all?: boolean;
}
const { all = false } = Astro.props;
const affiches = all ? secteurs : secteurs.slice(0, 4);
---

<section
  class:list={['local-areas', { 'local-areas--compact': !all }]}
  aria-label="Nos secteurs d’intervention"
>
  <div class="local-areas-copy">
    <p class="local-eyebrow">PRÈS DE CHEZ VOUS</p>
    <h2>Ménage à Paris et en Île-de-France</h2>
    <p>
      {all
        ? 'Découvrez nos prestations et les informations utiles pour préparer une intervention dans votre secteur.'
        : 'Retrouvez nos prestations dans votre secteur.'}
    </p>
  </div>
  <div class="local-areas-links">
    <nav aria-label="Secteurs de ménage à domicile">
      {affiches.map((s) => (
        <a href={s.path}>
          Ménage à {s.nom} <span aria-hidden="true">→</span>
        </a>
      ))}
    </nav>
    <a class="local-all" href="/zones-intervention/">
      Toutes nos zones d’intervention →
    </a>
  </div>
</section>
