<style is:global>
  /* Menu intelligent : visible lorsque le visiteur remonte la page. */
  .header.mm-smart-fixed {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    z-index: 9999 !important;
    transform: translateY(0);
    transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .header.mm-smart-fixed.mm-smart-hidden {
    transform: translateY(calc(-100% - 3px));
  }
  @media (prefers-reduced-motion: reduce) {
    .header.mm-smart-fixed { transition: none; }
  }

  .header .services-dropdown { position: relative; }
  .header .services-dropdown > summary { cursor: pointer; list-style: none; display: flex; align-items: center; gap: .4rem; }
  .header .services-dropdown > summary::-webkit-details-marker,
  .header .mobile-services-dropdown > summary::-webkit-details-marker { display: none; }
  .header .services-dropdown > summary:focus-visible,
  .header .mobile-services-dropdown > summary:focus-visible { outline: 2px solid #e9a34c; outline-offset: 4px; }
  .header .services-dropdown-links { position: absolute; z-index: 1000; top: 100%; left: 0; min-width: 245px; padding: 8px; border: 1px solid rgba(233,163,76,.4); border-radius: 12px; background: #071b30; box-shadow: 0 16px 35px rgba(0,0,0,.25); }
  .header .services-dropdown-links a { display: block; padding: 11px 13px; color: #fff; white-space: nowrap; border-radius: 7px; text-decoration: none; }
  .header .services-dropdown-links a:hover,
  .header .services-dropdown-links a:focus-visible { color: #e9a34c; background: rgba(255,255,255,.08); }
  .header .mobile-services-dropdown > summary { display: flex; justify-content: space-between; align-items: center; padding: 12px 6px; cursor: pointer; color: #fff; border-bottom: 1px solid rgba(255,255,255,.12); }
  .header .mobile-services-links { padding-left: 16px; }
  .header .mobile-services-links a { display: block; padding: 12px 6px; color: #fff; text-decoration: none; }
  .header .mobile-services-links a:hover,
  .header .mobile-services-links a:focus-visible { color: #e9a34c; }
  @media (max-width: 768px) { .header .services-dropdown { display: none; } }
</style>

<script>
  // Sur ordinateur : ouverture au survol, fermeture à la sortie.
  // Le clic reste utilisable au clavier et sur les appareils tactiles.
  const menu = document.querySelector<HTMLDetailsElement>('.header .services-dropdown');
  if (menu) {
    const desktop = window.matchMedia('(min-width: 901px) and (hover: hover)');
    menu.addEventListener('mouseenter', () => {
      if (desktop.matches) menu.open = true;
    });
    menu.addEventListener('mouseleave', () => {
      if (desktop.matches && !menu.contains(document.activeElement)) menu.open = false;
    });
    menu.addEventListener('focusout', (event) => {
      if (desktop.matches && !menu.contains(event.relatedTarget as Node | null)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<script>
  // Smart header stable : aucune modification de la mise en page pendant le scroll.
  const header = document.querySelector<HTMLElement>('header.header');
  if (header && !header.dataset.smartHeaderReady) {
    header.dataset.smartHeaderReady = 'true';
    const spacer = document.createElement('div');
    spacer.setAttribute('aria-hidden', 'true');
    header.insertAdjacentElement('afterend', spacer);

    const syncHeight = () => {
      spacer.style.height = `${header.offsetHeight}px`;
    };
    syncHeight();
    header.classList.add('mm-smart-fixed');

    let previousY = Math.max(0, window.scrollY);
    let direction: 'up' | 'down' | null = null;
    let distance = 0;
    let ticking = false;
    const SHOW_AFTER_UP_PX = 55;
    const HIDE_AFTER_DOWN_PX = 25;

    const updateHeader = () => {
      const y = Math.max(0, window.scrollY);
      const delta = y - previousY;
      previousY = y;
      ticking = false;

      // Tout en haut, le menu doit rester visible.
      if (y <= header.offsetHeight + 20) {
        header.classList.remove('mm-smart-hidden');
        distance = 0;
        direction = null;
        return;
      }

      // Ne pas réagir aux variations de moins d'un pixel.
      if (Math.abs(delta) < 1) return;
      const nextDirection = delta < 0 ? 'up' : 'down';
      if (direction !== nextDirection) {
        direction = nextDirection;
        distance = 0;
      }
      distance += Math.abs(delta);

      const menuOpen = Boolean(header.querySelector('details[open]'));
      if (menuOpen) {
        header.classList.remove('mm-smart-hidden');
        distance = 0;
        return;
      }
      if (direction === 'up' && distance >= SHOW_AFTER_UP_PX) {
        header.classList.remove('mm-smart-hidden');
        distance = 0;
      } else if (direction === 'down' && distance >= HIDE_AFTER_DOWN_PX) {
        header.classList.add('mm-smart-hidden');
        distance = 0;
      }
    };

    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateHeader);
      }
    }, { passive: true });
    window.addEventListener('resize', () => {
      syncHeight();
      updateHeader();
    }, { passive: true });
    // Au chargement d'une page déjà défilée, masquer le menu.
    if (previousY > header.offsetHeight + 20) {
      header.classList.add('mm-smart-hidden');
    }
  }
</script>
