---
import '../styles/floating-contact.css';
---

<div class="mm-floating-contact">
  <a href="tel:+33745292585" class="mm-float-btn mm-call" aria-label="Nous appeler">
    <span class="mm-icon" aria-hidden="true">
      ☎
    </span>
    <span class="mm-label">Nous appeler</span>
  </a>

  <button type="button" class="mm-float-btn mm-callback" id="mm-open-callback">
    <span class="mm-icon" aria-hidden="true">
      ↩
    </span>
    <span class="mm-label">Être rappelé</span>
  </button>
</div>

<dialog aria-labelledby="mm-callback-title" id="mm-callback-dialog" class="mm-callback-dialog">
  <div class="mm-dialog-head">
    <h2 id="mm-callback-title">Être rappelé</h2>
    <button type="button" id="mm-close-callback" aria-label="Fermer">
      ×
    </button>
  </div>

  <p>Laissez-nous vos coordonnées. Nous vous recontacterons dès que possible.</p>

  <form id="mm-callback-form" data-contact-form>
    <input type="hidden" name="type_demande" value="rappel" />
    <div class="mm-honeypot" aria-hidden="true">
      <label>
        Site internet
        <input name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>
    <label for="mm-callback-name">Votre prénom</label>
    <input id="mm-callback-name" name="prenom" required autocomplete="given-name" />

    <label for="mm-callback-phone">Votre téléphone</label>
    <input id="mm-callback-phone" name="telephone" type="tel" required autocomplete="tel" />

    <label for="mm-callback-time">Quand souhaitez-vous être rappelé ?</label>
    <select id="mm-callback-time" name="disponibilite">
      <option value="Dès que possible">Dès que possible</option>
      <option value="Le matin">Le matin</option>
      <option value="L’après-midi">L’après-midi</option>
      <option value="En soirée">En soirée</option>
    </select>

    <label class="mm-callback-consent">
      <input type="checkbox" name="confidentialite" required /> J’accepte l’utilisation de mon téléphone pour
      répondre à ma demande. *
    </label>
    <p>
      <a href="/politique-de-confidentialite/">Politique de confidentialité</a>
    </p>
    <button type="submit" class="mm-submit">
      Demander un rappel
    </button>
    <p data-contact-status id="mm-callback-status" role="status" aria-live="polite"></p>
  </form>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#mm-callback-dialog');
  const openButton = document.querySelector<HTMLButtonElement>('#mm-open-callback');
  const closeButton = document.querySelector<HTMLButtonElement>('#mm-close-callback');
  const form = document.querySelector<HTMLFormElement>('#mm-callback-form');
  const status = document.querySelector<HTMLElement>('#mm-callback-status');

  openButton?.addEventListener('click', () => dialog?.showModal());
  closeButton?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('close', () => {
    if (dialog.returnValue === 'submitted' && status) {
      status.dataset.state = 'success';
      status.textContent = 'Votre demande de rappel est enregistrée. Merci !';
    }
  });

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
<script src="../scripts/contact.ts"></script>
