---
import '../styles/footer.css';
import { entreprise as coordonnees, bureaux } from '../data/entreprise';

const entreprise = 'Maison & Monde';
---

<footer class="site-footer">
  <!-- Vague commune à toutes les pages : courbe originale de l'accueil et filet doré -->
  <svg
    class="footer-top-wave"
    viewBox="0 0 1440 90"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M0 10 C340 95 1070 95 1440 10 L1440 90 L0 90Z" fill="#103c5e" />
    <path d="M0 12 C340 97 1070 97 1440 12" fill="none" stroke="#f0aa40" stroke-width="2" />
  </svg>
  <div class="footer-main">
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <img src="/favicon.png" alt="" width="65" height="65" />
        <span>
          Maison <b>&amp; Monde</b>
        </span>
      </a>
      <span class="footer-tagline">Ménage, repassage &amp; conciergerie</span>
      <p>
        Votre partenaire de confiance pour un intérieur propre, sain et agréable à Paris et en Île-de-France.
        Des interventions de qualité, réalisées par des professionnelles de confiance.
      </p>
      <div class="footer-social" aria-label="Réseaux sociaux de Maison & Monde">
        <a
          href="https://www.facebook.com/MaisonEtMonde.fr"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Maison & Monde sur Facebook"
          title="Facebook"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13.5 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.5 1.6-1.5h1.7V3.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.4H7.3v3.2h2.8V21h3.4z" />
          </svg>
        </a>
        <a
          href="https://www.instagram.com/maison_et_monde/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Maison & Monde sur Instagram"
          title="Instagram"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a
          href="https://www.tiktok.com/@maison_et_monde"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Maison & Monde sur TikTok"
          title="TikTok"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M16.7 2h-3.1v13.1a3.1 3.1 0 1 1-2.7-3.07V8.88a6.25 6.25 0 1 0 5.8 6.22V8.43a8.1 8.1 0 0 0 4.7 1.5V6.82A4.72 4.72 0 0 1 16.7 2z" />
          </svg>
        </a>
        <a
          href="https://wa.me/33745292585"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Écrire à Maison & Monde sur WhatsApp"
          title="WhatsApp"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-8.65 15.02L2 22l5.12-1.34A10 10 0 1 0 12 2zm0 18.2a8.15 8.15 0 0 1-4.15-1.14l-.3-.18-3.03.8.81-2.95-.2-.31A8.2 8.2 0 1 1 12 20.2zm4.5-6.15c-.25-.13-1.47-.73-1.7-.81-.23-.08-.4-.13-.57.13-.17.25-.65.81-.8.97-.14.17-.29.19-.54.07-.25-.13-1.05-.39-2-1.24-.74-.66-1.24-1.48-1.39-1.73-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.17.04-.32-.02-.44-.06-.13-.57-1.37-.78-1.88-.2-.49-.41-.42-.57-.43h-.48c-.17 0-.44.06-.67.32-.23.25-.88.86-.88 2.1s.9 2.43 1.03 2.6c.13.17 1.77 2.7 4.29 3.79.6.26 1.07.41 1.44.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z" />
          </svg>
        </a>
      </div>
    </div>
    <details open class="footer-accordion footer-accordion-footer-services">
      <summary>
        Nos prestations<span class="footer-accordion-chevron" aria-hidden="true"></span>
      </summary>
      <div class="footer-column footer-services">
        <h2>Nos prestations</h2>
        <a href="/menage-regulier-a-domicile/">
          Services réguliers <span>›</span>
        </a>
        <a href="/services-occasionnels/">
          Services occasionnels <span>›</span>
        </a>
        <a href="/service-de-menage-test/">
          Services test <span>›</span>
        </a>
        <a href="/repassage-a-domicile-paris/">
          Services de repassage <span>›</span>
        </a>
        <a href="/conciergerie/">
          Services de conciergerie <span>›</span>
        </a>
      </div>
    </details>
    <details open class="footer-accordion footer-accordion-links">
      <summary>
        Liens utiles<span class="footer-accordion-chevron" aria-hidden="true"></span>
      </summary>
      <div class="footer-column">
        <h2>Liens utiles</h2>
        <a href="/#avantages">Nos avantages</a>
        <a href="/a-propos/">À propos de Maison &amp; Monde</a>
        <a href="/#avis">Avis clients</a>
        <a href="/devis-simple/" data-open-devis-simple>
          Demander un devis
        </a>
        <a href="/devis-professionnel/">Devis professionnel</a>
        <a href="/conseils/">Conseils &amp; guides</a>
        <a href="/zones-intervention/">Zones d’intervention</a>
        <a href="tel:+33745292585">Nous contacter</a>
      </div>
    </details>
    <details open class="footer-accordion footer-accordion-footer-contact">
      <summary>
        Contact<span class="footer-accordion-chevron" aria-hidden="true"></span>
      </summary>
      <div class="footer-column footer-contact">
        <h2>Contact</h2>
        <a class="footer-contact-item" href="tel:+33980386848">
          <span class="footer-contact-icon">
            <svg
              viewBox="0 0 24 24"
              width="30"
              height="30"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7l.5 2.8a2 2 0 0 1-.6 1.8L7.5 9.8a16 16 0 0 0 6.7 6.7l1.5-1.5a2 2 0 0 1 1.8-.6l2.8.5a2 2 0 0 1 1.7 2Z" />
            </svg>
          </span>
          <span>09 80 38 68 48</span>
        </a>
        <a class="footer-contact-item" href="tel:+33745292585">
          <span class="footer-contact-icon">
            <svg
              viewBox="0 0 24 24"
              width="30"
              height="30"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7l.5 2.8a2 2 0 0 1-.6 1.8L7.5 9.8a16 16 0 0 0 6.7 6.7l1.5-1.5a2 2 0 0 1 1.8-.6l2.8.5a2 2 0 0 1 1.7 2Z" />
            </svg>
          </span>
          <span>07 45 29 25 85</span>
        </a>

        <p class="footer-contact-item">
          <span class="footer-contact-icon">
            <svg
              viewBox="0 0 24 24"
              width="30"
              height="30"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>
          </span>
          <span>
            Paris et Île-de-France
            <br />
            <small>Interventions dans Paris et les communes voisines</small>
          </span>
        </p>
        <a class="footer-cta mm-button" href="/devis-simple/" data-open-devis-simple>
          Demander un devis <span aria-hidden="true">→</span>
        </a>
      </div>
    </details>
    <div class="footer-map-col">
      <img
        src="/images/carte-france-maison-et-monde.png"
        width="220"
        height="220"
        loading="lazy"
        alt="Carte stylisée de France indiquant la région parisienne"
      />
      <p>
        Nous intervenons
        <br />à Paris et en
        <br />
        Île-de-France.
      </p>
    </div>
  </div>
  <div class="footer-trust" aria-label="Les engagements Maison et Monde">
    <div>
      <span class="trust-icon">
        <svg
          viewBox="0 0 24 24"
          width="30"
          height="30"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="8" r="5" />
          <path d="m8.5 12-2 9 5.5-3 5.5 3-2-9" />
          <path d="m10 8 1.5 1.5L14 7" />
        </svg>
      </span>
      <span>
        Intervenantes
        <br />
        <small>expérimentées</small>
      </span>
    </div>
    <div>
      <span class="trust-icon">
        <svg
          viewBox="0 0 24 24"
          width="30"
          height="30"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 2 20 5v6c0 5-3.4 8.5-8 11-4.6-2.5-8-6-8-11V5z" />
          <path d="m8.5 12 2.3 2.3 4.8-5" />
        </svg>
      </span>
      <span>
        Service fiable
        <br />
        <small>et sécurisé</small>
      </span>
    </div>
    <div>
      <span class="trust-icon">
        <svg
          viewBox="0 0 24 24"
          width="30"
          height="30"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="5" width="18" height="16" rx="2" />
          <path d="M7 3v4M17 3v4M3 10h18M7 14h2M12 14h2M17 14h.01M7 18h2" />
        </svg>
      </span>
      <span>
        Horaires flexibles
        <br />
        <small>selon vos besoins</small>
      </span>
    </div>
    <div>
      <span class="trust-icon">
        <svg
          viewBox="0 0 24 24"
          width="30"
          height="30"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 4C10 4 4 8 4 15a5 5 0 0 0 5 5c7 0 11-6 11-16Z" />
          <path d="M4 21c3-6 7-9 12-12" />
        </svg>
      </span>
      <span>
        Produits de qualité
        <br />
        <small>et respectueux</small>
      </span>
    </div>
    <div>
      <span class="trust-icon">
        <svg
          viewBox="0 0 24 24"
          width="30"
          height="30"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="5" width="20" height="14" rx="2" />
          <path d="M2 10h20M6 15h4" />
        </svg>
      </span>
      <span>
        50 % de crédit d'impôt
        <br />
        <small>selon éligibilité</small>
      </span>
    </div>
    <div>
      <span class="trust-icon">
        <svg
          viewBox="0 0 24 24"
          width="30"
          height="30"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
        </svg>
      </span>
      <span>
        Satisfaction
        <br />
        <small>client au cœur de nos priorités</small>
      </span>
    </div>
  </div>
  <p class="footer-company-info">
    {bureaux.map((b) => `${b.nom} : ${b.adresse}, ${b.codePostal} ${b.ville}`).join(' · ')}
    <br />
    {coordonnees.horaires}
  </p>
  <div class="footer-bottom">
    <span>
      © {new Date().getFullYear()} {entreprise} — Tous droits réservés.
    </span>
    <div>
      <a href="/mentions-legales/">Mentions légales</a>
      <a href="/politique-de-confidentialite/">Politique de confidentialité</a>
      <a href="/cgv/">CGV</a>
      <a href="/plan-du-site/">Plan du site</a>
      <button type="button" id="mm-cookie-manage" class="footer-cookie-link mm-button-text">
        Gérer les cookies
      </button>
    </div>
  </div>
</footer>

<script>
  // Les accordéons sont ouverts sur ordinateur, repliés sur téléphone.
  const setupFooterAccordions = () => {
    const mobile = window.matchMedia('(max-width: 768px)');
    const accordions = document.querySelectorAll<HTMLDetailsElement>('.site-footer .footer-accordion');
    const sync = () => {
      accordions.forEach((item) => {
        item.open = !mobile.matches;
      });
    };
    sync();
    mobile.addEventListener('change', sync);
  };
  setupFooterAccordions();
  document.addEventListener('astro:page-load', setupFooterAccordions);
</script>
