---
import '../styles/devis-simple-modal.css';
/*
 * MAISON & MONDE
 * Composant : DevisSimpleModal
 * Fonction : Formulaire rapide de demande de devis
 * DCT : Composant réutilisable sur plusieurs pages
 */
---

<dialog id="devis-simple-modal" aria-labelledby="devis-simple-titre">
  <div class="modal-contenu">
    <button
      type="button"
      class="fermer mm-button-icon"
      data-close-devis-simple
      aria-label="Fermer le formulaire"
    >
      ✕
    </button>

    <header class="modal-header">
      <div class="identite">
        <img src="/images/logo-admin.png" alt="Logo Maison & Monde" class="logo" />
        <div>
          <span class="marque">Maison & Monde</span>
          <span class="sous-titre">SERVICES À LA PERSONNE</span>
        </div>
      </div>

      <div class="introduction">
        <h2 id="devis-simple-titre">Demandez votre devis gratuit</h2>
        <p>Réponse rapide et personnalisée</p>
        <span class="ligne-doree"></span>
      </div>
    </header>

    <form id="formulaire-devis-simple">
      <input type="hidden" name="type_devis" value="simple" />
      <div class="colonnes">
        <!-- COLONNE GAUCHE -->
        <section class="colonne-gauche">
          <fieldset>
            <legend>
              <svg
                class="svg-icone svg-titre"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="3" y="5" width="18" height="16" rx="2" />
                <path d="M7 3v4M17 3v4M3 10h18" />
              </svg>{' '}
              &nbsp; Fréquence souhaitée <span>*</span>
            </legend>

            <div class="choix-grille">
              <label class="carte">
                <input type="radio" name="frequence" value="Reguliere" required />
                <span class="carte-contenu">
                  <span class="icone">
                    <svg
                      class="svg-icone svg-card"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect x="3" y="5" width="18" height="16" rx="2" />
                      <path d="M7 3v4M17 3v4M3 10h18" />
                      <path d="M8 14h3m-3 3h5" />
                    </svg>
                  </span>
                  <strong>Régulière</strong>
                  <small>Toutes les semaines ou toutes les 2 semaines</small>
                </span>
              </label>

              <label class="carte">
                <input type="radio" name="frequence" value="Occasionnelle" required />
                <span class="carte-contenu">
                  <span class="icone">
                    <svg
                      class="svg-icone svg-card"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect x="3" y="5" width="18" height="16" rx="2" />
                      <path d="M7 3v4M17 3v4M3 10h18" />
                      <path d="m9 16 2 2 4-4" />
                    </svg>
                  </span>
                  <strong>Occasionnelle</strong>
                  <small>Une intervention ponctuelle</small>
                </span>
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend>
              <svg
                class="svg-icone svg-titre"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m12 3 1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8zM19 17l.7 2.3L22 20l-2.3.7L19 23l-.7-2.3L16 20l2.3-.7z" />
              </svg>{' '}
              &nbsp; Prestations souhaitées <span>*</span>
            </legend>

            <p class="aide-multichoix">Vous pouvez sélectionner plusieurs prestations.</p>
            <div class="choix-grille">
              <label class="carte">
                <input type="checkbox" name="prestations_selectionnees" value="Menage a domicile" />
                <span class="carte-contenu">
                  <span class="icone">
                    <svg
                      class="svg-icone svg-card"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m3 11 9-8 9 8v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z" />
                      <path d="M9 21v-7h6v7" />
                      <path d="m18 4 .5 1.5L20 6l-1.5.5L18 8l-.5-1.5L16 6l1.5-.5z" />
                    </svg>
                  </span>
                  <strong>Ménage à domicile</strong>
                  <small>Entretien de votre logement</small>
                </span>
              </label>

              <label class="carte">
                <input type="checkbox" name="prestations_selectionnees" value="Repassage" />
                <span class="carte-contenu">
                  <span class="icone">
                    <svg
                      class="svg-icone svg-card"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M4 17h16l-3-7c-.5-1.2-1.7-2-3-2H9c-1.4 0-2.7.9-3.2 2.2L4 17z" />
                      <path d="M4 17v3h16v-3M11 8V5h6M9 12h5" />
                    </svg>
                  </span>
                  <strong>Repassage</strong>
                  <small>À votre domicile</small>
                </span>
              </label>

              <label class="carte">
                <input type="checkbox" name="prestations_selectionnees" value="Nettoyage de vitres" />
                <span class="carte-contenu">
                  <span class="icone">
                    <svg
                      class="svg-icone svg-card"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect x="3" y="3" width="18" height="18" rx="1.5" />
                      <path d="M12 3v18M3 12h18m-12-6-2 3m10 6-2 3" />
                    </svg>
                  </span>
                  <strong>Vitres simples avec le ménage</strong>
                  <small>Vitres accessibles, sans matériel spécialisé</small>
                </span>
              </label>

              <label class="carte">
                <input type="checkbox" name="prestations_selectionnees" value="Autre prestation" />
                <span class="carte-contenu">
                  <span class="icone">
                    <svg
                      class="svg-icone svg-card"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="9" />
                      <circle cx="8" cy="12" r="1" fill="currentColor" stroke="none" />
                      <circle cx="12" cy="12" r="1" fill="currentColor" stroke="none" />
                      <circle cx="16" cy="12" r="1" fill="currentColor" stroke="none" />
                    </svg>
                  </span>
                  <strong>Autre prestation</strong>
                  <small>Autres besoins de nettoyage</small>
                </span>
              </label>
            </div>
          </fieldset>
        </section>

        <!-- COLONNE DROITE -->
        <section class="colonne-droite">
          <h3>
            <svg
              class="svg-icone svg-titre"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <circle cx="9" cy="11" r="2" />
              <path d="M6 16c.6-2 5.4-2 6 0M15 10h4M15 14h4" />
            </svg>{' '}
            &nbsp; Vos coordonnées <span>*</span>
          </h3>

          <div class="champs">
            <label>
              <span>Prénom *</span>
              <input
                type="text"
                name="prenom"
                placeholder="Votre prénom"
                autocomplete="given-name"
                required
              />
            </label>

            <label>
              <span>Nom *</span>
              <input type="text" name="nom" placeholder="Votre nom" autocomplete="family-name" required />
            </label>
            <label>
              <span>Adresse de l'intervention *</span>
              <input
                type="text"
                name="adresse"
                placeholder="Numéro, rue et ville"
                autocomplete="street-address"
                required
              />
            </label>
            <label>
              <span>Code postal *</span>
              <input
                type="text"
                name="code_postal"
                placeholder="Ex. : 75014"
                autocomplete="postal-code"
                inputmode="numeric"
                pattern="[0-9]{5}"
                maxlength="5"
                required
              />
            </label>

            <label>
              <span>Téléphone *</span>
              <input
                type="tel"
                name="telephone"
                placeholder="Ex. : 06 00 00 00 00"
                autocomplete="tel"
                required
              />
            </label>

            <label>
              <span>Adresse e-mail *</span>
              <input type="email" name="email" placeholder="exemple@email.fr" autocomplete="email" required />
            </label>
          </div>
        </section>
      </div>

      <footer class="modal-footer">
        <button type="submit" class="envoyer mm-button">
          ➤ &nbsp; Demander mon devis gratuit &nbsp; →
        </button>

        <div class="separateur">
          <span>ou</span>
        </div>

        <a href="/devis-detaille/" class="lien-detaille">
          Faire une demande de devis détaillée →
        </a>

        <p>Pour préciser davantage vos besoins</p>

        <label class="devis-simple-consent">
          <input type="checkbox" name="confidentialite" required /> J’accepte l’utilisation de mes coordonnées
          pour traiter ma demande. *
        </label>
        <p id="devis-simple-erreur" role="alert" hidden></p>
        <p class="confidentialite">
          Vos informations seront utilisées uniquement pour traiter votre demande de devis.{' '}
          <a href="/politique-de-confidentialite/">Politique de confidentialité</a>.
        </p>
      </footer>
    </form>

    <!-- Confirmation intégrée : remplace l’alerte native du navigateur. -->
    <section
      id="devis-simple-confirmation"
      class="devis-confirmation"
      role="status"
      aria-live="polite"
      aria-labelledby="devis-confirmation-titre"
      hidden
    >
      <div class="devis-confirmation-icone" aria-hidden="true">
        ✓
      </div>
      <span class="devis-confirmation-surtitre">MAISON &amp; MONDE · CONFIRMATION</span>
      <h2 id="devis-confirmation-titre">Votre demande a bien été envoyée !</h2>
      <p>Merci pour votre confiance. Nous avons bien reçu votre demande de devis.</p>
      <p>
        Notre équipe l’étudiera et vous contactera prochainement afin de vous proposer une prestation adaptée
        à vos besoins.
      </p>
      <div class="devis-confirmation-reference">
        Votre référence : <strong id="devis-confirmation-reference"></strong>
      </div>
      <button type="button" class="devis-confirmation-terminer mm-button" data-close-devis-simple>
        Terminer →
      </button>
    </section>
  </div>
</dialog>

<script>
  const notice = document.querySelector<HTMLElement>('#devis-simple-erreur');
  const afficherErreur = (message: string) => {
    if (notice) {
      notice.textContent = message;
      notice.hidden = false;
    }
  };
  const modal = document.querySelector<HTMLDialogElement>('#devis-simple-modal');

  const formulaire = document.querySelector<HTMLFormElement>('#formulaire-devis-simple');
  const confirmation = document.querySelector<HTMLElement>('#devis-simple-confirmation');
  const entete = modal?.querySelector<HTMLElement>('.modal-header');
  const referenceConfirmation = document.querySelector<HTMLElement>('#devis-confirmation-reference');

  const revenirAuFormulaire = () => {
    if (confirmation) confirmation.hidden = true;
    if (formulaire) formulaire.hidden = false;
    if (entete) entete.hidden = false;
  };
  modal?.addEventListener('close', revenirAuFormulaire);

  // Ouvrir la fenêtre depuis n'importe quelle page.
  document.addEventListener('click', (event) => {
    const cible = event.target;

    if (!(cible instanceof Element)) return;

    const bouton = cible.closest('[data-open-devis-simple]');

    if (bouton && modal) {
      event.preventDefault();

      if (!modal.open) {
        modal.showModal();
      }
    }

    if (cible.closest('[data-close-devis-simple]')) {
      modal?.close();
    }
  });

  // Fermer en cliquant sur le fond sombre.
  modal?.addEventListener('click', (event) => {
    if (event.target === modal) {
      modal.close();
    }
  });

  // Envoi asynchrone vers l'API commune aux deux types de devis.
  formulaire?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (notice) notice.hidden = true;
    if (!formulaire.reportValidity()) return;
    const prestations = Array.from(
      formulaire.querySelectorAll<HTMLInputElement>('input[name="prestations_selectionnees"]:checked'),
    );
    if (prestations.length === 0) {
      afficherErreur('Veuillez sélectionner au moins une prestation.');
      formulaire.querySelector<HTMLInputElement>('input[name="prestations_selectionnees"]')?.focus();
      return;
    }

    if (
      prestations.some((p) => p.value === 'Nettoyage de vitres') &&
      !prestations.some((p) => p.value === 'Menage a domicile')
    ) {
      afficherErreur(
        'Le nettoyage des vitres simples est proposé en complément du ménage. Sélectionnez aussi le ménage à domicile.',
      );
      return;
    }
    const bouton = formulaire.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!bouton || bouton.disabled) return;
    const texteInitial = bouton.innerHTML;
    bouton.disabled = true;
    bouton.textContent = 'Envoi en cours…';

    try {
      // Garder le champ `prestation` attendu par l'API existante,
      // en regroupant toutes les prestations sélectionnées dans sa valeur.
      const donnees = new FormData(formulaire);
      donnees.delete('prestations_selectionnees');
      donnees.set('prestation', prestations.map((input) => input.value).join(', '));
      const reponse = await fetch('/api/devis', {
        method: 'POST',
        body: donnees,
      });
      const resultat: { ok?: boolean; reference?: string; error?: string } = await reponse.json();
      if (!reponse.ok || !resultat.ok) {
        throw new Error(resultat.error || 'Impossible d’enregistrer votre demande.');
      }
      if (referenceConfirmation) referenceConfirmation.textContent = resultat.reference || '—';
      formulaire.reset();
      formulaire.hidden = true;
      if (entete) entete.hidden = true;
      if (confirmation) confirmation.hidden = false;
      modal?.scrollTo({ top: 0, behavior: 'instant' });
    } catch (erreur) {
      afficherErreur(erreur instanceof Error ? erreur.message : 'Erreur de connexion. Veuillez réessayer.');
    } finally {
      bouton.disabled = false;
      bouton.innerHTML = texteInitial;
    }
  });
</script>
