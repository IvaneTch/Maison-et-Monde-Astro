---
import InterventionAreas from '../../components/InterventionAreas.astro';
import '../../styles/service-de-menage-test.css';
import SectionBand from '../../components/SectionBand.astro';
import Layout from '../../layouts/Layout.astro';
const prestations = [
  'Nettoyage des sols et dépoussiérage des surfaces',
  'Entretien de la cuisine, de la salle de bain et des sanitaires',
  'Remise en ordre et entretien courant du logement',
  'Repassage à domicile selon vos besoins',
  'Priorités définies avec vous avant l’intervention',
];
const benefices = [
  [
    '01',
    'Découvrez notre qualité',
    'Évaluez le soin apporté à votre intérieur lors d’une première intervention.',
  ],
  [
    '02',
    'Rencontrez votre intervenante',
    'Faites connaissance avec la personne qui pourra ensuite intervenir régulièrement.',
  ],
  ['03', 'Définissez vos priorités', 'Expliquez vos attentes et les tâches les plus importantes pour vous.'],
  ['04', 'Décidez librement', 'Choisissez ensuite une formule régulière uniquement si vous le souhaitez.'],
];
---

<Layout
  title="Formule Test de ménage à domicile à Paris | Maison & Monde"
  description="Découvrez notre Formule Test de ménage à domicile à Paris et en Île-de-France : une intervention de 3 à 7 heures, sans engagement de renouvellement."
>
  <div class="page-menage page-test">
    <section class="introduction" aria-labelledby="titre-menage">
      <div class="hero-copy">
        <span class="sur-titre">MAISON &amp; MONDE</span>
        <h1 id="titre-menage">
          Formule Test
          <br />
          de ménage à domicile
        </h1>
        <p>
          Essayez la qualité de notre service avant de choisir une formule régulière. Une première
          intervention personnalisée, sans engagement de renouvellement, à Paris et en Île-de-France.
        </p>
        <div class="hero-atouts" aria-label="Nos engagements">
          <span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z" />
            </svg>{' '}
            Un intérieur
            <br />
            plus sain
          </span>
          <span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 4C10 4 4 9 4 16a4 4 0 0 0 4 4c7 0 12-6 12-16Z" />
              <path d="M4 21c3-7 7-10 12-13" />
            </svg>{' '}
            Plus de temps
            <br />
            pour vous
          </span>
          <span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
            </svg>{' '}
            Un service
            <br />
            de confiance
          </span>
        </div>
      </div>
      <div class="hero-visual">
        <img
          src="/images/femme-de-menage-domicile-paris.webp"
          alt="Intervenante Maison & Monde pour une première prestation de ménage à domicile"
          width="1600"
          height="800"
          fetchpriority="high"
          srcset="/images/femme-de-menage-domicile-paris-480.webp 480w, /images/femme-de-menage-domicile-paris-960.webp 960w, /images/femme-de-menage-domicile-paris.webp 1600w"
          sizes="(max-width: 780px) 100vw, 50vw"
        />
      </div>
    </section>

    <div class="vague-hero" aria-hidden="true"></div>
    <section class="section-formules" aria-labelledby="titre-test">
      <div class="section-titre">
        <span class="sur-titre">ESSAYEZ AVANT DE CHOISIR</span>
        <h2 id="titre-test">Découvrez notre Formule Test</h2>
        <p>
          Une première prestation de 3 à 7 heures consécutives, adaptée à votre logement et à vos besoins.
        </p>
      </div>
      <div class="test-layout">
        <div class="test-explication">
          <span class="sur-titre">UNE PREMIÈRE RENCONTRE EN TOUTE CONFIANCE</span>
          <h3>Testez notre savoir-faire, sans engagement régulier</h3>
          <p>
            Vous recherchez une aide ménagère mais souhaitez découvrir notre manière de travailler avant de
            vous engager ? La <strong>Formule Test Maison &amp; Monde</strong> vous permet de bénéficier d’une
            première intervention professionnelle, tout en évaluant la qualité de notre service.
          </p>
          <p>
            Nous adaptons cette prestation à vos priorités : entretien courant, cuisine, sanitaires, sols ou
            repassage. C’est aussi l’occasion de faire connaissance avec votre intervenante et de définir
            ensemble les tâches à réaliser lors d’éventuelles prochaines visites.
          </p>
          <h4>Prestations possibles pendant votre essai</h4>
          <ul class="liste-test">
            {prestations.map((item) => (
              <li>
                <span aria-hidden="true">✓</span>
                {item}
              </li>
            ))}
          </ul>
          <p class="note-test">
            La liste exacte des tâches dépend de la durée réservée et de l’état du logement. Il s’agit d’une
            prestation payante, sans obligation de souscrire ensuite une formule régulière.
          </p>
        </div>
        <aside class="prix-test" aria-label="Tarif de la Formule Test">
          <span class="badge-test">✦ Première intervention</span>
          <img
            src="/images/menage-ponctuel.webp"
            alt="Intervenante effectuant un entretien ménager"
            width="527"
            height="526"
            loading="lazy"
            srcset="/images/menage-ponctuel-480.webp 480w, /images/menage-ponctuel.webp 527w"
            sizes="(max-width: 780px) 100vw, 50vw"
          />
          <h3>Formule Test</h3>
          <p>3 à 7 heures consécutives selon vos besoins</p>
          <div class="tarif">
            <span class="tarif-label">Tarif horaire TTC</span>
            <strong class="tarif-devis">29,00 € / h</strong>
          </div>
          <div class="credit-impot">
            <span>Avec le crédit d’impôt de 50 %*</span>
            <strong class="credit-texte">
              14,50 €<small> / heure</small>
            </strong>
          </div>
          <a class="bouton-test mm-button" href="/devis-detaille/?service=test">
            Demander un devis <span aria-hidden="true">→</span>
          </a>
          <small>Devis gratuit • Sans engagement de renouvellement</small>
        </aside>
      </div>
      <p class="mention-fiscale">
        * Crédit d’impôt de 50 % selon les conditions d’éligibilité prévues par la réglementation en vigueur.
      </p>
    </section>
    <SectionBand theme="test" />

    <section class="etapes-test" aria-labelledby="titre-etapes">
      <div class="section-titre">
        <span class="sur-titre">SIMPLE, CLAIR ET PERSONNALISÉ</span>
        <h2 id="titre-etapes">Pourquoi essayer notre service ?</h2>
      </div>
      <div class="etapes-grille">
        {benefices.map(([numero, titre, desc]) => (
          <article>
            <span>{numero}</span>
            <h3>{titre}</h3>
            <p>{desc}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="avantages" aria-labelledby="titre-avantages">
      <h2 id="titre-avantages">
        <span>Pourquoi choisir Maison &amp; Monde ?</span>
      </h2>
      <div class="avantages-grille">
        <div>
          <span class="avantage-icone">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6 3h12l5 7-11 12L1 10l5-7Z" />
              <path d="M1 10h22M6 3l3 7 3 12 3-12 3-7" />
            </svg>
          </span>
          <p>
            <strong>Intervenantes expérimentées</strong>
            <small>Des professionnelles de confiance</small>
          </p>
        </div>
        <div>
          <span class="avantage-icone">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 2 20 5v6c0 5.4-3.4 9-8 11-4.6-2-8-5.6-8-11V5l8-3Z" />
              <path d="m8 12 2.7 2.7L16.5 9" />
            </svg>
          </span>
          <p>
            <strong>Service fiable et sécurisé</strong>
            <small>Un suivi personnalisé de vos prestations</small>
          </p>
        </div>
        <div>
          <span class="avantage-icone">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 4C10 4 4 9 4 16a4 4 0 0 0 4 4c7 0 12-6 12-16Z" />
              <path d="M4 21c3-7 7-10 12-13" />
            </svg>
          </span>
          <p>
            <strong>Produits de qualité et respectueux</strong>
            <small>Pour un intérieur sain et agréable</small>
          </p>
        </div>
        <div>
          <span class="avantage-icone">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="M12 6v6l4 2" />
            </svg>
          </span>
          <p>
            <strong>Horaires flexibles</strong>
            <small>Selon vos besoins et votre mode de vie</small>
          </p>
        </div>
      </div>
    </section>

    <section class="bandeau-devis" aria-labelledby="titre-devis">
      <div class="bandeau-photo">
        <img
          src="/images/grand-menage-salle-de-bain-paris.webp"
          alt="Salle de bain haut de gamme impeccablement nettoyée à Paris"
          loading="lazy"
          width="1600"
          height="895"
          srcset="/images/grand-menage-salle-de-bain-paris-480.webp 480w, /images/grand-menage-salle-de-bain-paris-960.webp 960w, /images/grand-menage-salle-de-bain-paris.webp 1600w"
          sizes="(max-width: 780px) 100vw, 50vw"
        />
      </div>
      <div class="bandeau-texte">
        <h2 id="titre-devis">
          Essayez notre service,
          <br />
          choisissez en confiance
        </h2>
        <p>
          Une première prestation personnalisée pour découvrir notre équipe, sans obligation de poursuivre.
        </p>
        <a class="mm-button" href="/devis-detaille/?service=test">
          Demander un devis <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="ornement-devis" aria-hidden="true"></div>
    </section>
  </div>
  <InterventionAreas />
</Layout>
