            ],
          },
          {
            eyebrow: 'AVANTAGE FISCAL',
            title: 'Profitez de <span>50 %</span><br>de crédit d’impôt.',
            description:
              'Certaines prestations de services à la personne peuvent ouvrir droit à un crédit d’impôt de 50 %, selon les conditions légales et votre éligibilité.',
            benefits: [
