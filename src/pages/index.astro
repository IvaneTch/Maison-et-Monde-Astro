              'Services à la personne',
              'Avance immédiate selon éligibilité',
            ],
          },
        ];
        let index = 0,
          timer;
        function show(i) {
          index = (i + slides.length) % slides.length;
          slides.forEach((el, j) => el.classList.toggle('is-active', j === index));
          dots.forEach((el, j) => {
            el.classList.toggle('is-active', j === index);
            if (j === index) el.setAttribute('aria-current', 'true');
            else el.removeAttribute('aria-current');
          });
          const d = data[index];
          hero.querySelector('#hero-eyebrow').textContent = d.eyebrow;
          hero.querySelector('#hero-title').innerHTML = d.title;
          hero.querySelector('#hero-description').textContent = d.description;
          hero.querySelector('#hero-benefits').innerHTML = d.benefits
            .map((t) => '<span>✓ ' + t + '</span>')
            .join('');
        }
        function start() {
          clearInterval(timer);
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches)
            timer = setInterval(() => show(index + 1), 6000);
        }
        hero.querySelector('.hero-arrow-prev').addEventListener('click', () => {
          show(index - 1);
          start();
        });
        hero.querySelector('.hero-arrow-next').addEventListener('click', () => {
          show(index + 1);
          start();
        });
        dots.forEach((el, i) =>
          el.addEventListener('click', () => {
            show(i);
            start();
          }),
        );
        hero.addEventListener('mouseenter', () => clearInterval(timer));
        hero.addEventListener('mouseleave', start);
        document.addEventListener('visibilitychange', () =>
          document.hidden ? clearInterval(timer) : start(),
        );
        start();
      })();
    </script>

    <!-- Maison & Monde : profondeur douce et apparition progressive (ordinateur uniquement) -->

    <script is:inline>
      (() => {
        const desktop = window.matchMedia('(min-width: 769px) and (prefers-reduced-motion: no-preference)');
        if (!desktop.matches || !('IntersectionObserver' in window)) return;
        const targets = document.querySelectorAll(
          [
            '.services-text',
            '.services-image',
            '.services-list .service-card',
            '.avantages-intro',
            '.avantages-grid .avantage-item',
            '.about-content',
            '.about-image',
            '.home-concierge-visual',
            '.home-concierge-copy',
            '.contact-copy',
            '.contact-photo',
            '.reviews-intro',
            '.reviews-slider-area',
          ].join(','),
        );
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('mm-depth-visible');
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px 30px 0px' },
        );
        targets.forEach((element) => {
          // Ne pas masquer les éléments déjà visibles au chargement.
          if (element.getBoundingClientRect().top < window.innerHeight) return;
          element.classList.add('mm-depth-reveal');
          observer.observe(element);
        });
        desktop.addEventListener(
          'change',
          () => {
            document.querySelectorAll('.mm-depth-reveal').forEach((el) => {
              el.classList.remove('mm-depth-reveal');
              el.classList.add('mm-depth-visible');
            });
            observer.disconnect();
          },
          { once: true },
        );
      })();
    </script>
