/* Nouvelle section Parlons de vos besoins */
.contact-section {
  padding: 0 !important;
  text-align: left;
  background: #f9f7f2;
  color: #102b46;
  overflow: hidden;
}
.contact-visual {
  min-height: 440px;
  position: relative;
  display: grid;
  grid-template-columns: 55% 45%;
  background: radial-gradient(circle at 0% 45%, #21618a 0%, #103b5e 35%, #071b30 90%);
  color: white;
  overflow: hidden;
  border-radius: 0 0 42% 0 / 0 0 8% 0;
}
.contact-copy {
  position: relative;
  z-index: 2;
  padding: 70px 5% 76px 12%;
  max-width: 790px;
}
.contact-kicker { display:block; color:#f4b65d; font-size:12px; font-weight:800; letter-spacing:.17em; margin-bottom:18px; }
.contact-copy h2 { font-family: Georgia,serif; font-size:clamp(32px,3.25vw,49px); line-height:1.12; font-weight:500; margin:0 0 22px; }
.contact-copy h2 em { font-style:normal; color:#ffc06c; }
.contact-copy p { font-size:15px; line-height:1.8; max-width:560px; color:#e7edf4; margin:0 0 28px; }
.contact-actions { display:flex; flex-wrap:wrap; align-items:center; gap:14px; }
.contact-cta,.contact-outline { display:inline-flex; align-items:center; justify-content:center; gap:18px; padding:15px 22px; border-radius:28px; font-size:13px; font-weight:750; text-decoration:none; transition:transform .2s ease; }
.contact-cta:hover,.contact-outline:hover { transform:translateY(-2px); }
.contact-cta { background:#eda648; color:#102b46; }
.contact-outline { border:1px solid rgba(255,255,255,.75); color:white; background:rgba(255,255,255,.05); }
.contact-photo { background: url('/images/femme-de-menage-professionnelle-paris-maison-et-monde.jpg') center 42% / cover no-repeat; min-height:440px; clip-path:ellipse(96% 85% at 95% 50%); }
.contact-swoosh { position:absolute; inset:0; width:100%; height:100%; z-index:3; pointer-events:none; fill:none; stroke:#e9a34c; stroke-width:1.5; opacity:.85; }
.contact-assurances { display:flex; justify-content:space-evenly; gap:20px; padding:28px 7%; background:#f9f7f2; }
.contact-assurances > div { display:flex; align-items:center; gap:13px; font-size:13px; font-weight:700; line-height:1.45; }
.contact-badge { flex-shrink:0; display:grid; place-items:center; width:51px; height:51px; border-radius:50%; background:#103b5e; color:white; border:2px solid #e9a34c; font-size:17px; font-weight:800; }
@media (max-width:900px) {
  .contact-visual { grid-template-columns:1fr; }
  .contact-copy { padding:55px 7% 48px; }
  .contact-photo { min-height:270px; clip-path:none; background-position:center 40%; }
  .contact-swoosh { opacity:.45; }
  .contact-assurances { flex-wrap:wrap; justify-content:center; }
}
@media (max-width:540px) {
  .contact-copy h2 { font-size:34px; }
  .contact-actions { flex-direction:column; align-items:stretch; }
  .contact-cta,.contact-outline { width:100%; }
  .contact-assurances { display:grid; grid-template-columns:1fr; padding:24px 8%; gap:16px; }
}



