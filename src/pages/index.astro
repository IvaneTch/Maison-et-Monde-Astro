/* Filigrane du logo Maison & Monde dans la bande Vos avantages */
.avantages-section::after {
  content: "";
  position: absolute;
  left: 1.2%;
  top: 40%;
  width: clamp(115px, 12vw, 195px);
  aspect-ratio: 1;
  transform: translateY(calc(-70% - 30px));
  background: url('/favicon.png') center / contain no-repeat;
  opacity: 0.11;
  filter: grayscale(1) brightness(0) invert(1);
  pointer-events: none;
  z-index: 1;
}
/* Logo Maison & Monde centré et adaptatif sur mobile */
@media (max-width: 680px) {
  .avantages-section::after {
    width: clamp(180px, 55vw, 260px);
    height: auto;
    aspect-ratio: 1;

    left: 50%;
    top: 50%;

    transform: translate(-50%, -50%);

    opacity: 0.09;
    pointer-events: none;
    z-index: 0;
  }

  .avantages-container {
    position: relative;
    z-index: 2;
  }
}


