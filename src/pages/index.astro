<!-- Maison & Monde : profondeur douce et apparition progressive (ordinateur uniquement) -->
<style is:global>
  /* Ombres permanentes, y compris sur mobile : aucune animation imposée. */
  .services-section .service-card,
  .avantages-section .avantage-item,
  .reviews-section .review-card,
  .reviews-section .reviews-intro,
  .home-concierge .home-concierge-visual {
    box-shadow: 0 12px 28px rgba(5, 33, 58, .11), 0 3px 9px rgba(5, 33, 58, .055);
  }
  .services-section .services-image,
  .about-section .about-image,
  .contact-section .contact-photo {
    filter: drop-shadow(0 16px 18px rgba(5, 33, 58, .14));
  }
  .contact-section .contact-visual {
    box-shadow: 0 18px 38px rgba(5, 33, 58, .12);
  }
  @media (min-width: 769px) and (prefers-reduced-motion: no-preference) {
    .services-section .service-card,
    .avantages-section .avantage-item,
    .reviews-section .review-card,
    .home-concierge .home-concierge-visual {
      transition: transform .42s cubic-bezier(.2,.7,.2,1), box-shadow .42s ease;
      will-change: auto;
    }
    .services-section .service-card:hover,
    .avantages-section .avantage-item:hover,
    .reviews-section .review-card:hover,
    .home-concierge .home-concierge-visual:hover {
      transform: translateY(-7px);
      box-shadow: 0 22px 42px rgba(5, 33, 58, .17), 0 6px 15px rgba(5, 33, 58, .08);
    }
    /* La classe n'est ajoutée qu'aux éléments sous le viewport. */
    .mm-depth-reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity .75s ease, transform .75s cubic-bezier(.2,.7,.2,1);
    }
    .mm-depth-reveal.mm-depth-visible { opacity: 1; transform: translateY(0); }
  }
</style>
<script is:inline>
(() => {
  const desktop = window.matchMedia('(min-width: 769px) and (prefers-reduced-motion: no-preference)');
  if (!desktop.matches || !('IntersectionObserver' in window)) return;
  const targets = document.querySelectorAll([
    '.services-text', '.services-image', '.services-list .service-card',
    '.avantages-intro', '.avantages-grid .avantage-item',
    '.about-content', '.about-image',
    '.home-concierge-visual', '.home-concierge-copy',
    '.contact-copy', '.contact-photo',
    '.reviews-intro', '.reviews-slider-area'
  ].join(','));
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      entry.target.classList.add('mm-depth-visible');
      observer.unobserve(entry.target);
    });
  }, { threshold: .08, rootMargin: '0px 0px 30px 0px' });
  targets.forEach((element) => {
    // Ne pas masquer les éléments déjà visibles au chargement.
    if (element.getBoundingClientRect().top < window.innerHeight) return;
    element.classList.add('mm-depth-reveal');
    observer.observe(element);
  });
  desktop.addEventListener('change', () => {
    document.querySelectorAll('.mm-depth-reveal').forEach((el) => {
      el.classList.remove('mm-depth-reveal');
      el.classList.add('mm-depth-visible');
    });
    observer.disconnect();
  }, { once: true });
})();
</script>




<script>
const track = document.getElementById('reviews-track');
const cards: HTMLElement[] = track
  ? Array.from(track.querySelectorAll<HTMLElement>('.review-card'))
  : [];
const dots = document.getElementById('reviews-dots');

let activeReview = 0;

let reviewTimer: number | undefined;

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function showReview(index: number) {
    if (!track || !cards.length) return;
    activeReview = (index + cards.length) % cards.length;
    const currentCard = cards[activeReview];
    const firstCard = cards[0];
    track.scrollTo({
      left: currentCard.offsetLeft - firstCard.offsetLeft,
      behavior: reduceMotion ? 'instant' : 'smooth'
    });
    dots?.querySelectorAll('button').forEach((dot, i) => dot.setAttribute('aria-current', String(i === activeReview)));
  }
  cards.forEach((_, i) => {
    const dot = document.createElement('button');
    dot.type = 'button';
    dot.setAttribute('aria-label', `Afficher l’avis ${i + 1}`);
    dot.addEventListener('click', () => { showReview(i); restartReviews(); });
    dots?.appendChild(dot);
  });
  document.getElementById('reviews-prev')?.addEventListener('click', () => { showReview(activeReview - 1); restartReviews(); });
  document.getElementById('reviews-next')?.addEventListener('click', () => { showReview(activeReview + 1); restartReviews(); });
  function stopReviews() { window.clearInterval(reviewTimer); }
  function startReviews() { if (!reduceMotion && cards.length > 1 && !document.hidden) reviewTimer = window.setInterval(() => showReview(activeReview + 1), 5000); }
  function restartReviews() { stopReviews(); startReviews(); }
  track?.addEventListener('mouseenter', stopReviews);
  track?.addEventListener('mouseleave', startReviews);
  track?.addEventListener('focusin', stopReviews);
  track?.addEventListener('focusout', startReviews);
  document.addEventListener('visibilitychange', restartReviews);
  if (cards.length) { showReview(0); startReviews(); }
</script>

