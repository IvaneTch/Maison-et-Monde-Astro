---
import SectionBand from '../../../components/SectionBand.astro';
import '../../../styles/conciergerie-suivi-maintenance.css';
import Layout from '../../../layouts/Layout.astro';

const controles = [
  {
    icon: 'check',
    title: 'Contrôle du logement',
    text: 'Observation de l’état général des pièces, du mobilier et des équipements lors de nos passages.',
  },
  {
    icon: 'alert',
    title: 'Signalement des anomalies',
    text: 'Information du propriétaire lorsqu’un dysfonctionnement, une dégradation ou un besoin d’entretien est constaté.',
  },
  {
    icon: 'tools',
    title: 'Coordination des interventions',
    text: 'Organisation, avec votre accord, de petites interventions ou de rendez-vous avec les prestataires concernés.',
  },
  {
    icon: 'report',
    title: 'Suivi personnalisé',
    text: 'Retour sur les vérifications effectuées et les actions à prévoir, selon les modalités convenues ensemble.',
  },
];
const etapes = [
  {
    n: '01',
    title: 'Vous nous confiez vos consignes',
    text: 'Nous définissons les points à surveiller et le niveau d’accompagnement souhaité.',
  },
  {
    n: '02',
    title: 'Nous vérifions le logement',
    text: 'Nos équipes observent les équipements et les espaces lors des passages prévus.',
  },
  {
    n: '03',
    title: 'Nous vous informons',
    text: 'Nous vous signalons les anomalies constatées et les actions éventuellement nécessaires.',
  },
  {
    n: '04',
    title: 'Nous organisons la suite',
    text: 'Si vous le souhaitez, nous coordonnons une intervention après votre validation.',
  },
];
const questions = [
  {
    q: 'Proposez-vous une surveillance permanente ?',
    a: 'Non. Les contrôles sont réalisés lors des passages convenus. Nous définissons ensemble la fréquence et le périmètre du suivi.',
  },
  {
    q: 'Effectuez-vous vous-mêmes toutes les réparations ?',
    a: 'Nous pouvons prendre en charge certaines petites tâches selon leur nature. Les travaux techniques nécessitant un professionnel qualifié sont confiés à un prestataire adapté, après votre accord.',
  },
  {
    q: 'Puis-je demander uniquement le suivi du logement ?',
    a: 'Oui. Le suivi et la maintenance peuvent être étudiés comme une prestation à la carte, sans obligation de choisir une gestion complète.',
  },
  {
    q: 'Comment est calculé le tarif ?',
    a: 'Le devis dépend du logement, de la fréquence des passages, des vérifications demandées et des éventuelles interventions à coordonner.',
  },
];
---

<Layout
  title="Suivi et maintenance de logement à Paris | Maison & Monde"
  description="Suivi et maintenance de logements en location courte durée à Paris : contrôles, signalement des anomalies et coordination d'interventions avec Maison & Monde."
>
  <div class="maintenance">
    <section class="hero" aria-labelledby="maintenance-title">
      <div class="hero-photo" aria-hidden="true"></div>
      <div class="wrap hero-content">
        <p class="eyebrow">CONCIERGERIE À PARIS ET EN ÎLE-DE-FRANCE</p>
        <h1 id="maintenance-title">
          Suivi et
          <br />
          <span>maintenance</span>
          <br />
          du logement
        </h1>
        <p class="hero-lead">
          Un logement suivi avec attention, des anomalies signalées et des interventions coordonnées selon vos
          besoins.
        </p>
        <div class="actions">
          <a class="button gold" href="/conciergerie/demande-de-devis/">
            Demander un devis personnalisé <span aria-hidden="true">→</span>
          </a>
          <a class="button outline" href="#prestations">
            Découvrir nos prestations
          </a>
        </div>
      </div>
      <svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 35 C290 115 610 5 880 42 S1250 90 1440 32 L1440 90 H0Z" fill="white" />
        <path
          d="M0 35 C290 115 610 5 880 42 S1250 90 1440 32"
          fill="none"
          stroke="#d7a35c"
          stroke-width="2"
        />
      </svg>
    </section>

    <section class="section intro decorated" id="prestations">
      <div class="circle left" aria-hidden="true"></div>
      <svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 320 C290 25 510 420 820 165 S1200 40 1500 270" />
      </svg>
      <div class="wrap intro-grid top-layer">
        <div class="intro-copy">
          <p class="eyebrow">UN LOGEMENT ENTRE DE BONNES MAINS</p>
          <h2>
            Chaque détail compte pour <em>votre tranquillité</em>
          </h2>
          <p>
            Entre deux séjours, un équipement peut présenter un défaut ou un élément du logement nécessiter
            une attention particulière. Nous vous aidons à garder une vision claire de son état et à anticiper
            les petites difficultés.
          </p>
          <p>
            Notre accompagnement est souple : nous adaptons les vérifications et le suivi aux caractéristiques
            de votre logement, à vos consignes et aux prestations retenues.
          </p>
          <div class="intro-points">
            <span>Contrôles convenus</span>
            <span>Informations claires</span>
            <span>Suivi sur mesure</span>
          </div>
        </div>
        <div class="organic-photo">
          <img
            src="/images/conciergerie/controle-equipements-logement.webp"
            alt="Professionnel vérifiant les équipements d'un logement"
            loading="lazy"
            sizes="(max-width: 780px) 100vw, 50vw"
            width="1600"
            height="1067"
          />
        </div>
      </div>
    </section>
    <SectionBand theme="suivi" />

    <section class="section services decorated" id="nos-services">
      <div class="circle right" aria-hidden="true"></div>
      <svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 130 C280 380 470 20 800 220 S1230 330 1500 95" />
      </svg>
      <div class="wrap top-layer">
        <p class="eyebrow">NOTRE ACCOMPAGNEMENT</p>
        <h2>
          Un suivi <em>à la carte</em>
        </h2>
        <p class="section-lead">
          Des prestations concrètes pour vous aider à entretenir votre logement et à préparer sereinement les
          prochains séjours.
        </p>
        <div class="service-grid">
          {controles.map((item) => (
            <article class="service-card">
              <div class="icon-ring" aria-hidden="true">
                {item.icon === 'check' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 3 4 7v5c0 5 3.5 8 8 9 4.5-1 8-4 8-9V7l-8-4Z" />
                    <path d="m8.5 12 2.5 2.5 4.5-5" />
                  </svg>
                )}
                {item.icon === 'alert' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 3 2 20h20L12 3Z" />
                    <path d="M12 9v5M12 17h.01" />
                  </svg>
                )}
                {item.icon === 'tools' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M14.5 6.5a5 5 0 0 0-6.4 6.4L3 18a2.1 2.1 0 0 0 3 3l5.1-5.1a5 5 0 0 0 6.4-6.4l-3 3-3-3 3-3Z" />
                  </svg>
                )}
                {item.icon === 'report' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="5" y="3" width="14" height="18" rx="2" />
                    <path d="M9 8h6M9 12h6M9 16h4" />
                  </svg>
                )}
              </div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section process decorated" id="etapes">
      <svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 300 C250 45 550 410 900 150 S1200 40 1500 245" />
      </svg>
      <div class="wrap top-layer">
        <p class="eyebrow">SIMPLE ET TRANSPARENT</p>
        <h2>
          Comment se déroule <em>le suivi ?</em>
        </h2>
        <div class="steps-grid">
          {etapes.map((step) => (
            <article class="step-card">
              <span class="step-number">{step.n}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section reassurance decorated">
      <div class="circle left" aria-hidden="true"></div>
      <div class="wrap reassurance-grid top-layer">
        <div class="organic-photo second">
          <img
            src="/images/conciergerie/inspection-logement.webp"
            alt="Salon parisien soigneusement entretenu"
            loading="lazy"
            sizes="(max-width: 780px) 100vw, 50vw"
            width="1600"
            height="1067"
          />
        </div>
        <div>
          <p class="eyebrow">VOTRE LOGEMENT, VOS PRIORITÉS</p>
          <h2>
            Vous gardez <em>la maîtrise</em>
          </h2>
          <p>
            Nous vous informons des besoins repérés et sollicitons votre accord avant toute intervention
            supplémentaire ou dépense non prévue.
          </p>
          <ul class="checks">
            <li>Prestations définies ensemble</li>
            <li>Interventions complémentaires sur validation</li>
            <li>Coordination adaptée à votre disponibilité</li>
            <li>Possibilité d'associer ménage et préparation du logement</li>
          </ul>
          <a class="text-link" href="/conciergerie/menage-preparation-logement/">
            Découvrir le ménage et la préparation <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section faq decorated" id="questions">
      <div class="wrap top-layer">
        <p class="eyebrow">QUESTIONS FRÉQUENTES</p>
        <h2>
          Tout savoir sur <em>notre suivi</em>
        </h2>
        <div class="faq-list">
          {questions.map((item) => (
            <details>
              <summary>
                {item.q}
                <span aria-hidden="true">+</span>
              </summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="closing">
      <svg class="closing-wave" viewBox="0 0 1440 75" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 25 C250 -30 500 75 750 30 S1190 20 1440 5 L1440 0 H0Z" fill="white" />
        <path
          d="M0 25 C250 -30 500 75 750 30 S1190 20 1440 5"
          stroke="#d7a35c"
          fill="none"
          stroke-width="2"
        />
      </svg>
      <div class="wrap closing-grid">
        <div>
          <p class="eyebrow">UN ACCOMPAGNEMENT SUR MESURE</p>
          <h2>
            Prenez soin de <em>votre logement</em>, en toute sérénité
          </h2>
          <p>
            Parlons de vos besoins et construisons ensemble une prestation adaptée à votre location courte
            durée.
          </p>
          <a class="button gold" href="/conciergerie/demande-de-devis/">
            Demander un devis personnalisé <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="closing-photo">
          <img
            src="/images/conciergerie/appartement-paris.webp"
            alt="Suivi des équipements d'un appartement"
            loading="lazy"
            sizes="(max-width: 780px) 100vw, 50vw"
            width="1600"
            height="1067"
          />
        </div>
      </div>
    </section>
  </div>
</Layout>
