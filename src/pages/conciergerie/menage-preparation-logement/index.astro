---
import SectionBand from '../../../components/SectionBand.astro';
import '../../../styles/conciergerie-menage-preparation-logement.css';
import Layout from '../../../layouts/Layout.astro';
const services = [
  {
    n: '01',
    title: 'Nettoyage complet',
    desc: 'Cuisine, salle de bain, sanitaires, sols et surfaces : chaque pièce est préparée pour les prochains voyageurs.',
  },
  {
    n: '02',
    title: 'Linge et literie',
    desc: 'Retrait du linge utilisé, installation de draps propres et présentation soignée des serviettes.',
  },
  {
    n: '03',
    title: 'Mise en place du logement',
    desc: 'Coussins, espaces de vie et équipements sont remis en ordre pour une arrivée accueillante.',
  },
  {
    n: '04',
    title: 'Contrôle avant arrivée',
    desc: 'Vérification visuelle du logement et signalement des anomalies constatées lors de notre passage.',
  },
];
const questions = [
  {
    q: 'Intervenez-vous entre deux réservations ?',
    a: 'Oui, nous pouvons organiser le ménage et la préparation du logement entre les départs et les arrivées, selon les créneaux disponibles.',
  },
  {
    q: 'Puis-je demander uniquement le ménage ?',
    a: 'Oui. Nos prestations peuvent être réservées à la carte, sans obligation de souscrire une gestion complète.',
  },
  {
    q: 'Fournissez-vous les draps et les serviettes ?',
    a: 'Nous pouvons organiser la mise en place du linge fourni par le propriétaire. Les besoins en blanchisserie ou en fourniture de linge sont étudiés sur devis.',
  },
  {
    q: 'Comment obtenir un tarif ?',
    a: 'Le devis dépend notamment de la surface, de la configuration du logement, de la fréquence des interventions et des prestations demandées.',
  },
];
---

<Layout
  title="Ménage et préparation du logement à Paris | Maison & Monde"
  description="Ménage et préparation de logements de location courte durée à Paris : nettoyage, linge, vérification et réassort. Maison & Monde, prestations sur devis."
>
  <div class="prep">
    <section class="hero">
      <div class="hero-photo" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <p class="eyebrow">CONCIERGERIE À PARIS ET EN ÎLE-DE-FRANCE</p>
        <h1>
          Ménage et
          <br />
          préparation
          <br />
          <span>du logement</span>
        </h1>
        <p>
          Un logement toujours impeccable entre deux voyageurs, pour des séjours réussis et des avis positifs.
        </p>
        <div class="actions">
          <a class="button gold" href="/conciergerie/demande-de-devis/">
            Demander un devis personnalisé <span>→</span>
          </a>
          <a class="button ghost" href="/conciergerie/">
            Nos autres services
          </a>
        </div>
      </div>
      <svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 35 C290 115 610 5 880 42 S1250 90 1440 32 L1440 90 H0Z" fill="white" />
        <path
          d="M0 35 C290 115 610 5 880 42 S1250 90 1440 32"
          fill="none"
          stroke="#d7a35c"
          stroke-width="2"
        />
      </svg>
    </section>

    <section class="section know-how decorated" id="savoir-faire">
      <div class="circle left" aria-hidden="true"></div>
      <div class="circle right" aria-hidden="true"></div>
      <svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 320 C290 25 510 420 820 165 S1200 40 1500 270" />
      </svg>
      <div class="wrap split top-layer">
        <div>
          <p class="eyebrow">NOTRE SAVOIR-FAIRE</p>
          <h2>
            Un logement prêt
            <br />à accueillir <em>vos voyageurs</em>
          </h2>
          <p>
            Nous assurons un ménage complet et minutieux entre chaque séjour afin de garantir un logement
            propre, soigné et parfaitement préparé. Vous gagnez du temps et offrez à vos voyageurs une
            expérience agréable dès leur arrivée.
          </p>
          <div class="benefits">
            <div>
              <span>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m12 2 2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5L12 2Z" />
                </svg>
              </span>
              Propreté
              <br />
              irréprochable
            </div>

            <div>
              <span>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3 2" />
                </svg>
              </span>
              Gestion de votre
              <br />
              temps
            </div>

            <div>
              <span>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
                </svg>
              </span>
              Meilleurs avis
              <br />
              voyageurs
            </div>

            <div>
              <span>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m3 11 9-8 9 8" />
                  <path d="M5 10v11h14V10" />
                  <path d="M9 21v-7h6v7" />
                </svg>
              </span>
              Sérénité au
              <br />
              quotidien
            </div>
          </div>
        </div>
        <div class="image-frame">
          <img
            src="/images/conciergerie/attention-details.webp"
            alt="Intervenante préparant soigneusement un appartement"
            loading="lazy"
            srcset="/images/conciergerie/attention-details-480.webp 480w, /images/conciergerie/attention-details-960.webp 960w, /images/conciergerie/attention-details.webp 1600w"
            sizes="(max-width: 780px) 100vw, 50vw"
            width="1600"
            height="900"
          />
        </div>
      </div>
    </section>
    <SectionBand theme="preparation" />

    <section class="section process decorated" id="etapes">
      <div class="circle right" aria-hidden="true"></div>
      <svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 130 C280 380 470 20 800 220 S1230 330 1500 95" />
      </svg>
      <div class="wrap top-layer">
        <p class="eyebrow">LES ÉTAPES DE NOTRE INTERVENTION</p>
        <h2>
          Un processus <em>simple et efficace</em>
        </h2>
        <div class="steps">
          <article>
            <div class="step-photo">
              <img
                src="/images/conciergerie/menage-preparation.webp"
                alt="Chambre propre préparée"
                loading="lazy"
                srcset="/images/conciergerie/menage-preparation-480.webp 480w, /images/conciergerie/menage-preparation-960.webp 960w, /images/conciergerie/menage-preparation.webp 1536w"
                sizes="(max-width: 780px) 100vw, 50vw"
                width="1536"
                height="1024"
              />
              <b>01</b>
            </div>
            <h3>Ménage complet</h3>
            <p>Nettoyage de toutes les pièces : sanitaires, cuisine, sols et surfaces.</p>
          </article>
          <article>
            <div class="step-photo">
              <img
                src="/images/conciergerie/services-complementaires.webp"
                alt="Linge propre et serviettes"
                loading="lazy"
                srcset="/images/conciergerie/services-complementaires-480.webp 480w, /images/conciergerie/services-complementaires-960.webp 960w, /images/conciergerie/services-complementaires.webp 1536w"
                sizes="(max-width: 780px) 100vw, 50vw"
                width="1536"
                height="1024"
              />
              <b>02</b>
            </div>
            <h3>Changement du linge</h3>
            <p>Installation des draps propres et préparation des serviettes.</p>
          </article>
          <article>
            <div class="step-photo">
              <img
                src="/images/conciergerie/salon-conciergerie.webp"
                alt="Salon prêt à accueillir les voyageurs"
                loading="lazy"
                srcset="/images/conciergerie/salon-conciergerie-480.webp 480w, /images/conciergerie/salon-conciergerie-960.webp 960w, /images/conciergerie/salon-conciergerie.webp 1600w"
                sizes="(max-width: 780px) 100vw, 50vw"
                width="1600"
                height="595"
              />
              <b>03</b>
            </div>
            <h3>Réassort et vérification</h3>
            <p>Produits d'accueil, consommables et contrôle des équipements.</p>
          </article>
          <article>
            <div class="step-photo">
              <img
                src="/images/conciergerie/suivi-maintenance.webp"
                alt="Vérification finale du logement"
                loading="lazy"
                srcset="/images/conciergerie/suivi-maintenance-480.webp 480w, /images/conciergerie/suivi-maintenance-960.webp 960w, /images/conciergerie/suivi-maintenance.webp 1536w"
                sizes="(max-width: 780px) 100vw, 50vw"
                width="1536"
                height="1024"
              />
              <b>04</b>
            </div>
            <h3>Contrôle final</h3>
            <p>Vérification de chaque détail et signalement si nécessaire.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section results decorated">
      <div class="circle left" aria-hidden="true"></div>
      <svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 300 C250 45 550 410 900 150 S1200 40 1500 245" />
      </svg>
      <div class="wrap top-layer">
        <p class="eyebrow">DES RÉSULTATS CONCRETS</p>
        <h2>
          Avant / Après <em>chaque séjour</em>
        </h2>
        <p class="subtext">
          Une remise en état attentive pour retrouver un logement accueillant après chaque départ.
        </p>
        <div class="comparison">
          <figure>
            <img
              src="/images/conciergerie/chambre-avant.webp"
              alt="Chambre avant la préparation, lit défait"
              loading="lazy"
              srcset="/images/conciergerie/chambre-avant-480.webp 480w, /images/conciergerie/chambre-avant-960.webp 960w, /images/conciergerie/chambre-avant.webp 1536w"
              sizes="(max-width: 780px) 100vw, 50vw"
              width="1536"
              height="1024"
            />
            <figcaption>Avant la préparation</figcaption>
          </figure>
          <div class="comparison-arrow" aria-hidden="true">
            →
          </div>
          <figure>
            <img
              src="/images/conciergerie/chambre-apres.webp"
              alt="Même chambre après la préparation, lit parfaitement fait"
              loading="lazy"
              srcset="/images/conciergerie/chambre-apres-480.webp 480w, /images/conciergerie/chambre-apres-960.webp 960w, /images/conciergerie/chambre-apres.webp 1536w"
              sizes="(max-width: 780px) 100vw, 50vw"
              width="1536"
              height="1024"
            />
            <figcaption>Après la préparation</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section linen decorated">
      <div class="circle right" aria-hidden="true"></div>
      <svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 85 C320 360 510 30 830 190 S1170 355 1500 120" />
      </svg>
      <div class="wrap split top-layer">
        <div class="image-frame">
          <img
            src="/images/conciergerie/services-complementaires.webp"
            alt="Serviettes et produits d'accueil"
            loading="lazy"
            srcset="/images/conciergerie/services-complementaires-480.webp 480w, /images/conciergerie/services-complementaires-960.webp 960w, /images/conciergerie/services-complementaires.webp 1536w"
            sizes="(max-width: 780px) 100vw, 50vw"
            width="1536"
            height="1024"
          />
        </div>
        <div>
          <p class="eyebrow">UN LOGEMENT TOUJOURS BIEN ÉQUIPÉ</p>
          <h2>
            Linge et <em>consommables</em>
          </h2>
          <p>
            Nous pouvons assurer la mise en place du linge et le réassort des produits essentiels, selon vos
            consignes et les équipements disponibles dans le logement.
          </p>
          <ul class="checks">
            <li>Draps et taies d'oreiller propres</li>
            <li>Serviettes de bain et tapis de sol</li>
            <li>Produits d'accueil (savon, shampoing…)</li>
            <li>Papier toilette, sacs-poubelle, liquide vaisselle</li>
            <li>Vérification des équipements et consommables</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section extras decorated" id="options">
      <div class="circle left" aria-hidden="true"></div>
      <svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 330 C330 50 530 390 830 170 S1210 35 1500 280" />
      </svg>
      <div class="wrap top-layer">
        <p class="eyebrow">DES SERVICES COMPLÉMENTAIRES</p>
        <h2>
          À la carte <em>selon vos besoins</em>
        </h2>
        <div class="extras-grid">
          <article>
            <img
              src="/images/conciergerie/reassort-courses.webp"
              alt="Appartement et produits de bienvenue"
              loading="lazy"
              srcset="/images/conciergerie/reassort-courses-480.webp 480w, /images/conciergerie/reassort-courses-960.webp 960w, /images/conciergerie/reassort-courses.webp 1536w"
              sizes="(max-width: 780px) 100vw, 50vw"
              width="1536"
              height="1024"
            />
            <div>
              <h3>Réassort de courses</h3>
              <p>Préparation des produits d'accueil et achats selon votre liste.</p>
              <a href="/conciergerie/services-a-la-carte/">En savoir plus →</a>
            </div>
          </article>
          <article>
            <img
              src="/images/conciergerie/lavage-repassage.webp"
              alt="Linge et blanchisserie"
              loading="lazy"
              srcset="/images/conciergerie/lavage-repassage-480.webp 480w, /images/conciergerie/lavage-repassage-960.webp 960w, /images/conciergerie/lavage-repassage.webp 1474w"
              sizes="(max-width: 780px) 100vw, 50vw"
              width="1474"
              height="1067"
            />
            <div>
              <h3>Lavage et repassage</h3>
              <p>Entretien du linge de maison et de vos textiles.</p>
              <a href="/conciergerie/services-a-la-carte/">En savoir plus →</a>
            </div>
          </article>
          <article>
            <img
              src="/images/conciergerie/prestations-specifiques.webp"
              alt="Entretien soigné du logement"
              loading="lazy"
              srcset="/images/conciergerie/prestations-specifiques-480.webp 480w, /images/conciergerie/prestations-specifiques-960.webp 960w, /images/conciergerie/prestations-specifiques.webp 1475w"
              sizes="(max-width: 780px) 100vw, 50vw"
              width="1475"
              height="1067"
            />
            <div>
              <h3>Prestations spécifiques</h3>
              <p>Nettoyage complémentaire et demandes particulières sur devis.</p>
              <a href="/conciergerie/services-a-la-carte/">En savoir plus →</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="closing">
      <svg class="closing-wave" viewBox="0 0 1440 75" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 25 C250 -30 500 75 750 30 S1190 20 1440 5 L1440 0 H0Z" fill="white" />
        <path
          d="M0 25 C250 -30 500 75 750 30 S1190 20 1440 5"
          stroke="#d7a35c"
          fill="none"
          stroke-width="2"
        />
      </svg>
      <div class="wrap closing-grid">
        <div>
          <p class="eyebrow">UN LOGEMENT PRÊT POUR CHAQUE ARRIVÉE</p>
          <h2>
            Confiez-nous la préparation
            <br />
            de <em>votre logement</em>
          </h2>
          <p>
            Demandez un devis personnalisé et profitez d'un service professionnel pour vos locations courte
            durée.
          </p>
          <a class="button gold" href="/conciergerie/demande-de-devis/">
            Demander un devis personnalisé <span>→</span>
          </a>
        </div>
        <div class="closing-photo">
          <img
            src="/images/conciergerie/salon-conciergerie.webp"
            alt="Appartement parisien prêt à accueillir les voyageurs"
            loading="lazy"
            srcset="/images/conciergerie/salon-conciergerie-480.webp 480w, /images/conciergerie/salon-conciergerie-960.webp 960w, /images/conciergerie/salon-conciergerie.webp 1600w"
            sizes="(max-width: 780px) 100vw, 50vw"
            width="1600"
            height="595"
          />
        </div>
      </div>
    </section>
  </div>
</Layout>

<script is:inline>
  (() => {
    const root = document.querySelector('main.prep');
    if (
      !root ||
      !window.matchMedia('(min-width:901px) and (prefers-reduced-motion:no-preference)').matches ||
      !('IntersectionObserver' in window)
    )
      return;
    const selectors = [
      '.know-how .split > div',
      '.process .steps article',
      '.results .comparison figure',
      '.linen .split > div',
      '.extras .extras-grid article',
      '.closing-grid > div',
    ];
    const nodes = [...new Set(selectors.flatMap((sel) => [...root.querySelectorAll(sel)]))];
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('mm-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.08, rootMargin: '0px 0px -25px 0px' },
    );
    nodes.forEach((node, i) => {
      node.classList.add('mm-reveal');
      node.style.setProperty('--mm-delay', `${(i % 4) * 85}ms`);
    });
    root.classList.add('mm-reveal-ready');
    nodes.forEach((node) => observer.observe(node));
  })();
</script>
