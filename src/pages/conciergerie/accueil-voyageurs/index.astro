---
import SectionBand from '../../../components/SectionBand.astro';
import '../../../styles/conciergerie-accueil-voyageurs.css';
import Layout from '../../../layouts/Layout.astro';

const modes = [
  {
    tag: 'UNE PRÉSENCE SUR PLACE',
    title: 'Accueil physique',
    icon: 'person',
    image: '/images/conciergerie/accueil-voyageurs.webp',
    alt: 'Appartement prêt à accueillir ses voyageurs',
    text: 'Un accueil chaleureux et personnalisé, directement dans votre logement, pour mettre vos voyageurs à l’aise dès leur arrivée.',
    points: [
      'Remise des clés en main propre',
      'Présentation du logement et des équipements',
      'Explication des consignes essentielles',
      'Organisation du départ selon vos besoins',
    ],
  },
  {
    tag: 'LIBERTÉ ET FLEXIBILITÉ',
    title: 'Accueil autonome',
    icon: 'key',
    image: '/images/conciergerie/menage-preparation.webp',
    alt: 'Logement accueillant pour une arrivée autonome',
    text: 'Une arrivée simple et flexible grâce à des instructions claires et une organisation adaptée aux équipements de votre logement.',
    points: [
      'Préparation des instructions d’accès',
      'Transmission des informations pratiques',
      'Coordination de la remise ou du dépôt des clés',
      'Assistance à distance selon les modalités convenues',
    ],
  },
];
const steps = [
  {
    n: '01',
    title: 'Échange avec vous',
    text: 'Nous définissons le mode d’accueil, les horaires et les particularités de votre logement.',
  },
  {
    n: '02',
    title: 'Préparation',
    text: 'Nous rassemblons les informations utiles et organisons l’accès avant l’arrivée.',
  },
  {
    n: '03',
    title: 'Arrivée des voyageurs',
    text: 'Accueil sur place ou transmission des consignes pour une entrée autonome.',
  },
  {
    n: '04',
    title: 'Départ organisé',
    text: 'Nous convenons avec vous des modalités de sortie et de gestion des clés.',
  },
];
const benefits = [
  {
    title: 'Accueil sur mesure',
    text: 'Une organisation adaptée à votre logement et à vos préférences.',
    path: '<path d="M12 3 3 8l9 5 9-5-9-5Z"/><path d="m3 12 9 5 9-5M3 16l9 5 9-5"/>',
  },
  {
    title: 'Voyageurs rassurés',
    text: 'Des indications précises pour faciliter leur installation.',
    path: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/>',
  },
  {
    title: 'Temps gagné',
    text: 'Nous prenons en charge les étapes convenues avec vous.',
    path: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  },
  {
    title: 'Suivi attentif',
    text: 'Une communication claire et un service professionnel.',
    path: '<path d="M4 5h16v12H8l-4 3V5Z"/><path d="M8 10h8M8 13h5"/>',
  },
];
---

<Layout
  title="Accueil des voyageurs à Paris | Conciergerie Maison & Monde"
  description="Accueil physique ou autonome des voyageurs à Paris et en Île-de-France. Remise des clés, instructions d'arrivée et coordination des départs avec Maison & Monde."
>
  <div class="welcome">
    <section class="hero">
      <div class="hero-photo" aria-hidden="true"></div>
      <div class="wrap hero-content">
        <p class="eyebrow">CONCIERGERIE À PARIS ET EN ÎLE-DE-FRANCE</p>
        <h1>
          Accueil des
          <br />
          <span>voyageurs</span>
        </h1>
        <p class="hero-lead">
          Accueil en personne ou arrivée autonome : nous adaptons notre service à votre logement, à vos
          voyageurs et à vos préférences.
        </p>
        <div class="hero-actions">
          <a class="btn primary mm-button" href="/conciergerie/demande-de-devis/">
            Demander un devis personnalisé <span aria-hidden="true">→</span>
          </a>
          <a class="btn outline mm-button mm-button--navy" href="#nos-solutions">
            Découvrir nos solutions
          </a>
        </div>
      </div>
      <svg class="hero-wave" viewBox="0 0 1440 95" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 37 C320 120 610 0 900 42 S1250 85 1440 32 L1440 95 H0Z" fill="#fff" />
        <path
          d="M0 37 C320 120 610 0 900 42 S1250 85 1440 32"
          fill="none"
          stroke="#d7a35c"
          stroke-width="2"
        />
      </svg>
    </section>

    <section class="section intro decorated" id="nos-solutions">
      <div class="orb left" aria-hidden="true"></div>
      <svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 310 C260 35 530 400 850 160 S1210 30 1500 250" />
      </svg>
      <div class="wrap layer">
        <p class="eyebrow">DEUX FAÇONS D'ACCUEILLIR</p>
        <h2>
          Votre logement, <em>votre façon d'accueillir</em>
        </h2>
        <p class="section-lead">
          Certains voyageurs apprécient une rencontre sur place, d'autres préfèrent arriver à leur rythme.
          Nous proposons les deux, selon les conditions définies ensemble.
        </p>
        <div class="mode-grid">
          {modes.map((mode) => (
            <article class="mode-card">
              <div class="mode-image">
                <img src={mode.image} alt={mode.alt} loading="lazy" />
                <span class="mode-badge">{mode.tag}</span>
              </div>
              <div class="mode-body">
                <h3>{mode.title}</h3>
                <p>{mode.text}</p>
                <ul>
                  {mode.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
                <a href="/conciergerie/demande-de-devis/" class="text-link">
                  Demander un devis <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    <SectionBand theme="voyageurs" />

    <section class="section process decorated" id="etapes">
      <div class="orb right" aria-hidden="true"></div>
      <svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 100 C280 380 520 25 820 220 S1230 350 1500 95" />
      </svg>
      <div class="wrap layer">
        <p class="eyebrow">UN SERVICE BIEN ORGANISÉ</p>
        <h2>
          Comment se déroule <em>l'accueil ?</em>
        </h2>
        <div class="steps">
          {steps.map((step) => (
            <article class="step">
              <span class="step-number">{step.n}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section advantages decorated">
      <div class="orb left" aria-hidden="true"></div>
      <svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 300 C280 40 540 410 870 160 S1200 45 1500 265" />
      </svg>
      <div class="wrap layer">
        <div class="advantages-heading">
          <p class="eyebrow">L'ESPRIT MAISON & MONDE</p>
          <h2>
            Une arrivée sereine, <em>pour tout le monde</em>
          </h2>
          <p>
            Nous veillons aux détails qui font la différence, tout en respectant votre organisation et vos
            consignes.
          </p>
        </div>
        <div class="benefits">
          {benefits.map((item) => (
            <article class="benefit">
              <span class="icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={item.path}
                />
              </span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section complementary decorated">
      <div class="wrap layer split">
        <div class="complementary-photo">
          <img
            src="/images/conciergerie/attention-details.webp"
            alt="Préparation attentive d'un appartement avant l'arrivée des voyageurs"
            loading="lazy"
            srcset="/images/conciergerie/attention-details-480.webp 480w, /images/conciergerie/attention-details-960.webp 960w, /images/conciergerie/attention-details.webp 1600w"
            sizes="(max-width: 780px) 100vw, 50vw"
            width="1600"
            height="900"
          />
        </div>
        <div>
          <p class="eyebrow">UN ACCUEIL QUI COMMENCE AVANT L'ARRIVÉE</p>
          <h2>
            Et si nous préparions aussi <em>votre logement ?</em>
          </h2>
          <p>
            Pour offrir une expérience cohérente à vos voyageurs, vous pouvez associer l'accueil à notre
            service de ménage et de préparation du logement entre deux séjours.
          </p>
          <a class="btn dark mm-button mm-button--navy" href="/conciergerie/menage-preparation-logement/">
            Découvrir la préparation du logement <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="closing">
      <svg class="closing-wave" viewBox="0 0 1440 75" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 25 C250 -30 500 75 750 30 S1190 20 1440 5 L1440 0 H0Z" fill="white" />
        <path
          d="M0 25 C250 -30 500 75 750 30 S1190 20 1440 5"
          stroke="#d7a35c"
          fill="none"
          stroke-width="2"
        />
      </svg>
      <div class="wrap closing-grid">
        <div>
          <p class="eyebrow">UN SERVICE ADAPTÉ À VOS BESOINS</p>
          <h2>
            Offrez un bel accueil à <em>vos voyageurs</em>
          </h2>
          <p>
            Accueil physique, arrivée autonome ou solution mixte : parlons de votre logement et construisons
            une prestation sur mesure.
          </p>
          <a class="btn primary mm-button" href="/conciergerie/demande-de-devis/">
            Demander un devis personnalisé <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="closing-photo">
          <img
            src="/images/conciergerie/salon-conciergerie.webp"
            alt="Salon confortable prêt pour les voyageurs"
            loading="lazy"
            srcset="/images/conciergerie/salon-conciergerie-480.webp 480w, /images/conciergerie/salon-conciergerie-960.webp 960w, /images/conciergerie/salon-conciergerie.webp 1600w"
            sizes="(max-width: 780px) 100vw, 50vw"
            width="1600"
            height="595"
          />
        </div>
      </div>
    </section>
  </div>
</Layout>

<script is:inline>
  (() => {
    const root = document.querySelector('main.welcome');
    if (
      !root ||
      !window.matchMedia('(min-width:901px) and (prefers-reduced-motion:no-preference)').matches ||
      !('IntersectionObserver' in window)
    )
      return;
    const selectors = [
      '.intro .mode-card',
      '.process .step',
      '.advantages .benefit',
      '.complementary .split > div',
      '.closing-grid > div',
    ];
    const nodes = [...new Set(selectors.flatMap((s) => [...root.querySelectorAll(s)]))];
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('mm-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.08, rootMargin: '0px 0px -25px 0px' },
    );
    nodes.forEach((node, i) => {
      node.classList.add('mm-reveal');
      node.style.setProperty('--mm-delay', `${(i % 4) * 85}ms`);
    });
    root.classList.add('mm-reveal-ready');
    nodes.forEach((node) => observer.observe(node));
  })();
</script>
