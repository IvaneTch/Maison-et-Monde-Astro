---
import SectionBand from '../../../components/SectionBand.astro';
import '../../../styles/conciergerie-services-a-la-carte.css';
import Layout from '../../../layouts/Layout.astro';
const services = [
  {
    img: 'reassort-courses.webp',
    quoteService: 'Courses et réassort',
    title: 'Réassort de courses',
    desc: 'Courses et produits de bienvenue selon votre liste : café, thé, boissons, produits d’hygiène et consommables essentiels.',
  },
  {
    img: 'lavage-repassage.webp',
    quoteService: 'Blanchisserie et linge',
    title: 'Lavage et repassage',
    desc: 'Entretien du linge de maison, lavage et repassage selon les besoins du logement et les modalités convenues.',
  },
  {
    img: 'prestations-specifiques.webp',
    quoteService: 'Services complémentaires',
    title: 'Prestations spécifiques',
    desc: 'Nettoyage complémentaire, préparation particulière ou demande ponctuelle : une solution étudiée avec vous.',
  },
];
const faq = [
  {
    q: 'Puis-je choisir une seule prestation ?',
    a: 'Oui, les services sont proposés à la carte, sous réserve de disponibilité et selon les modalités définies ensemble.',
  },
  {
    q: 'Les achats sont-ils compris dans le tarif ?',
    a: 'Les produits achetés et consommables ne sont pas inclus automatiquement dans le prix de l’intervention. Leur coût et les éventuels frais de courses sont précisés dans le devis.',
  },
  {
    q: 'Proposez-vous un service régulier ?',
    a: 'Oui, nous pouvons prévoir des interventions ponctuelles ou récurrentes en fonction de votre calendrier de réservations.',
  },
  {
    q: 'Comment obtenir un devis ?',
    a: 'Nous établissons un devis selon les services demandés, le logement et la fréquence. Consultez aussi notre page Tarifs et formules pour connaître nos prix de départ.',
  },
];
---

<Layout
  title="Services complémentaires de conciergerie à Paris | Maison & Monde"
  description="Services complémentaires de conciergerie à Paris : réassort de courses, lavage, repassage et prestations spécifiques pour locations courte durée. Maison & Monde."
>
  <div class="ala">
    <section class="hero">
      <div class="hero-photo" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <p class="eyebrow">CONCIERGERIE À PARIS ET EN ÎLE-DE-FRANCE</p>
        <h1>
          Services
          <br />
          <span>complémentaires</span>
        </h1>
        <p>
          Réassort, entretien du linge et attentions particulières : choisissez les prestations qui
          simplifient vos locations de courte durée.
        </p>
        <div class="actions">
          <a class="button gold" href="#contact-conciergerie">
            Demander un devis personnalisé <span>→</span>
          </a>
          <a class="button ghost" href="#prestations">
            Découvrir nos services
          </a>
        </div>
      </div>
      <svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 35 C290 115 610 5 880 42 S1250 90 1440 32 L1440 90 H0Z" fill="white" />
        <path
          d="M0 35 C290 115 610 5 880 42 S1250 90 1440 32"
          fill="none"
          stroke="#d7a35c"
          stroke-width="2"
        />
      </svg>
    </section>
    <section class="section know-how decorated">
      <div class="circle left" aria-hidden="true"></div>
      <svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 320 C290 25 510 420 820 165 S1200 40 1500 270" />
      </svg>
      <div class="wrap split top-layer">
        <div>
          <p class="eyebrow">UN SERVICE À VOTRE IMAGE</p>
          <h2>
            Les petits détails font <em>la différence</em>
          </h2>
          <p>
            Un séjour réussi repose aussi sur les attentions qui attendent les voyageurs. Nous vous aidons à
            préparer votre logement selon vos consignes, sans vous imposer une formule unique.
          </p>
          <ul class="checks">
            <li>Prestations à la carte</li>
            <li>Organisation adaptée à vos réservations</li>
            <li>Consignes personnalisées</li>
            <li>Prix de départ consultables dans nos tarifs et formules ; montant exact sur devis</li>
          </ul>
        </div>
        <div class="image-frame">
          <img
            src="/images/conciergerie/services-complementaires.webp"
            alt="Linge et produits de bienvenue préparés pour un séjour"
            loading="lazy"
            srcset="/images/conciergerie/services-complementaires-480.webp 480w, /images/conciergerie/services-complementaires-960.webp 960w, /images/conciergerie/services-complementaires.webp 1536w"
            sizes="(max-width: 780px) 100vw, 50vw"
            width="1536"
            height="1024"
          />
        </div>
      </div>
    </section>
    <SectionBand theme="carte" className="avantages-section" />

    <section class="section extras decorated" id="prestations">
      <div class="circle right" aria-hidden="true"></div>
      <svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 130 C280 380 470 20 800 220 S1230 330 1500 95" />
      </svg>
      <div class="wrap top-layer">
        <p class="eyebrow">NOS SERVICES COMPLÉMENTAIRES</p>
        <h2>
          Choisissez <em>ce dont vous avez besoin</em>
        </h2>
        <p class="subtext">
          Trois familles de services complémentaires, à réserver seules ou en complément de nos forfaits par
          séjour.
        </p>
        <div class="extras-grid">
          {services.map((s) => (
            <article>
              <img src={`/images/conciergerie/${s.img}`} alt={s.title} loading="lazy" />
              <div>
                <h3>{s.title}</h3>
                <p>{s.desc}</p>
                <a href={`/conciergerie/demande-de-devis/?service=${encodeURIComponent(s.quoteService)}`}>
                  Demander un devis →
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="section process decorated">
      <div class="circle left" aria-hidden="true"></div>
      <svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 300 C250 45 550 410 900 150 S1200 40 1500 245" />
      </svg>
      <div class="wrap top-layer">
        <p class="eyebrow">SIMPLE ET PERSONNALISÉ</p>
        <h2>
          Comment ça <em>fonctionne ?</em>
        </h2>
        <div class="steps">
          <article>
            <div class="step-number">01</div>
            <h3>Vous choisissez</h3>
            <p>Indiquez les prestations qui vous intéressent.</p>
          </article>
          <article>
            <div class="step-number">02</div>
            <h3>Nous échangeons</h3>
            <p>Nous précisons les consignes, les besoins et les disponibilités.</p>
          </article>
          <article>
            <div class="step-number">03</div>
            <h3>Nous préparons</h3>
            <p>Nous organisons les services convenus pour votre logement.</p>
          </article>
          <article>
            <div class="step-number">04</div>
            <h3>Vous restez informé</h3>
            <p>Nous vous signalons les points utiles selon les modalités définies.</p>
          </article>
        </div>
      </div>
    </section>
    <section class="section linen decorated">
      <div class="circle right" aria-hidden="true"></div>
      <svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 85 C320 360 510 30 830 190 S1170 355 1500 120" />
      </svg>
      <div class="wrap split top-layer">
        <div class="image-frame">
          <img
            src="/images/conciergerie/reassort-courses.webp"
            alt="Panier de produits de bienvenue dans un appartement"
            loading="lazy"
            srcset="/images/conciergerie/reassort-courses-480.webp 480w, /images/conciergerie/reassort-courses-960.webp 960w, /images/conciergerie/reassort-courses.webp 1536w"
            sizes="(max-width: 780px) 100vw, 50vw"
            width="1536"
            height="1024"
          />
        </div>
        <div>
          <p class="eyebrow">DES ATTENTIONS POUR VOS VOYAGEURS</p>
          <h2>
            Un accueil <em>soigné jusque dans les détails</em>
          </h2>
          <p>
            Du café à l'arrivée au linge fraîchement préparé, nous adaptons nos interventions à votre logement
            et aux attentes de vos voyageurs.
          </p>
          <ul class="checks">
            <li>Liste de courses définie ensemble</li>
            <li>Préparation des produits d’accueil</li>
            <li>Gestion du linge selon vos besoins</li>
            <li>Demandes particulières étudiées sur devis</li>
          </ul>
        </div>
      </div>
    </section>
    <section class="section faq decorated">
      <div class="wrap top-layer">
        <p class="eyebrow">QUESTIONS FRÉQUENTES</p>
        <h2>
          Tout savoir sur <em>nos services à la carte</em>
        </h2>
        <div class="faq-list">
          {faq.map((item) => (
            <details>
              <summary>
                {item.q}
                <span aria-hidden="true">+</span>
              </summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
    <section class="closing" id="contact-conciergerie">
      <svg class="closing-wave" viewBox="0 0 1440 75" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 25 C250 -30 500 75 750 30 S1190 20 1440 5 L1440 0 H0Z" fill="white" />
        <path
          d="M0 25 C250 -30 500 75 750 30 S1190 20 1440 5"
          stroke="#d7a35c"
          fill="none"
          stroke-width="2"
        />
      </svg>
      <div class="wrap closing-grid">
        <div>
          <p class="eyebrow">UN ACCOMPAGNEMENT SUR MESURE</p>
          <h2>
            Des services adaptés <em>à votre logement</em>
          </h2>
          <p>
            Choisissez des interventions ponctuelles ou régulières, seules ou en complément des formules
            Essentielle, Confort et Premium. Les prix de départ sont indiqués sur notre page Tarifs et
            formules ; votre devis confirme le montant exact.
          </p>
          <a class="button gold" href="/conciergerie/tarifs-formules/">
            Voir nos tarifs et formules <span>→</span>
          </a>
        </div>
        <div class="closing-photo">
          <img
            src="/images/conciergerie/salon-conciergerie.webp"
            alt="Salon parisien prêt pour les voyageurs"
            loading="lazy"
            srcset="/images/conciergerie/salon-conciergerie-480.webp 480w, /images/conciergerie/salon-conciergerie-960.webp 960w, /images/conciergerie/salon-conciergerie.webp 1600w"
            sizes="(max-width: 780px) 100vw, 50vw"
            width="1600"
            height="595"
          />
        </div>
      </div>
    </section>
  </div>
</Layout>
