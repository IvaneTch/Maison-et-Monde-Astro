---
import SectionBand from '../../../components/SectionBand.astro';
import '../../../styles/conciergerie-tarifs-formules.css';
import Layout from '../../../layouts/Layout.astro';

const formules = [
  {
    nom: 'Essentielle',
    sousTitre: 'Préparation entre deux séjours',
    prix: '80 €',
    vedette: false,
    prestations: [
      'Ménage complet du logement',
      'Mise en place des draps et serviettes fournis',
      'Contrôle visuel de qualité',
      'Logement prêt à accueillir les voyageurs',
    ],
  },
  {
    nom: 'Confort',
    sousTitre: 'Accueil et préparation',
    prix: '95 €',
    vedette: true,
    prestations: [
      'Tout ce qui est prévu dans Essentielle',
      'Remise des clés organisée',
      'Informations pratiques aux voyageurs',
      'Coordination de l’arrivée',
    ],
  },
  {
    nom: 'Premium',
    sousTitre: 'Préparation et suivi renforcé',
    prix: '120 €',
    vedette: false,
    prestations: [
      'Tout ce qui est prévu dans Confort',
      'Vérification renforcée du logement',
      'Réassort avec produits fournis',
      'Compte rendu après intervention',
    ],
  },
];
const prixServices = [
  { nom: 'Ménage entre deux séjours · studio / T1', prix: '55 €', unite: 'par intervention' },
  { nom: 'Ménage entre deux séjours · T2 / T3', prix: '80 €', unite: 'par intervention' },
  { nom: 'Accueil des voyageurs / remise des clés', prix: '35 €', unite: 'par arrivée' },
  { nom: 'Gestion du linge', prix: '20 €', unite: 'par séjour' },
];
const facteurs = [
  {
    n: '01',
    titre: 'Votre logement',
    texte: 'Surface, nombre de pièces, équipements et particularités du bien.',
  },
  {
    n: '02',
    titre: 'Les prestations',
    texte: 'Ménage, accueil, linge, suivi et services complémentaires souhaités.',
  },
  {
    n: '03',
    titre: 'La fréquence',
    texte: 'Nombre de rotations, régularité des interventions et délais de préparation.',
  },
  {
    n: '04',
    titre: 'Vos consignes',
    texte: 'Organisation des accès, fournitures, contraintes et demandes spécifiques.',
  },
];
const questions = [
  {
    q: 'Les prix affichés sont-ils définitifs ?',
    a: 'Non. Les montants indiqués sont des prix de départ TTC. Le tarif définitif est précisé dans un devis selon la surface, la fréquence, les accès et les services retenus.',
  },
  {
    q: 'Puis-je réserver uniquement un ménage entre deux séjours ?',
    a: 'Oui. Vous pouvez demander une prestation ponctuelle ou régulière sans souscrire à une gestion complète, sous réserve de disponibilité.',
  },
  {
    q: 'Le linge et les consommables sont-ils inclus ?',
    a: 'Leur prise en charge est précisée dans votre devis. Les achats, fournitures et prestations supplémentaires peuvent faire l’objet d’une facturation distincte.',
  },
  {
    q: 'Puis-je faire évoluer ma formule ?',
    a: 'Oui. Nous pouvons réévaluer les prestations en fonction de l’évolution de vos besoins, sous réserve des disponibilités et des conditions convenues.',
  },
];
---

<Layout
  title="Tarifs et formules de conciergerie à Paris | Maison & Monde"
  description="Découvrez nos formules de conciergerie à Paris et en Île-de-France : gestion complète ou prestations à la carte, avec prix de départ indicatifs et devis personnalisé."
>
  <div class="tf">
    <section class="tf-hero">
      <div class="tf-hero-image" aria-hidden="true"></div>
      <div class="tf-container tf-hero-content">
        <p class="tf-eyebrow">MAISON & MONDE · CONCIERGERIE</p>
        <h1>
          Des formules adaptées
          <br />à <em>votre logement.</em>
        </h1>
        <p>
          Gestion complète ou prestations à la carte : choisissez un accompagnement souple, pensé pour votre
          location de courte durée à Paris et en Île-de-France.
        </p>
        <div class="tf-actions">
          <a class="tf-btn tf-btn-gold" href="#nos-formules">
            Découvrir nos formules <span aria-hidden="true">→</span>
          </a>
          <a class="tf-btn tf-btn-outline" href="#demander-devis">
            Obtenir un devis
          </a>
        </div>
      </div>
      <svg class="tf-wave" viewBox="0 0 1440 85" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 33 C280 105 540 5 850 42 S1190 85 1440 25 L1440 85 H0Z" fill="#f8fbfd" />
        <path
          d="M0 33 C280 105 540 5 850 42 S1190 85 1440 25"
          stroke="#d8aa69"
          stroke-width="2"
          fill="none"
        />
      </svg>
    </section>

    <section class="tf-section tf-formules tf-decorated" id="nos-formules">
      <svg class="tf-gold-ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 310 C260 40 540 410 840 155 S1210 45 1500 265" />
      </svg>
      <div class="tf-orb tf-orb-left" aria-hidden="true"></div>
      <div class="tf-container tf-relative">
        <p class="tf-eyebrow">NOS DEUX MODES D’ACCOMPAGNEMENT</p>
        <h2>
          Des tarifs clairs, <em>selon vos besoins.</em>
        </h2>
        <p class="tf-intro">
          Confiez-nous l’ensemble de votre conciergerie ou choisissez des prestations ponctuelles. Les deux
          modes de facturation sont distincts.
        </p>

        <div class="tf-management-banner" id="gestion-complete">
          <div>
            <span class="tf-eyebrow">01 · CONCIERGERIE COMPLÈTE · OFFRE DE LANCEMENT</span>
            <h3>Une gestion coordonnée de votre location</h3>
            <p class="tf-management-rate">
              À partir de <strong>18 % TTC</strong> des revenus locatifs
            </p>
            <p>
              Coordination des séjours, accueil et assistance, suivi du logement. Les prestations de ménage,
              de linge et les interventions ponctuelles sont facturées séparément selon le devis.
            </p>
            <p class="tf-management-detail">
              La base de calcul des revenus locatifs et les services compris seront précisés dans votre
              proposition.
            </p>
          </div>
          <a class="tf-btn tf-btn-gold" href="/conciergerie/gestion-complete/">
            Découvrir la gestion complète <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="tf-package-heading" id="formules-a-la-carte">
          <p class="tf-eyebrow">02 · PRESTATIONS À LA CARTE</p>
          <h3>
            Trois formules <em>par séjour.</em>
          </h3>
          <p>
            Choisissez un forfait de préparation et d’accueil adapté à votre logement, sans commission de
            gestion complète.
          </p>
        </div>
        <div class="tf-offres tf-formules-grid">
          {formules.map((formule) => (
            <article class:list={['tf-offre', 'tf-package', { 'tf-package-featured': formule.vedette }]}>
              {formule.vedette && <span class="tf-package-badge">FORMULE MISE EN AVANT</span>}
              <h3>Formule {formule.nom}</h3>
              <p class="tf-package-subtitle">{formule.sousTitre}</p>
              <div class="tf-package-price">
                <span>À partir de</span>
                <strong>{formule.prix}</strong>
                <small>TTC / séjour</small>
              </div>
              <ul>
                {formule.prestations.map((point) => (
                  <li>
                    <span aria-hidden="true">✓</span>
                    {point}
                  </li>
                ))}
              </ul>
              <a
                class:list={['tf-btn', formule.vedette ? 'tf-btn-gold' : 'tf-btn-white']}
                href="#demander-devis"
              >
                Demander cette formule <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>
        <p class="tf-package-disclaimer">
          Tarifs indicatifs de départ pour un petit logement à Paris, sous réserve de la surface, de l’accès,
          du nombre de voyageurs et des prestations réellement nécessaires. Draps, serviettes, produits et
          consommables ne sont pas fournis sauf mention contraire au devis. Les forfaits par séjour sont
          distincts de la commission de gestion complète. Un devis détaille les prestations retenues et les
          frais éventuels.
        </p>
      </div>
    </section>
    <SectionBand theme="tarifs" />

    <section class="tf-section tf-services-prix tf-decorated" id="tarifs-a-la-carte">
      <svg class="tf-gold-ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 310 C260 40 540 410 840 155 S1210 45 1500 265" />
      </svg>
      <div class="tf-container">
        <p class="tf-eyebrow">REPÈRES DE PRIX À PARIS</p>
        <h2>
          Des prestations <em>au juste prix.</em>
        </h2>
        <p class="tf-intro">
          Vous préférez réserver une seule intervention ? Voici des prix de départ, sans obligation de choisir
          un forfait.
        </p>
        <div class="tf-service-price-list">
          {prixServices.map((service) => (
            <div class="tf-service-price-row">
              <div>
                <strong>{service.nom}</strong>
                <small>{service.unite}</small>
              </div>
              <span>
                À partir de <b>{service.prix}</b> TTC
              </span>
            </div>
          ))}
        </div>
        <p class="tf-price-note">
          Tarifs indicatifs de départ proposés par Maison & Monde, inspirés des prix constatés à Paris en
          2026. Ils ne constituent pas un devis. Déplacements, fournitures, urgences et demandes particulières
          peuvent entraîner des frais supplémentaires, précisés avant intervention.
        </p>
      </div>
    </section>

    <section class="tf-section tf-how tf-decorated">
      <svg class="tf-gold-ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 100 C310 370 490 20 830 215 S1200 345 1500 90" />
      </svg>
      <div class="tf-container tf-split">
        <div class="tf-photo">
          <img
            src="/images/conciergerie/appartement-paris.webp"
            alt="Salon lumineux préparé pour accueillir des voyageurs à Paris"
            loading="lazy"
            srcset="/images/conciergerie/appartement-paris-480.webp 480w, /images/conciergerie/appartement-paris-960.webp 960w, /images/conciergerie/appartement-paris.webp 1600w"
            sizes="(max-width: 780px) 100vw, 50vw"
            width="1600"
            height="595"
          />
        </div>
        <div>
          <p class="tf-eyebrow">UNE TARIFICATION TRANSPARENTE</p>
          <h2>
            Un devis qui tient compte <em>de votre réalité.</em>
          </h2>
          <p>
            Nos prix de départ vous donnent un premier repère. Nous étudions ensuite les caractéristiques de
            votre logement et les services réellement nécessaires.
          </p>
          <p>
            Votre proposition précise les prestations retenues, leurs modalités et les éventuels frais
            complémentaires.
          </p>
          <a class="tf-text-link" href="#demander-devis">
            Parlons de votre logement <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="tf-section tf-factors tf-decorated">
      <svg class="tf-gold-ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 305 C260 35 510 410 850 165 S1190 40 1500 270" />
      </svg>
      <div class="tf-container">
        <p class="tf-eyebrow">COMMENT EST CALCULÉ VOTRE DEVIS ?</p>
        <h2>
          Quatre éléments <em>essentiels.</em>
        </h2>
        <div class="tf-factor-grid">
          {facteurs.map((facteur) => (
            <article class="tf-factor">
              <span class="tf-factor-number">{facteur.n}</span>
              <h3>{facteur.titre}</h3>
              <p>{facteur.texte}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="tf-section tf-faq tf-decorated">
      <svg class="tf-gold-ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 120 C270 360 550 25 840 210 S1210 330 1500 100" />
      </svg>
      <div class="tf-container tf-faq-grid">
        <div>
          <p class="tf-eyebrow">QUESTIONS FRÉQUENTES</p>
          <h2>
            Vos questions sur <em>nos formules.</em>
          </h2>
          <p>
            Les réponses aux questions les plus courantes avant de demander votre proposition personnalisée.
          </p>
        </div>
        <div class="tf-faq-list">
          {questions.map((question) => (
            <details>
              <summary>
                {question.q}
                <span aria-hidden="true">+</span>
              </summary>
              <p>{question.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="tf-cta" id="demander-devis">
      <svg class="tf-cta-top-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 18 C230 2 380 58 635 52 S1050 0 1440 18 L1440 0 H0Z" fill="#fff" />
        <path
          d="M0 18 C230 2 380 58 635 52 S1050 0 1440 18"
          fill="none"
          stroke="#d9a45d"
          stroke-width="1.5"
        />
      </svg>
      <svg class="tf-cta-gold-lines" viewBox="0 0 1440 500" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-80 410 C230 515 530 495 810 462 S1200 380 1510 410" />
        <path d="M660 525 C900 270 1140 400 1500 235" />
      </svg>
      <div class="tf-container tf-cta-inner">
        <div>
          <p class="tf-eyebrow">PARLONS DE VOTRE LOGEMENT</p>
          <h2>
            Une offre sur mesure,
            <br />
            <em>en toute sérénité.</em>
          </h2>
          <p>
            Décrivez-nous votre logement et vos besoins. Nous vous proposerons une solution adaptée, avec un
            prix définitif détaillé dans votre devis, sans engagement avant son acceptation.
          </p>
          <div class="tf-actions">
            <a class="tf-btn tf-btn-gold" href="/conciergerie/demande-de-devis/">
              Demander un devis personnalisé <span aria-hidden="true">→</span>
            </a>
            <a class="tf-btn tf-btn-outline" href="tel:+33745292585">
              Nous appeler
            </a>
          </div>
        </div>
        <div class="tf-cta-photo">
          <img
            src="/images/conciergerie/services-complementaires.webp"
            alt="Appartement soigneusement préparé pour un séjour"
            loading="lazy"
            srcset="/images/conciergerie/services-complementaires-480.webp 480w, /images/conciergerie/services-complementaires-960.webp 960w, /images/conciergerie/services-complementaires.webp 1536w"
            sizes="(max-width: 780px) 100vw, 50vw"
            width="1536"
            height="1024"
          />
        </div>
      </div>
    </section>
  </div>
</Layout>
