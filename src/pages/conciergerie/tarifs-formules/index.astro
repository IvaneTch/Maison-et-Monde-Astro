---
import Layout from "../../../layouts/Layout.astro";

const formules = [
  { nom: "Essentielle", sousTitre: "Préparation entre deux séjours", prix: "80 €", vedette: false, prestations: ["Ménage complet du logement", "Mise en place des draps et serviettes fournis", "Contrôle visuel de qualité", "Logement prêt à accueillir les voyageurs"] },
  { nom: "Confort", sousTitre: "Accueil et préparation", prix: "95 €", vedette: true, prestations: ["Tout ce qui est prévu dans Essentielle", "Remise des clés organisée", "Informations pratiques aux voyageurs", "Coordination de l’arrivée"] },
  { nom: "Premium", sousTitre: "Préparation et suivi renforcé", prix: "120 €", vedette: false, prestations: ["Tout ce qui est prévu dans Confort", "Vérification renforcée du logement", "Réassort avec produits fournis", "Compte rendu après intervention"] },
];
const prixServices = [
  { nom: "Ménage entre deux séjours · studio / T1", prix: "55 €", unite: "par intervention" },
  { nom: "Ménage entre deux séjours · T2 / T3", prix: "80 €", unite: "par intervention" },
  { nom: "Accueil des voyageurs / remise des clés", prix: "35 €", unite: "par arrivée" },
  { nom: "Gestion du linge", prix: "20 €", unite: "par séjour" },
];
const facteurs = [
  { n: "01", titre: "Votre logement", texte: "Surface, nombre de pièces, équipements et particularités du bien." },
  { n: "02", titre: "Les prestations", texte: "Ménage, accueil, linge, suivi et services complémentaires souhaités." },
  { n: "03", titre: "La fréquence", texte: "Nombre de rotations, régularité des interventions et délais de préparation." },
  { n: "04", titre: "Vos consignes", texte: "Organisation des accès, fournitures, contraintes et demandes spécifiques." },
];
const questions = [
  { q: "Les prix affichés sont-ils définitifs ?", a: "Non. Les montants indiqués sont des prix de départ TTC. Le tarif définitif est précisé dans un devis selon la surface, la fréquence, les accès et les services retenus." },
  { q: "Puis-je réserver uniquement un ménage entre deux séjours ?", a: "Oui. Vous pouvez demander une prestation ponctuelle ou régulière sans souscrire à une gestion complète, sous réserve de disponibilité." },
  { q: "Le linge et les consommables sont-ils inclus ?", a: "Leur prise en charge est précisée dans votre devis. Les achats, fournitures et prestations supplémentaires peuvent faire l’objet d’une facturation distincte." },
  { q: "Puis-je faire évoluer ma formule ?", a: "Oui. Nous pouvons réévaluer les prestations en fonction de l’évolution de vos besoins, sous réserve des disponibilités et des conditions convenues." },
];
---
<Layout title="Tarifs et formules de conciergerie à Paris | Maison & Monde" description="Découvrez nos formules de conciergerie à Paris et en Île-de-France : gestion complète ou prestations à la carte, avec prix de départ indicatifs et devis personnalisé.">
  <main class="tf">
    <section class="tf-hero">
      <div class="tf-hero-image" aria-hidden="true"></div>
      <div class="tf-container tf-hero-content">
        <p class="tf-eyebrow">MAISON & MONDE · CONCIERGERIE</p>
        <h1>Des formules adaptées<br />à <em>votre logement.</em></h1>
        <p>Gestion complète ou prestations à la carte : choisissez un accompagnement souple, pensé pour votre location de courte durée à Paris et en Île-de-France.</p>
        <div class="tf-actions"><a class="tf-btn tf-btn-gold" href="#nos-formules">Découvrir nos formules <span aria-hidden="true">→</span></a><a class="tf-btn tf-btn-outline" href="#demander-devis">Obtenir un devis</a></div>
      </div>
      <svg class="tf-wave" viewBox="0 0 1440 85" preserveAspectRatio="none" aria-hidden="true"><path d="M0 33 C280 105 540 5 850 42 S1190 85 1440 25 L1440 85 H0Z" fill="#f8fbfd"/><path d="M0 33 C280 105 540 5 850 42 S1190 85 1440 25" stroke="#d8aa69" stroke-width="2" fill="none"/></svg>
    </section>

    <section class="tf-section tf-formules tf-decorated" id="nos-formules"><svg class="tf-gold-ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true"><path d="M-60 310 C260 40 540 410 840 155 S1210 45 1500 265" /></svg>
      <div class="tf-orb tf-orb-left" aria-hidden="true"></div>
      <div class="tf-container tf-relative">
        <p class="tf-eyebrow">NOS DEUX MODES D’ACCOMPAGNEMENT</p>
        <h2>Des tarifs clairs, <em>selon vos besoins.</em></h2>
        <p class="tf-intro">Confiez-nous l’ensemble de votre conciergerie ou choisissez des prestations ponctuelles. Les deux modes de facturation sont distincts.</p>

        <div class="tf-management-banner" id="gestion-complete">
          <div>
            <span class="tf-eyebrow">01 · CONCIERGERIE COMPLÈTE · OFFRE DE LANCEMENT</span>
            <h3>Une gestion coordonnée de votre location</h3>
            <p class="tf-management-rate">À partir de <strong>18 % TTC</strong> des revenus locatifs</p>
            <p>Coordination des séjours, accueil et assistance, suivi du logement. Les prestations de ménage, de linge et les interventions ponctuelles sont facturées séparément selon le devis.</p>
            <p class="tf-management-detail">La base de calcul des revenus locatifs et les services compris seront précisés dans votre proposition.</p>
          </div>
          <a class="tf-btn tf-btn-gold" href="/conciergerie/gestion-complete/">Découvrir la gestion complète <span aria-hidden="true">→</span></a>
        </div>

        <div class="tf-package-heading" id="formules-a-la-carte">
          <p class="tf-eyebrow">02 · PRESTATIONS À LA CARTE</p>
          <h3>Trois formules <em>par séjour.</em></h3>
          <p>Choisissez un forfait de préparation et d’accueil adapté à votre logement, sans commission de gestion complète.</p>
        </div>
        <div class="tf-offres tf-formules-grid">
          {formules.map(formule => <article class:list={["tf-offre", "tf-package", { "tf-package-featured": formule.vedette }]}>
            {formule.vedette && <span class="tf-package-badge">FORMULE MISE EN AVANT</span>}
            <h3>Formule {formule.nom}</h3>
            <p class="tf-package-subtitle">{formule.sousTitre}</p>
            <div class="tf-package-price"><span>À partir de</span><strong>{formule.prix}</strong><small>TTC / séjour</small></div>
            <ul>{formule.prestations.map(point => <li><span aria-hidden="true">✓</span>{point}</li>)}</ul>
            <a class:list={["tf-btn", formule.vedette ? "tf-btn-gold" : "tf-btn-white"]} href="#demander-devis">Demander cette formule <span aria-hidden="true">→</span></a>
          </article>)}
        </div>
        <p class="tf-package-disclaimer">Tarifs indicatifs de départ pour un petit logement à Paris, sous réserve de la surface, de l’accès, du nombre de voyageurs et des prestations réellement nécessaires. Draps, serviettes, produits et consommables ne sont pas fournis sauf mention contraire au devis. Les forfaits par séjour sont distincts de la commission de gestion complète. Un devis détaille les prestations retenues et les frais éventuels.</p>
      </div>
    </section>

    <section class="tf-section tf-services-prix tf-decorated" id="tarifs-a-la-carte">
      <svg class="tf-gold-ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true"><path d="M-60 310 C260 40 540 410 840 155 S1210 45 1500 265" /></svg>
      <div class="tf-container"><p class="tf-eyebrow">REPÈRES DE PRIX À PARIS</p><h2>Des prestations <em>au juste prix.</em></h2><p class="tf-intro">Vous préférez réserver une seule intervention ? Voici des prix de départ, sans obligation de choisir un forfait.</p>
        <div class="tf-service-price-list">{prixServices.map(service => <div class="tf-service-price-row"><div><strong>{service.nom}</strong><small>{service.unite}</small></div><span>À partir de <b>{service.prix}</b> TTC</span></div>)}</div>
        <p class="tf-price-note">Tarifs indicatifs de départ proposés par Maison & Monde, inspirés des prix constatés à Paris en 2026. Ils ne constituent pas un devis. Déplacements, fournitures, urgences et demandes particulières peuvent entraîner des frais supplémentaires, précisés avant intervention.</p>
      </div>
    </section>

    <section class="tf-section tf-how tf-decorated"><svg class="tf-gold-ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true"><path d="M-60 100 C310 370 490 20 830 215 S1200 345 1500 90" /></svg>
      <div class="tf-container tf-split">
        <div class="tf-photo"><img src="/images/conciergerie/salon-conciergerie.jpg" alt="Salon lumineux préparé pour accueillir des voyageurs à Paris" loading="lazy" /></div>
        <div><p class="tf-eyebrow">UNE TARIFICATION TRANSPARENTE</p><h2>Un devis qui tient compte <em>de votre réalité.</em></h2><p>Nos prix de départ vous donnent un premier repère. Nous étudions ensuite les caractéristiques de votre logement et les services réellement nécessaires.</p><p>Votre proposition précise les prestations retenues, leurs modalités et les éventuels frais complémentaires.</p><a class="tf-text-link" href="#demander-devis">Parlons de votre logement <span aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section class="tf-section tf-factors tf-decorated"><svg class="tf-gold-ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true"><path d="M-60 305 C260 35 510 410 850 165 S1190 40 1500 270" /></svg>
      <div class="tf-container"><p class="tf-eyebrow">COMMENT EST CALCULÉ VOTRE DEVIS ?</p><h2>Quatre éléments <em>essentiels.</em></h2><div class="tf-factor-grid">{facteurs.map(facteur => <article class="tf-factor"><span class="tf-factor-number">{facteur.n}</span><h3>{facteur.titre}</h3><p>{facteur.texte}</p></article>)}</div></div>
    </section>

    <section class="tf-section tf-faq tf-decorated"><svg class="tf-gold-ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true"><path d="M-60 120 C270 360 550 25 840 210 S1210 330 1500 100" /></svg>
      <div class="tf-container tf-faq-grid"><div><p class="tf-eyebrow">QUESTIONS FRÉQUENTES</p><h2>Vos questions sur <em>nos formules.</em></h2><p>Les réponses aux questions les plus courantes avant de demander votre proposition personnalisée.</p></div><div class="tf-faq-list">{questions.map(question => <details><summary>{question.q}<span aria-hidden="true">+</span></summary><p>{question.a}</p></details>)}</div></div>
    </section>

    <section class="tf-cta" id="demander-devis">
      <svg class="tf-cta-top-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0 18 C230 2 380 58 635 52 S1050 0 1440 18 L1440 0 H0Z" fill="#fff"/><path d="M0 18 C230 2 380 58 635 52 S1050 0 1440 18" fill="none" stroke="#d9a45d" stroke-width="1.5"/></svg>
      <svg class="tf-cta-gold-lines" viewBox="0 0 1440 500" preserveAspectRatio="none" aria-hidden="true"><path d="M-80 410 C230 515 530 495 810 462 S1200 380 1510 410"/><path d="M660 525 C900 270 1140 400 1500 235"/></svg>
      <div class="tf-container tf-cta-inner"><div><p class="tf-eyebrow">PARLONS DE VOTRE LOGEMENT</p><h2>Une offre sur mesure,<br /><em>en toute sérénité.</em></h2><p>Décrivez-nous votre logement et vos besoins. Nous vous proposerons une solution adaptée, avec un prix définitif détaillé dans votre devis, sans engagement avant son acceptation.</p><div class="tf-actions"><a class="tf-btn tf-btn-gold" href="/contactez-nous/">Demander un devis personnalisé <span aria-hidden="true">→</span></a><a class="tf-btn tf-btn-outline" href="tel:+33745292585">Nous appeler</a></div></div><div class="tf-cta-photo"><img src="/images/conciergerie/services-complementaires.jpg" alt="Appartement soigneusement préparé pour un séjour" loading="lazy" /></div></div></section>
  </main>
</Layout>

<style is:global>
.tf{--tf-navy:#0a2a43;--tf-blue:#174c70;--tf-gold:#e8ad5c;color:var(--tf-navy);font-family:inherit;overflow:hidden}.tf *{box-sizing:border-box}.tf-container{width:min(1140px,88%);margin:auto}.tf-relative{position:relative;z-index:1}.tf h1,.tf h2,.tf h3{margin:0;line-height:1.14}.tf h1,.tf h2{font-family:Georgia,'Times New Roman',serif;font-weight:500}.tf h1{font-size:clamp(42px,5vw,72px);color:white}.tf h2{font-size:clamp(35px,4vw,53px)}.tf h1 em,.tf h2 em{font-style:normal;color:#d9a052}.tf p{line-height:1.75}.tf-eyebrow{font-size:11px;letter-spacing:2.5px;font-weight:800;color:#bd8a47;margin:0 0 18px!important}.tf-hero{position:relative;min-height:620px;display:flex;align-items:center;background:#0a2439}.tf-hero-image{position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,29,49,.94) 0%,rgba(5,29,49,.80) 43%,rgba(5,29,49,.2) 100%),url('/images/conciergerie/salon-conciergerie.jpg') center/cover}.tf-hero-content{position:relative;z-index:1;padding:95px 0 120px}.tf-hero-content>p:not(.tf-eyebrow){max-width:570px;color:#edf3f6;font-size:16px;margin:22px 0 28px}.tf-actions{display:flex;flex-wrap:wrap;gap:12px}.tf-btn{display:inline-flex;align-items:center;justify-content:center;gap:15px;min-height:46px;border-radius:28px;padding:12px 22px;font-size:13px;font-weight:750;text-decoration:none;transition:transform .55s cubic-bezier(.22,1,.36,1),box-shadow .55s ease}.tf-btn:hover{transform:translateY(-3px)}.tf-btn-gold{background:#efb15e;color:#102b43;box-shadow:0 8px 22px rgba(5,27,45,.17)}.tf-btn-outline{border:1px solid rgba(255,255,255,.75);color:#fff}.tf-btn-white{background:#fff;color:#123b57;border:1px solid #e5edf2}.tf-wave{position:absolute;bottom:-1px;left:0;width:100%;height:85px}.tf-section{position:relative;padding:96px 0}.tf-formules{background:#f8fbfd;text-align:center}.tf-intro{max-width:670px;margin:18px auto 42px;color:#52677a}.tf-offres{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;text-align:left}.tf-offre{padding:38px;border:1px solid #e6edf2;background:white;border-radius:22px;box-shadow:0 15px 35px rgba(8,39,64,.1),0 28px 48px rgba(8,39,64,.05);transition:transform .65s cubic-bezier(.22,1,.36,1),box-shadow .65s ease}.tf-offre-featured{background:linear-gradient(140deg,#0b2b45,#195575);color:white;border-color:#1b5473}.tf-offre-top{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:10px;letter-spacing:1.8px;font-weight:800;color:#c79555}.tf-offre-number{font-family:Georgia,serif;font-size:26px;opacity:.6}.tf-offre h3{font-family:Georgia,serif;font-size:33px;font-weight:500;margin:18px 0}.tf-offre>p{min-height:90px;font-size:14px;color:#516a7b}.tf-offre-featured>p{color:#dceaf1}.tf-offre ul{list-style:none;margin:26px 0;padding:0;display:grid;gap:15px}.tf-offre li{display:flex;align-items:flex-start;gap:12px;font-size:14px}.tf-offre li span{color:#d9a052;font-weight:800}.tf-price{padding:18px 0 22px;margin-top:12px;border-top:1px solid #e6edf2;font-size:22px;font-family:Georgia,serif}.tf-offre-featured .tf-price{border-color:#39637d}.tf-price small{display:block;margin-top:6px;font:12px/1.5 Arial,sans-serif;opacity:.75}.tf-offre .tf-btn{margin-top:4px}.tf-how{background:#fff}.tf-split{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}.tf-split p:not(.tf-eyebrow){color:#52677a}.tf-photo{position:relative;aspect-ratio:1.13;border-radius:42% 14% 35% 12%;overflow:hidden;box-shadow:0 24px 48px rgba(10,42,67,.18)}.tf-photo img,.tf-cta-photo img{width:100%;height:100%;object-fit:cover}.tf-text-link{display:inline-block;margin-top:16px;color:#1a587d;font-weight:800;text-decoration:none;border-bottom:1px solid #d7a35c;padding-bottom:7px}.tf-factors{background:linear-gradient(145deg,#f0f7fb,#fbfdff);text-align:center}.tf-factor-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:44px;text-align:left}.tf-factor{background:white;padding:28px 24px;border-radius:18px;box-shadow:0 12px 26px rgba(10,42,67,.09);border:1px solid #e8eff4;transition:transform .65s cubic-bezier(.22,1,.36,1)}.tf-factor-number{font:27px Georgia,serif;color:#d2a063}.tf-factor h3{font-size:19px;margin:17px 0 12px}.tf-factor p{font-size:13px;color:#52677a;margin:0}.tf-faq{background:#fff}.tf-faq-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:70px}.tf-faq-grid>div:first-child>p:last-child{color:#617487}.tf-faq-list{display:grid;gap:12px}.tf-faq-list details{background:#fff;border:1px solid #e5edf2;border-radius:12px;box-shadow:0 8px 20px rgba(10,42,67,.07);overflow:hidden}.tf-faq-list summary{list-style:none;cursor:pointer;padding:20px;font-size:14px;font-weight:700;display:flex;justify-content:space-between;gap:15px}.tf-faq-list summary::-webkit-details-marker{display:none}.tf-faq-list summary span{color:#c99552;font-size:22px}.tf-faq-list details[open] summary span{transform:rotate(45deg)}.tf-faq-list details p{padding:0 20px 20px;margin:0;color:#52677a;font-size:14px}.tf-cta{background:linear-gradient(125deg,#0a2a43,#195676);color:#fff;overflow:hidden}.tf-cta-inner{display:grid;grid-template-columns:1fr .85fr;gap:60px;align-items:center;min-height:440px}.tf-cta h2{color:white}.tf-cta p:not(.tf-eyebrow){color:#dce9f1;max-width:540px}.tf-cta-photo{height:440px;overflow:hidden;clip-path:ellipse(92% 90% at 95% 50%)}.tf-orb{position:absolute;width:310px;height:310px;border:28px solid rgba(180,222,248,.2);border-radius:50%;pointer-events:none}.tf-orb-left{left:-230px;top:90px}
@media(min-width:901px) and (hover:hover){.tf-offre:hover{transform:translateY(-5px);box-shadow:0 22px 48px rgba(8,39,64,.14)}.tf-factor:hover{transform:translateY(-4px)}}
@media(max-width:900px){.tf-section{padding:70px 0}.tf-offres,.tf-split,.tf-faq-grid,.tf-cta-inner{grid-template-columns:1fr;gap:30px}.tf-factor-grid{grid-template-columns:repeat(2,1fr)}.tf-offre>p{min-height:0}.tf-cta-inner{padding-top:65px}.tf-cta-photo{height:260px;clip-path:none;border-radius:30px 30px 0 0}.tf-hero{min-height:560px}.tf-hero-image{background:linear-gradient(90deg,rgba(5,29,49,.93),rgba(5,29,49,.45)),url('/images/conciergerie/salon-conciergerie.jpg') center/cover}}
@media(max-width:600px){.tf-container{width:90%}.tf-hero-content{padding:75px 0 110px}.tf-hero{min-height:520px}.tf h1{font-size:clamp(37px,10vw,50px)}.tf-section{padding:60px 0}.tf-offre{padding:28px 23px}.tf-factor-grid{grid-template-columns:1fr}.tf-actions{align-items:flex-start}.tf-btn{font-size:12px}.tf-faq-grid{gap:22px}.tf-cta-inner{gap:25px}.tf-cta-photo{height:220px}}
@media(prefers-reduced-motion:reduce){.tf .tf-btn,.tf .tf-offre,.tf .tf-factor{transition:none!important}}

/* Maison & Monde — harmonisation avec les autres pages Conciergerie */
@media (min-width:901px) {
  .tf .tf-hero {height:720px;min-height:720px;max-height:720px;}
}
.tf .tf-decorated {position:relative;isolation:isolate;overflow:hidden;}
.tf .tf-decorated > .tf-container {position:relative;z-index:2;}
.tf .tf-gold-ribbon {position:absolute;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;opacity:.65;}
.tf .tf-gold-ribbon path {fill:none;stroke:#d5a15c;stroke-width:1.4;vector-effect:non-scaling-stroke;}
.tf .tf-photo {isolation:isolate;overflow:visible;border-radius:0;box-shadow:none;}
.tf .tf-photo::before {content:"";position:absolute;inset:-5% -5% 3% 5%;border:2px solid #d8a25a;border-radius:45% 55% 52% 48% / 55% 42% 58% 45%;transform:rotate(-8deg);z-index:-1;pointer-events:none;}
.tf .tf-photo::after {content:"";position:absolute;inset:4% -4% -5% 5%;border:1.4px solid rgba(216,162,90,.7);border-radius:55% 45% 43% 57% / 42% 58% 42% 58%;transform:rotate(7deg);z-index:-1;pointer-events:none;}
.tf .tf-photo img {display:block;border-radius:43% 57% 52% 48% / 52% 43% 57% 48%;box-shadow:0 22px 42px rgba(8,38,62,.22),0 38px 62px rgba(8,38,62,.11);}
.tf .tf-cta-photo {position:relative;overflow:visible;clip-path:none;isolation:isolate;}
.tf .tf-cta-photo::before {content:"";position:absolute;inset:3% -4% 3% 2%;border:2px solid #d8a25a;border-radius:50% 50% 56% 44% / 58% 42% 58% 42%;transform:rotate(-7deg);z-index:-1;pointer-events:none;}
.tf .tf-cta-photo img {display:block;border-radius:48% 52% 55% 45% / 57% 44% 56% 43%;box-shadow:0 22px 42px rgba(0,16,31,.42),0 38px 65px rgba(0,16,31,.2);}
.tf .tf-offre {box-shadow:0 14px 28px rgba(8,38,62,.14),0 28px 55px rgba(8,38,62,.1);}
.tf .tf-factor {box-shadow:0 12px 25px rgba(8,38,62,.13),0 24px 46px rgba(8,38,62,.09);transition:transform .7s cubic-bezier(.22,1,.36,1),box-shadow .7s ease;}
.tf .tf-faq-list details {box-shadow:0 10px 23px rgba(8,38,62,.12),0 20px 42px rgba(8,38,62,.08);transition:transform .7s cubic-bezier(.22,1,.36,1),box-shadow .7s ease;}
.tf .tf-photo,.tf .tf-cta-photo {transition:transform .7s cubic-bezier(.22,1,.36,1);}
@media (min-width:901px) and (hover:hover) {
 .tf .tf-offre:hover,.tf .tf-factor:hover,.tf .tf-faq-list details:hover {transform:translateY(-4px);box-shadow:0 23px 39px rgba(8,38,62,.18),0 36px 68px rgba(8,38,62,.13);}
 .tf .tf-photo:hover,.tf .tf-cta-photo:hover {transform:translateY(-3px);}
}
@media (max-width:900px) {
 .tf .tf-gold-ribbon {opacity:.3;}
 .tf .tf-photo,.tf .tf-cta-photo {transform:none!important;transition:none!important;}
 .tf .tf-offre,.tf .tf-factor,.tf .tf-faq-list details {transform:none!important;transition:none!important;}
 .tf .tf-cta-photo {height:260px;clip-path:none;border-radius:0;}
 .tf .tf-cta-photo img {height:100%;}
}
@media (max-width:600px) {
 .tf .tf-cta-photo {height:220px;margin-bottom:32px;}
 .tf .tf-photo::before,.tf .tf-photo::after {inset:0 -2% 0 2%;}
}

/* Bandeau final : même langage graphique que les autres pages conciergerie */
.tf .tf-cta {position:relative;isolation:isolate;overflow:hidden;background:linear-gradient(110deg,#092b45 0%,#123f60 57%,#155879 100%);}
.tf .tf-cta-top-wave {position:absolute;top:-1px;left:0;width:100%;height:82px;z-index:3;pointer-events:none;}
.tf .tf-cta-gold-lines {position:absolute;inset:0;width:100%;height:100%;z-index:1;pointer-events:none;}
