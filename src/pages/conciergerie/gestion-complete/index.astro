---
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
const prestations = [
 {num:"01",title:"Ménage et préparation",desc:"Nettoyage entre les séjours, mise en place du linge et vérification des détails avant chaque arrivée.",img:"menage-preparation.jpg",href:"/conciergerie/menage-preparation-logement/"},
 {num:"02",title:"Accueil des voyageurs",desc:"Arrivée en personne ou accès autonome, remise des consignes et coordination des départs selon votre organisation.",img:"accueil-voyageurs.jpg",href:"/conciergerie/accueil-voyageurs/"},
 {num:"03",title:"Suivi et maintenance",desc:"Contrôle visuel du logement, signalement des anomalies et coordination de petites interventions avec votre accord.",img:"suivi-maintenance.jpg",href:"/conciergerie/suivi-maintenance/"},
 {num:"04",title:"Services complémentaires",desc:"Réassort, entretien du linge et prestations particulières selon vos besoins et votre calendrier.",img:"services-complementaires.jpg",href:"/conciergerie/services-a-la-carte/"}
];
const etapes=[
 {n:"01",t:"Nous échangeons",d:"Nous étudions votre logement, vos attentes et les modalités d'accueil."},
 {n:"02",t:"Nous définissons la formule",d:"Vous choisissez les prestations à inclure dans votre accompagnement."},
 {n:"03",t:"Nous organisons les séjours",d:"Nous coordonnons les interventions prévues entre les arrivées et les départs."},
 {n:"04",t:"Vous gardez la maîtrise",d:"Nous vous informons des points importants et validons toute prestation supplémentaire."}
];
const questions=[
 {q:"La gestion complète inclut-elle la gestion des annonces et des réservations ?",a:"Notre accompagnement porte sur les opérations sur place et leur coordination. La gestion des annonces, des prix et des réservations peut être discutée séparément selon vos besoins, sans être incluse automatiquement."},
 {q:"Puis-je choisir uniquement certaines prestations ?",a:"Oui. Vous pouvez opter pour un accompagnement complet ou sélectionner des services à la carte."},
 {q:"Intervenez-vous pour plusieurs logements ?",a:"Oui, nous étudions votre demande selon le nombre de logements, leur localisation et la fréquence des interventions."},
 {q:"Comment le tarif est-il calculé ?",a:"Nous établissons un devis personnalisé selon le logement, les prestations, la fréquence et les contraintes d'organisation."}
];
---
<!doctype html><html lang="fr"><head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content="Gestion complète de locations courte durée à Paris : ménage, accueil des voyageurs, suivi du logement et services à la carte avec Maison & Monde." />
<link rel="icon" type="image/png" href="/favicon.png" />
<title>Gestion complète de location courte durée à Paris | Maison & Monde</title>
</head><body><Header />
<main class="gestion">
<section class="hero"><div class="hero-photo" aria-hidden="true"></div><div class="wrap hero-inner">
<p class="eyebrow">MAISON & MONDE · CONCIERGERIE À PARIS</p><h1>Gestion complète<br /><span>de votre logement</span></h1>
<p>De la préparation du logement à l'accueil des voyageurs, nous coordonnons les prestations essentielles pour des séjours sereins.</p>
<div class="actions"><a class="button gold" href="#contact-conciergerie">Demander un devis personnalisé <span>→</span></a><a class="button ghost" href="#prestations">Découvrir notre accompagnement</a></div></div>
<svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0 35 C290 115 610 5 880 42 S1250 90 1440 32 L1440 90 H0Z" fill="white"/><path d="M0 35 C290 115 610 5 880 42 S1250 90 1440 32" fill="none" stroke="#d7a35c" stroke-width="2"/></svg></section>
<section class="section know-how decorated"><div class="circle left" aria-hidden="true"></div><svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true"><path d="M-60 320 C290 25 510 420 820 165 S1200 40 1500 270"/></svg><div class="wrap split top-layer"><div><p class="eyebrow">VOTRE PARTENAIRE SUR PLACE</p><h2>Un seul interlocuteur, <em>plus de sérénité</em></h2><p>Vous louez un appartement à Paris ou en Île-de-France ? Maison & Monde vous accompagne dans l'organisation des prestations nécessaires entre deux séjours, selon vos consignes et les besoins de votre logement.</p><ul class="checks"><li>Coordination des prestations convenues</li><li>Accueil physique ou arrivée autonome</li><li>Suivi attentif du logement</li><li>Services ajustables selon vos besoins</li></ul></div><div class="image-frame"><img src="/images/conciergerie/salon-conciergerie.jpg" alt="Appartement parisien préparé pour accueillir des voyageurs" loading="lazy" /></div></div></section>
<section class="section extras decorated" id="prestations"><div class="circle right" aria-hidden="true"></div><svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true"><path d="M-60 130 C280 380 470 20 800 220 S1230 330 1500 95"/></svg><div class="wrap top-layer"><p class="eyebrow">UN ACCOMPAGNEMENT COMPLET</p><h2>Quatre services, <em>une seule organisation</em></h2><p class="subtext">Découvrez les prestations que nous pouvons réunir dans une formule adaptée à votre logement.</p><div class="gestion-grid">{prestations.map(s=><article class="gestion-card"><img src={`/images/conciergerie/${s.img}`} alt={s.title} loading="lazy" /><div class="card-body"><span class="card-num">{s.num} / CONCIERGERIE</span><h3>{s.title}</h3><p>{s.desc}</p><a href={s.href}>Découvrir ce service →</a></div></article>)}</div></div></section>
<section class="section process decorated"><div class="circle left" aria-hidden="true"></div><svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true"><path d="M-60 300 C250 45 550 410 900 150 S1200 40 1500 245"/></svg><div class="wrap top-layer"><p class="eyebrow">SIMPLE ET TRANSPARENT</p><h2>Comment se déroule <em>notre accompagnement ?</em></h2><div class="steps">{etapes.map(e=><article><div class="step-number">{e.n}</div><h3>{e.t}</h3><p>{e.d}</p></article>)}</div></div></section>
<section class="section linen decorated"><div class="circle right" aria-hidden="true"></div><svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true"><path d="M-60 85 C320 360 510 30 830 190 S1170 355 1500 120"/></svg><div class="wrap split top-layer"><div class="image-frame"><img src="/images/conciergerie/attention-details.jpg" alt="Préparation soignée d'un logement entre deux séjours" loading="lazy" /></div><div><p class="eyebrow">VOTRE LOGEMENT, VOS RÈGLES</p><h2>Une gestion adaptée <em>à vos priorités</em></h2><p>Vous définissez le niveau d'accompagnement souhaité. Nous organisons les interventions convenues, vous signalons les points importants et demandons votre validation avant toute dépense supplémentaire.</p><ul class="checks"><li>Prestations définies ensemble</li><li>Organisation selon les réservations</li><li>Communication claire</li><li>Possibilité d'ajouter des services à la carte</li></ul></div></div></section>
<section class="section faq decorated"><div class="wrap top-layer"><p class="eyebrow">QUESTIONS FRÉQUENTES</p><h2>Tout savoir sur <em>la gestion complète</em></h2><div class="faq-list">{questions.map(item=><details><summary>{item.q}<span aria-hidden="true">+</span></summary><p>{item.a}</p></details>)}</div></div></section>
<section class="closing" id="contact-conciergerie"><svg class="closing-wave" viewBox="0 0 1440 75" preserveAspectRatio="none" aria-hidden="true"><path d="M0 25 C250 -30 500 75 750 30 S1190 20 1440 5 L1440 0 H0Z" fill="white"/><path d="M0 25 C250 -30 500 75 750 30 S1190 20 1440 5" stroke="#d7a35c" fill="none" stroke-width="2"/></svg><div class="wrap closing-grid"><div><p class="eyebrow">UN ACCOMPAGNEMENT SUR MESURE</p><h2>Confiez-nous <em>l'organisation de vos séjours</em></h2><p>Échangeons sur votre logement et vos attentes pour préparer une proposition personnalisée. Notre formulaire de devis dédié à la conciergerie sera ajouté prochainement.</p><a class="button gold" href="/conciergerie/">Voir nos services de conciergerie <span>→</span></a></div><div class="closing-photo"><img src="/images/conciergerie/salon-conciergerie.jpg" alt="Intérieur parisien accueillant" loading="lazy" /></div></div></section>
</main><Footer /></body></html>
<style is:global>
.gestion{--navy:#092942;--gold:#d19b4e;--muted:#5d7182;color:var(--navy);font-family:Arial,Helvetica,sans-serif;overflow:hidden;background:#fff}.gestion *{box-sizing:border-box}.gestion .wrap{width:min(1180px,calc(100% - 52px));margin-inline:auto}.gestion h1,.gestion h2,.gestion h3{font-family:Georgia,'Times New Roman',serif;font-weight:400}.gestion h2{font-size:clamp(32px,3.8vw,49px);line-height:1.13;margin:0 0 22px}.gestion h2 em,.gestion h1 span{font-style:normal;color:var(--gold)}.gestion p{line-height:1.65}.gestion .eyebrow{font-size:11px;letter-spacing:2.2px;color:#bf873c;font-weight:800;margin:0 0 18px}.gestion .section{position:relative;padding:94px 0}.gestion .decorated{overflow:hidden;isolation:isolate}.gestion .top-layer{position:relative;z-index:2}.gestion .circle{position:absolute;z-index:0;border:1.4px solid #d3a15c;border-radius:50%;width:350px;height:350px;box-shadow:0 0 0 22px #e1f1fb91,0 0 0 42px #e9f6ff6b;pointer-events:none}.gestion .circle.left{left:-320px;top:25%}.gestion .circle.right{right:-320px;bottom:10%}.gestion .ribbon{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:0}.gestion .ribbon path{fill:none;stroke:#d4a15d;stroke-width:1.25;vector-effect:non-scaling-stroke;opacity:.5}.gestion .hero{position:relative;min-height:620px;display:flex;align-items:center;background:#102e48;color:#fff}.gestion .hero-photo{position:absolute;inset:0;background:url('/images/conciergerie/menage-preparation.jpg') center 52%/cover no-repeat}.gestion .hero:before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#061d32f2 0%,#08283ecb 43%,#09283e1f 83%);z-index:1}.gestion .hero-inner{position:relative;z-index:2;padding:90px 0 115px}.gestion .hero h1{font-size:clamp(49px,5.7vw,78px);line-height:1.06;margin:0 0 23px}.gestion .hero-inner>p:not(.eyebrow){max-width:445px;font-size:16px}.gestion .hero .eyebrow{color:#e5ae5c}.gestion .actions{display:flex;gap:15px;flex-wrap:wrap;margin-top:32px}.gestion .button{display:inline-flex;align-items:center;justify-content:center;gap:17px;border-radius:50px;padding:15px 23px;font-size:13px;font-weight:700;text-decoration:none;transition:transform .2s,box-shadow .2s}.gestion .button:hover{transform:translateY(-3px);box-shadow:0 12px 24px #081c3450}.gestion .button.gold{background:#f7bb53;color:#132c41;box-shadow:0 9px 22px #081c3436}.gestion .button.ghost{color:#fff;border:1px solid #ffffffab}.gestion .hero-wave{position:absolute;bottom:-1px;left:0;width:100%;height:82px;z-index:2}.gestion .split{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}.gestion .split p:not(.eyebrow){color:var(--muted);max-width:540px}.gestion .image-frame img{display:block;width:100%;height:355px;object-fit:cover;border-radius:22px;box-shadow:0 25px 43px #0b2b4a37}.gestion .benefits{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:26px}.gestion .benefits div{font-size:11px;text-align:center;font-weight:700;line-height:1.4}.gestion .benefits span{display:grid;place-items:center;margin:0 auto 9px;width:48px;height:48px;border:1.4px solid var(--gold);border-radius:50%;color:#0c456b;font-size:27px;font-weight:400;background:#fff;box-shadow:0 5px 13px #0a2d4518}.gestion .process{background:#f5f9fc}.gestion .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:26px;margin-top:42px}.gestion .steps article{position:relative}.gestion .steps article:not(:last-child):after{content:'→';position:absolute;right:-23px;top:78px;font-size:25px;color:#bd904f}.gestion .step-photo{position:relative}.gestion .step-photo img{width:100%;height:170px;object-fit:cover;border-radius:15px;display:block;box-shadow:0 14px 28px #092f4b29}.gestion .step-photo b{position:absolute;left:12px;bottom:-15px;background:#f3b84f;color:white;border:3px solid #fff;width:45px;height:45px;display:grid;place-items:center;border-radius:50%;font-size:12px}.gestion .steps h3{font-size:23px;margin:30px 0 8px}.gestion .steps p{font-size:13px;color:var(--muted);margin:0}.gestion .results{background:#fff}.gestion .subtext{color:var(--muted);margin:-7px 0 28px}.gestion .comparison{display:grid;grid-template-columns:1fr 1fr;gap:22px;position:relative}.gestion .comparison figure{position:relative;margin:0;min-width:0}.gestion .comparison img{width:100%;height:290px;object-fit:cover;border-radius:18px;display:block;box-shadow:0 19px 34px #092d4c32}.gestion .comparison figcaption{position:absolute;top:16px;left:16px;background:#fff;padding:10px 18px;border-radius:22px;font-size:13px;font-weight:700}.gestion .comparison figure:last-child figcaption{background:#f5b84f}.gestion .comparison-arrow{position:absolute;z-index:3;top:50%;left:50%;transform:translate(-50%,-50%);background:white;border:3px solid #f1b95c;border-radius:50%;width:55px;height:55px;display:grid;place-items:center;font-size:26px;box-shadow:0 8px 20px #082b4733}.gestion .note{font-size:11px;color:#72818e;margin-top:16px}.gestion .linen{background:#fbfcfe}.gestion .checks{padding:0;list-style:none;margin:22px 0 0}.gestion .checks li{position:relative;padding:9px 0 9px 39px;font-size:14px}.gestion .checks li:before{content:'✓';position:absolute;left:0;top:6px;background:#e9ac4d;color:#fff;border-radius:50%;width:26px;height:26px;display:grid;place-items:center;font-weight:800}.gestion .extras{background:#f8fbfd}.gestion .extras-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;margin-top:37px}.gestion .extras-grid article{background:#fff;border-radius:18px;overflow:hidden;box-shadow:0 19px 33px #0a2c4930;border:1px solid #e6ebef}.gestion .extras-grid img{display:block;width:100%;height:170px;object-fit:cover}.gestion .extras-grid article>div{padding:22px}.gestion .extras-grid h3{font-size:23px;margin:0 0 10px}.gestion .extras-grid p{font-size:13px;color:var(--muted);min-height:62px}.gestion .extras-grid a{font-size:13px;color:#15587c;text-decoration:none;font-weight:700}.gestion .closing{position:relative;background:linear-gradient(110deg,#06243b,#125071);color:white;overflow:hidden}.gestion .closing-wave{position:absolute;top:-1px;left:0;width:100%;height:75px;z-index:2}.gestion .closing-grid{display:grid;grid-template-columns:1fr 44%;align-items:center;gap:55px;min-height:425px}.gestion .closing-grid>div{padding:110px 0 75px}.gestion .closing h2{font-size:clamp(32px,3.7vw,48px)}.gestion .closing p:not(.eyebrow){max-width:540px}.gestion .closing .button{margin-top:20px}.gestion .closing-photo{position:relative;align-self:stretch;min-height:425px;overflow:hidden;clip-path:ellipse(90% 78% at 88% 52%)}.gestion .closing-photo:before{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;border-left:2px solid #d5a65d}.gestion .closing-photo img{height:100%;width:100%;object-fit:cover;display:block;filter:saturate(1.04)}
@media(max-width:900px){.gestion .split{gap:32px}.gestion .steps{gap:16px}.gestion .steps article:not(:last-child):after{right:-17px}.gestion .step-photo img{height:130px}.gestion .benefits{grid-template-columns:repeat(2,1fr)}.gestion .extras-grid{gap:14px}}
@media(max-width:650px){.gestion .wrap{width:calc(100% - 36px)}.gestion .section{padding:66px 0}.gestion .hero{min-height:600px}.gestion .hero-inner{padding:90px 0 115px}.gestion .hero h1{font-size:46px}.gestion .hero:before{background:linear-gradient(90deg,#061d32e8,#09283eb8)}.gestion .hero-wave{height:47px}.gestion .split,.gestion .comparison,.gestion .closing-grid{grid-template-columns:1fr}.gestion .split{gap:30px}.gestion .steps{grid-template-columns:repeat(2,1fr);gap:30px 17px}.gestion .steps article:after{display:none}.gestion .step-photo img{height:135px}.gestion .steps h3{font-size:20px}.gestion .comparison img{height:220px}.gestion .comparison-arrow{top:50%;width:45px;height:45px}.gestion .extras-grid{grid-template-columns:1fr}.gestion .extras-grid img{height:200px}.gestion .extras-grid p{min-height:0}.gestion .image-frame img{height:265px}.gestion .circle{width:240px;height:240px}.gestion .circle.left{left:-225px}.gestion .circle.right{right:-225px}.gestion .ribbon{opacity:.4}.gestion .closing-grid{gap:0}.gestion .closing-grid>div{padding:100px 0 35px}.gestion .closing-photo{min-height:230px;clip-path:ellipse(95% 90% at 52% 100%)}.gestion .closing-photo img{height:230px}.gestion .actions{flex-direction:column;align-items:flex-start}}
@media(prefers-reduced-motion:reduce){.gestion .button{transition:none}.gestion .button:hover{transform:none}}
</style>

<style is:global>
/* Hero pleine largeur : aucune bordure ni cadre autour de la photographie. */
.gestion .hero,.gestion .hero-photo{border:0!important;border-radius:0!important;box-shadow:none!important;outline:0!important}
/* Courbes dorées et volume discret, sans recouvrir les contenus. */
.gestion .know-how .image-frame img{border-radius:43% 57% 52% 48% / 50% 43% 57% 50%;box-shadow:22px 23px 0 #e7f3fb,0 30px 48px #092d4c29}
.gestion .closing-grid{width:min(1280px,calc(100% - 52px))}
@media(max-width:650px){.gestion .closing-grid{width:calc(100% - 36px)}.gestion .know-how .image-frame img{box-shadow:12px 14px 0 #e7f3fb,0 19px 30px #092d4c24}}
</style>

<style is:global>
/* Visuel validé : hero bord à bord, sans liseré blanc. */
.gestion .hero{width:100%;margin:0!important;border:none!important;overflow:hidden}
.gestion .hero-photo{inset:0!important;border:none!important;border-radius:0!important}
.gestion .hero-wave{bottom:-2px}
/* Photographie savoir-faire : découpe organique asymétrique. */
.gestion .know-how .image-frame{position:relative;isolation:isolate}
.gestion .know-how .image-frame::after{content:"";position:absolute;inset:4% -4% -4% 4%;background:#eaf4fa;border-radius:42% 58% 55% 45% / 48% 39% 61% 52%;z-index:-1}
.gestion .know-how .image-frame img{border-radius:42% 58% 55% 45% / 48% 39% 61% 52%!important;box-shadow:0 20px 42px #092d4c22!important}
/* Bande finale : image en forme de galet, entièrement visible et filet doré. */
.gestion .closing-grid{grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:55px}
.gestion .closing-photo{align-self:center;min-height:0;height:295px;overflow:visible;clip-path:none!important;border:1.5px solid #d5a65d;border-radius:46% 54% 58% 42% / 59% 42% 58% 41%;padding:5px;transform:rotate(-2deg);box-shadow:0 24px 42px #001a2b44}
.gestion .closing-photo:before{display:none!important}
.gestion .closing-photo img{width:100%;height:100%;object-fit:cover;border-radius:inherit;transform:rotate(2deg);clip-path:ellipse(74% 67% at 50% 50%)}
@media(max-width:650px){.gestion .closing-grid{grid-template-columns:1fr;gap:12px}.gestion .closing-photo{height:235px;margin-bottom:45px;transform:none}.gestion .closing-photo img{transform:none}.gestion .know-how .image-frame::after{inset:3% -2% -3% 2%}}
</style>

<style is:global>
/* Corrections ciblées : seulement les deux éléments indiqués. */
/* Hero bord à bord même si un conteneur parent ajoute une marge. */
.gestion .hero{width:100vw!important;max-width:none!important;position:relative;left:50%;margin-left:-50vw!important;margin-right:0!important;border:0!important;outline:0!important;box-shadow:none!important}
.gestion .hero-photo{inset:0!important}
/* Image de fin : remplissage intégral de la forme organique, sans fente horizontale. */
.gestion .closing-photo{position:relative!important;overflow:hidden!important;padding:0!important;transform:none!important;border:2px solid #d5a65d!important;border-radius:48% 52% 58% 42% / 58% 48% 52% 42%!important;clip-path:none!important;box-shadow:0 22px 42px #001a2b44!important}
.gestion .closing-photo img{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;object-fit:cover!important;object-position:center!important;transform:none!important;clip-path:none!important;border-radius:inherit!important}
@media(max-width:650px){.gestion .closing-photo{height:235px!important}}
</style>

<style is:global>
/* Suppression du cadre blanc provenant des marges globales du navigateur. */
html, body { margin: 0 !important; padding: 0 !important; width: 100%; }
body { overflow-x: clip; }
body > main.gestion, main.gestion { margin: 0 !important; padding: 0 !important; width: 100% !important; max-width: none !important; }
main.gestion > section.hero { width: 100% !important; left: auto !important; margin: 0 !important; border: 0 !important; border-radius: 0 !important; }
main.gestion > section.hero .hero-photo { inset: 0 !important; }
</style>

<style is:global>
/* Nouvelle forme organique panoramique et arabesques dorées — section finale uniquement. */
.gestion .closing-grid{position:relative;isolation:isolate}
.gestion .closing-grid::after{content:"";position:absolute;z-index:0;pointer-events:none;right:-9%;top:15%;width:61%;height:78%;border:1.5px solid rgba(227,174,92,.8);border-radius:54% 46% 58% 42% / 48% 58% 42% 52%;transform:rotate(-10deg)}
.gestion .closing-grid>div{position:relative;z-index:1}
.gestion .closing-photo{z-index:2!important;width:100%!important;height:325px!important;min-height:0!important;border:2px solid #e0ad62!important;border-radius:48% 52% 57% 43% / 63% 44% 56% 37%!important;transform:rotate(-5deg)!important;overflow:hidden!important;box-shadow:0 22px 40px #00182766!important}
.gestion .closing-photo img{border-radius:0!important;transform:rotate(5deg) scale(1.16)!important;object-fit:cover!important}
.gestion .closing::after{content:"";position:absolute;right:-15%;bottom:-55%;width:55%;height:90%;border:1px solid rgba(221,165,81,.45);border-radius:50%;transform:rotate(-18deg);pointer-events:none}
@media(max-width:650px){.gestion .closing-photo{height:235px!important;transform:rotate(-3deg)!important}.gestion .closing-photo img{transform:rotate(3deg) scale(1.18)!important}.gestion .closing-grid::after{width:105%;right:-10%;top:55%;height:38%}}
</style>


<style is:global>
/* Maison & Monde — profondeur douce, cartes flottantes et apparitions desktop. */
.gestion { --mm-shadow: 0 15px 28px rgba(8,38,62,.12), 0 28px 58px rgba(8,38,62,.10); }
.gestion .extras-grid article,
.gestion .steps article,
.gestion .comparison figure,
.gestion .image-frame,
.gestion .benefits div { position:relative; }
.gestion .extras-grid article {
  box-shadow:var(--mm-shadow), 0 2px 5px rgba(8,38,62,.06);
  transition:transform .65s cubic-bezier(.22,1,.36,1), box-shadow .65s ease;
}
.gestion .steps article {
  background:rgba(255,255,255,.87);
  border:1px solid rgba(221,231,239,.82);
  border-radius:18px;
  padding:0 0 22px;
  box-shadow:0 12px 27px rgba(8,38,62,.10),0 22px 44px rgba(8,38,62,.06);
  transition:transform .65s cubic-bezier(.22,1,.36,1),box-shadow .65s ease;
}
