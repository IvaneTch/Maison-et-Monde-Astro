---
import SectionBand from '../../../components/SectionBand.astro';
import '../../../styles/conciergerie-gestion-complete.css';
import Layout from '../../../layouts/Layout.astro';
const prestations = [
  {
    num: '01',
    title: 'Ménage et préparation',
    desc: 'Nettoyage entre les séjours, mise en place du linge et vérification des détails avant chaque arrivée.',
    img: 'menage-preparation.webp',
    href: '/conciergerie/menage-preparation-logement/',
  },
  {
    num: '02',
    title: 'Accueil des voyageurs',
    desc: 'Arrivée en personne ou accès autonome, remise des consignes et coordination des départs selon votre organisation.',
    img: 'accueil-voyageurs.webp',
    href: '/conciergerie/accueil-voyageurs/',
  },
  {
    num: '03',
    title: 'Suivi et maintenance',
    desc: 'Contrôle visuel du logement, signalement des anomalies et coordination de petites interventions avec votre accord.',
    img: 'suivi-maintenance.webp',
    href: '/conciergerie/suivi-maintenance/',
  },
  {
    num: '04',
    title: 'Services complémentaires',
    desc: 'Réassort, entretien du linge et prestations particulières selon vos besoins et votre calendrier.',
    img: 'services-complementaires.webp',
    href: '/conciergerie/services-a-la-carte/',
  },
];
const etapes = [
  {
    n: '01',
    t: 'Nous échangeons',
    d: "Nous étudions votre logement, vos attentes et les modalités d'accueil.",
  },
  {
    n: '02',
    t: 'Nous définissons la formule',
    d: 'Nous précisons les missions couvertes par la gestion complète et celles facturées séparément.',
  },
  {
    n: '03',
    t: 'Nous organisons les séjours',
    d: 'Nous coordonnons les interventions prévues entre les arrivées et les départs.',
  },
  {
    n: '04',
    t: 'Vous gardez la maîtrise',
    d: 'Nous vous informons des points importants et validons toute prestation supplémentaire.',
  },
];
const questions = [
  {
    q: 'La gestion complète inclut-elle la gestion des annonces et des réservations ?',
    a: 'Notre offre porte sur la coordination des séjours et des interventions sur place. La création des annonces, l’optimisation des prix et la gestion commerciale des réservations ne sont pas incluses automatiquement : ces missions nécessitent un accord spécifique.',
  },
  {
    q: 'Puis-je choisir uniquement certaines prestations ?',
    a: 'Oui. Vous pouvez opter pour un accompagnement complet ou sélectionner des services à la carte.',
  },
  {
    q: 'Intervenez-vous pour plusieurs logements ?',
    a: 'Oui, nous étudions votre demande selon le nombre de logements, leur localisation et la fréquence des interventions.',
  },
  {
    q: 'Comment le tarif est-il calculé ?',
    a: 'Notre offre de lancement commence à 18 % TTC des revenus locatifs, selon une base de calcul précisée dans le devis. Le ménage, le linge, les consommables et les interventions ponctuelles sont facturés séparément. Le montant définitif dépend des missions confiées.',
  },
];
---

<Layout
  title="Gestion complète de location courte durée à Paris | Maison & Monde"
  description="Gestion complète de locations courte durée à Paris : ménage, accueil des voyageurs, suivi du logement et services à la carte avec Maison & Monde."
>
  <div class="gestion">
    <section class="hero">
      <div class="hero-photo" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <p class="eyebrow">MAISON & MONDE · CONCIERGERIE À PARIS</p>
        <h1>
          Gestion complète
          <br />
          <span>de votre logement</span>
        </h1>
        <p>
          Coordination des séjours, accueil des voyageurs et suivi du logement : un accompagnement global à
          partir de 18 % TTC des revenus locatifs, selon devis.
        </p>
        <div class="actions">
          <a class="button gold" href="/conciergerie/demande-de-devis/">
            Demander un devis personnalisé <span>→</span>
          </a>
          <a class="button ghost" href="#prestations">
            Découvrir notre accompagnement
          </a>
        </div>
      </div>
      <svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 35 C290 115 610 5 880 42 S1250 90 1440 32 L1440 90 H0Z" fill="white" />
        <path
          d="M0 35 C290 115 610 5 880 42 S1250 90 1440 32"
          fill="none"
          stroke="#d7a35c"
          stroke-width="2"
        />
      </svg>
    </section>
    <section class="section know-how decorated">
      <div class="circle left" aria-hidden="true"></div>
      <svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 320 C290 25 510 420 820 165 S1200 40 1500 270" />
      </svg>
      <div class="wrap split top-layer">
        <div>
          <p class="eyebrow">VOTRE PARTENAIRE SUR PLACE</p>
          <h2>
            Un seul interlocuteur, <em>plus de sérénité</em>
          </h2>
          <p>
            Vous louez un appartement à Paris ou en Île-de-France ? Notre gestion complète coordonne les
            opérations convenues autour des séjours : organisation des interventions, accueil et suivi du
            logement. Les prestations réalisées sur place, comme le ménage et le linge, sont facturées
            séparément.
          </p>
          <ul class="checks">
            <li>Coordination des prestations convenues</li>
            <li>Accueil physique ou arrivée autonome</li>
            <li>Suivi attentif du logement</li>
            <li>Services ajustables selon vos besoins</li>
          </ul>
        </div>
        <div class="image-frame">
          <img
            src="/images/conciergerie/salon-conciergerie.webp"
            alt="Appartement parisien préparé pour accueillir des voyageurs"
            loading="lazy"
            srcset="/images/conciergerie/salon-conciergerie-480.webp 480w, /images/conciergerie/salon-conciergerie-960.webp 960w, /images/conciergerie/salon-conciergerie.webp 1600w"
            sizes="(max-width: 780px) 100vw, 50vw"
            width="1600"
            height="595"
          />
        </div>
      </div>
    </section>
    <SectionBand theme="gestion" className="avantages-section" />

    <section class="section extras decorated" id="prestations">
      <div class="circle right" aria-hidden="true"></div>
      <svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 130 C280 380 470 20 800 220 S1230 330 1500 95" />
      </svg>
      <div class="wrap top-layer">
        <p class="eyebrow">UN ACCOMPAGNEMENT COMPLET</p>
        <h2>
          Quatre services, <em>une seule organisation</em>
        </h2>
        <p class="subtext">
          Ces quatre domaines peuvent être coordonnés dans notre gestion complète. Les interventions
          elles-mêmes sont chiffrées à part dans votre devis.
        </p>
        <div class="gestion-grid">
          {prestations.map((s) => (
            <article class="gestion-card">
              <img src={`/images/conciergerie/${s.img}`} alt={s.title} loading="lazy" />
              <div class="card-body">
                <span class="card-num">{s.num} / CONCIERGERIE</span>
                <h3>{s.title}</h3>
                <p>{s.desc}</p>
                <a href={s.href}>Découvrir ce service →</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="section process decorated">
      <div class="circle left" aria-hidden="true"></div>
      <svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 300 C250 45 550 410 900 150 S1200 40 1500 245" />
      </svg>
      <div class="wrap top-layer">
        <p class="eyebrow">SIMPLE ET TRANSPARENT</p>
        <h2>
          Comment se déroule <em>notre accompagnement ?</em>
        </h2>
        <div class="steps">
          {etapes.map((e) => (
            <article>
              <div class="step-number">{e.n}</div>
              <h3>{e.t}</h3>
              <p>{e.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="section linen decorated">
      <div class="circle right" aria-hidden="true"></div>
      <svg class="ribbon" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-60 85 C320 360 510 30 830 190 S1170 355 1500 120" />
      </svg>
      <div class="wrap split top-layer">
        <div class="image-frame">
          <img
            src="/images/conciergerie/attention-details.webp"
            alt="Préparation soignée d'un logement entre deux séjours"
            loading="lazy"
            srcset="/images/conciergerie/attention-details-480.webp 480w, /images/conciergerie/attention-details-960.webp 960w, /images/conciergerie/attention-details.webp 1600w"
            sizes="(max-width: 780px) 100vw, 50vw"
            width="1600"
            height="900"
          />
        </div>
        <div>
          <p class="eyebrow">VOTRE LOGEMENT, VOS RÈGLES</p>
          <h2>
            Une gestion adaptée <em>à vos priorités</em>
          </h2>
          <p>
            Notre offre de lancement débute à 18 % TTC des revenus locatifs, sur une base précisée au devis.
            Cette commission couvre la coordination convenue ; ménage, linge, consommables et interventions
            ponctuelles sont chiffrés séparément. Nous demandons votre accord avant toute dépense
            supplémentaire.
          </p>
          <ul class="checks">
            <li>Commission de gestion : à partir de 18 % TTC</li>
            <li>Organisation selon les réservations</li>
            <li>Communication claire</li>
            <li>Prestations sur place facturées selon devis</li>
          </ul>
        </div>
      </div>
    </section>
    <section class="section faq decorated">
      <div class="wrap top-layer">
        <p class="eyebrow">QUESTIONS FRÉQUENTES</p>
        <h2>
          Tout savoir sur <em>la gestion complète</em>
        </h2>
        <div class="faq-list">
          {questions.map((item) => (
            <details>
              <summary>
                {item.q}
                <span aria-hidden="true">+</span>
              </summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
    <section class="closing" id="contact-conciergerie">
      <svg class="closing-wave" viewBox="0 0 1440 75" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 25 C250 -30 500 75 750 30 S1190 20 1440 5 L1440 0 H0Z" fill="white" />
        <path
          d="M0 25 C250 -30 500 75 750 30 S1190 20 1440 5"
          stroke="#d7a35c"
          fill="none"
          stroke-width="2"
        />
      </svg>
      <div class="wrap closing-grid">
        <div>
          <p class="eyebrow">UN ACCOMPAGNEMENT SUR MESURE</p>
          <h2>
            Confiez-nous <em>l'organisation de vos séjours</em>
          </h2>
          <p>
            Profitez de notre offre de lancement à partir de 18 % TTC pour la coordination de votre location.
            Le devis détaille la base de calcul, les missions incluses et les frais séparés de ménage, de
            linge et d’interventions.
          </p>
          <a class="button gold" href="/conciergerie/tarifs-formules/">
            Consulter les tarifs et formules <span>→</span>
          </a>
        </div>
        <div class="closing-photo">
          <img
            src="/images/conciergerie/salon-conciergerie.webp"
            alt="Intérieur parisien accueillant"
            loading="lazy"
            srcset="/images/conciergerie/salon-conciergerie-480.webp 480w, /images/conciergerie/salon-conciergerie-960.webp 960w, /images/conciergerie/salon-conciergerie.webp 1600w"
            sizes="(max-width: 780px) 100vw, 50vw"
            width="1600"
            height="595"
          />
        </div>
      </div>
    </section>
  </div>
</Layout>
