---
import '../../styles/conciergerie.css';
import Layout from '../../layouts/Layout.astro';

const titre = 'Conciergerie à Paris | Maison & Monde';
---

<Layout
  title={titre}
  description="Maison & Monde vous accompagne dans la préparation de votre logement, l'accueil des voyageurs et les services de conciergerie à Paris et en Île-de-France."
>
  <div>
    <section class="conciergerie-hero">
      <div class="hero-image" aria-hidden="true"></div>

      <div class="hero-overlay"></div>

      <div class="hero-content">
        <span class="hero-label">MAISON & MONDE · CONCIERGERIE À PARIS</span>

        <h1>
          Votre logement,
          <br />
          <span>notre attention.</span>
        </h1>

        <p>
          De la préparation de votre logement à l'accueil des voyageurs, Maison & Monde vous accompagne dans
          vos locations de courte durée à Paris et en Île-de-France.
        </p>

        <p>Choisissez un accompagnement complet ou uniquement les prestations dont vous avez besoin.</p>

        <div class="hero-buttons">
          <a href="/conciergerie/gestion-complete/" class="btn-primary">
            Découvrir la gestion complète
            <span aria-hidden="true">→</span>
          </a>

          <a href="/conciergerie/services-a-la-carte/" class="btn-secondary">
            Services à la carte
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <svg class="hero-wave" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 45 C300 110 550 10 850 55 S1250 100 1440 40 L1440 100 L0 100 Z" fill="#ffffff" />
        <path
          d="M0 45 C300 110 550 10 850 55 S1250 100 1440 40"
          fill="none"
          stroke="#e9a34c"
          stroke-width="2"
        />
      </svg>
    </section>

    <section class="cc-services" id="nos-services">
      <svg
        class="cc-gold-ribbon"
        viewBox="0 0 1440 330"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M -80 130 C 220 -20, 330 290, 640 135 S 1040 15, 1530 185" />
      </svg>
      <div class="cc-wrap cc-services-content">
        <p class="cc-eyebrow">UN ACCOMPAGNEMENT SUR MESURE</p>
        <h2>
          Nos services de <em>conciergerie</em>
        </h2>
        <p class="cc-intro">
          Des prestations adaptées à votre logement et à votre façon de recevoir, à Paris et en Île-de-France.
        </p>
        <div class="cc-grid">
          <article class="cc-card">
            <div class="cc-card-art art-clean">
              <img
                src="/images/conciergerie/menage-preparation.webp"
                alt=""
                loading="lazy"
                srcset="/images/conciergerie/menage-preparation-480.webp 480w, /images/conciergerie/menage-preparation-960.webp 960w, /images/conciergerie/menage-preparation.webp 1536w"
                sizes="(max-width: 780px) 100vw, 50vw"
                width="1536"
                height="1024"
              />
            </div>
            <div class="cc-card-body">
              <span class="cc-number">01 / PRÉPARATION</span>
              <h3>Ménage et préparation</h3>
              <p>Nettoyage entre les séjours, mise en place du linge et attention portée aux détails.</p>
              <a href="/conciergerie/menage-preparation-logement/">
                Découvrir ce service <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
          <article class="cc-card">
            <div class="cc-card-art art-guests">
              <img
                src="/images/conciergerie/accueil-voyageurs.webp"
                alt=""
                loading="lazy"
                srcset="/images/conciergerie/accueil-voyageurs-480.webp 480w, /images/conciergerie/accueil-voyageurs-960.webp 960w, /images/conciergerie/accueil-voyageurs.webp 1536w"
                sizes="(max-width: 780px) 100vw, 50vw"
                width="1536"
                height="1024"
              />
            </div>
            <div class="cc-card-body">
              <span class="cc-number">02 / VOYAGEURS</span>
              <h3>Accueil et gestion des voyageurs</h3>
              <p>Organisation des arrivées et départs, remise des clés et assistance selon vos besoins.</p>
              <a href="/conciergerie/accueil-voyageurs/">
                Découvrir ce service <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
          <article class="cc-card">
            <div class="cc-card-art art-care">
              <img
                src="/images/conciergerie/suivi-maintenance.webp"
                alt=""
                loading="lazy"
                srcset="/images/conciergerie/suivi-maintenance-480.webp 480w, /images/conciergerie/suivi-maintenance-960.webp 960w, /images/conciergerie/suivi-maintenance.webp 1536w"
                sizes="(max-width: 780px) 100vw, 50vw"
                width="1536"
                height="1024"
              />
            </div>
            <div class="cc-card-body">
              <span class="cc-number">03 / SUIVI</span>
              <h3>Suivi et maintenance</h3>
              <p>Contrôle du logement, signalement des anomalies et coordination de petites interventions.</p>
              <a href="/conciergerie/suivi-maintenance/">
                Découvrir ce service <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
          <article class="cc-card">
            <div class="cc-card-art art-more">
              <img
                src="/images/conciergerie/services-complementaires.webp"
                alt=""
                loading="lazy"
                srcset="/images/conciergerie/services-complementaires-480.webp 480w, /images/conciergerie/services-complementaires-960.webp 960w, /images/conciergerie/services-complementaires.webp 1536w"
                sizes="(max-width: 780px) 100vw, 50vw"
                width="1536"
                height="1024"
              />
            </div>
            <div class="cc-card-body">
              <span class="cc-number">04 / À LA CARTE</span>
              <h3>Services complémentaires</h3>
              <p>Blanchisserie, courses, réassort et demandes spécifiques pour chaque séjour.</p>
              <a href="/conciergerie/services-a-la-carte/">
                Découvrir ce service <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>
    <section class="cc-offers" id="nos-formules">
      <svg
        class="cc-gold-ribbon"
        viewBox="0 0 1440 330"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M -80 190 C 250 35, 340 290, 720 155 S 1150 65, 1530 230" />
      </svg>
      <div
        class="cc-panorama"
        role="img"
        aria-label="Appartement parisien lumineux préparé pour accueillir des voyageurs"
      ></div>
      <div class="cc-wrap">
        <p class="cc-eyebrow">DEUX FAÇONS DE VOUS ACCOMPAGNER</p>
        <h2>
          Votre logement, <em>vos choix.</em>
        </h2>
        <div class="cc-offer-grid">
          <article class="cc-offer cc-offer-dark">
            <span class="cc-offer-tag">ACCOMPAGNEMENT GLOBAL</span>
            <h3>Conciergerie complète</h3>
            <p>
              Une solution coordonnée pour la préparation de votre logement, le suivi des séjours et
              l'accompagnement des voyageurs.
            </p>
            <ul>
              <li>Préparation et ménage</li>
              <li>Accueil et assistance</li>
              <li>Suivi du logement</li>
              <li>Services adaptés à votre activité</li>
            </ul>
            <a href="/conciergerie/gestion-complete/">
              Découvrir les formules <span aria-hidden="true">→</span>
            </a>
          </article>
          <article class="cc-offer cc-offer-light">
            <span class="cc-offer-tag">LIBERTÉ ET FLEXIBILITÉ</span>
            <h3>Prestations à la carte</h3>
            <p>
              Vous gérez votre location ? Confiez-nous seulement les missions dont vous avez besoin,
              ponctuellement ou régulièrement.
            </p>
            <ul>
              <li>Ménage entre deux réservations</li>
              <li>Gestion du linge</li>
              <li>Remise de clés</li>
              <li>Réassort et vérifications</li>
            </ul>
            <a href="/conciergerie/services-a-la-carte/">
              Découvrir les formules <span aria-hidden="true">→</span>
            </a>
          </article>
        </div>
      </div>
    </section>
    <section class="cc-trust">
      <svg
        class="cc-gold-ribbon"
        viewBox="0 0 1440 330"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M -80 230 C 190 70, 430 365, 720 175 S 1130 55, 1530 215" />
      </svg>
      <div class="cc-wrap cc-trust-content">
        <p class="cc-eyebrow">L'ESPRIT MAISON & MONDE</p>
        <h2>
          Une attention à <em>chaque détail.</em>
        </h2>
        <div class="cc-trust-layout">
          <div
            class="cc-trust-photo"
            role="img"
            aria-label="Préparation soignée d’une chambre pour les voyageurs"
          ></div>
          <div class="cc-trust-grid">
            <div>
              <strong>01</strong>
              <h3>Un interlocuteur dédié</h3>
              <p>Des échanges clairs et un suivi adapté à vos attentes.</p>
            </div>
            <div>
              <strong>02</strong>
              <h3>Des prestations soignées</h3>
              <p>Une préparation attentive pour accueillir vos voyageurs.</p>
            </div>
            <div>
              <strong>03</strong>
              <h3>Une offre flexible</h3>
              <p>Une intervention ponctuelle ou un accompagnement plus large.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="cc-faq">
      <svg
        class="cc-gold-ribbon"
        viewBox="0 0 1440 330"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M -80 110 C 230 265, 440 10, 710 155 S 1140 290, 1530 100" />
      </svg>
      <div class="cc-wrap cc-faq-layout">
        <div>
          <p class="cc-eyebrow">QUESTIONS FRÉQUENTES</p>
          <h2>
            Vous avez des <em>questions ?</em>
          </h2>
          <p>Voici quelques réponses pour préparer votre projet de conciergerie.</p>
        </div>
        <div class="cc-faq-items">
          <details>
            <summary>Proposez-vous une gestion complète et des prestations ponctuelles ?</summary>
            <p>
              Oui. Nous adaptons notre accompagnement à votre logement : gestion complète ou services choisis
              à la carte.
            </p>
          </details>
          <details>
            <summary>Intervenez-vous dans toute l'Île-de-France ?</summary>
            <p>
              Nous intervenons à Paris et en Île-de-France, sous réserve de disponibilité selon la commune et
              la prestation.
            </p>
          </details>
          <details>
            <summary>Comment sont calculés les tarifs ?</summary>
            <p>
              Nous établissons un devis selon le logement, la fréquence des interventions et les services
              demandés.
            </p>
          </details>
          <details>
            <summary>Puis-je choisir uniquement le ménage et le linge ?</summary>
            <p>Oui, vous pouvez sélectionner uniquement les prestations utiles à votre activité.</p>
          </details>
        </div>
      </div>
    </section>
    <section class="cc-cta">
      <svg
        class="cc-gold-ribbon"
        viewBox="0 0 1440 330"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M -80 170 C 280 -15, 510 300, 790 120 S 1180 5, 1530 170" />
      </svg>
      <div class="cc-cta-photo" aria-hidden="true"></div>
      <div class="cc-wrap cc-cta-inner">
        <div>
          <p class="cc-eyebrow">PARLONS DE VOTRE LOGEMENT</p>
          <h2>
            Confiez-nous votre bien <em>en toute sérénité.</em>
          </h2>
          <p>Décrivez-nous vos besoins : nous construirons une proposition adaptée, sans tarif imposé.</p>
        </div>
        <a href="/conciergerie/demande-de-devis/" id="cc-quote-link">
          Demander un devis personnalisé <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Effet d'apparition discret, réservé aux ordinateurs ; aucun défilement animé sur mobile.
  const motionQuery = window.matchMedia('(min-width: 651px) and (prefers-reduced-motion: no-preference)');
  const selectors = '.cc-card, .cc-offer, .cc-trust-photo, .cc-trust-grid > div, .cc-faq details';
  let revealObserver: IntersectionObserver | undefined;
  function setupMaisonMondeReveal() {
    revealObserver?.disconnect();
    const items = [...document.querySelectorAll<HTMLElement>(selectors)];
    items.forEach((item) => item.classList.remove('mm-reveal-pending', 'mm-reveal-visible'));
    if (!motionQuery.matches || !('IntersectionObserver' in window)) return;
    revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('mm-reveal-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -20px 0px' },
    );
    items.forEach((item, index) => {
      // Les éléments déjà visibles restent visibles immédiatement : aucun flash au chargement.
      const visibleNow = item.getBoundingClientRect().top < window.innerHeight * 0.95;
      if (visibleNow) return;
      item.classList.add('mm-reveal-pending');
      item.style.transitionDelay = `${(index % 4) * 65}ms`;
      revealObserver!.observe(item);
    });
  }
  setupMaisonMondeReveal();
  motionQuery.addEventListener('change', setupMaisonMondeReveal);
</script>
