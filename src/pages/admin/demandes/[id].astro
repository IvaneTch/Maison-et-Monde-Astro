---
import '../../../styles/admin-demande-details.css';
import mysql from 'mysql2/promise';
import { createHash } from 'node:crypto';
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const token = Astro.cookies.get('mm_admin_session')?.value;
if (!token) return Astro.redirect('/admin/connexion/');
const id = Number(Astro.params.id);
if (!Number.isSafeInteger(id) || id < 1) return new Response('Demande introuvable', { status: 404 });

let connection: mysql.Connection | undefined;
let demande: Record<string, unknown> | null = null;
try {
  connection = await mysql.createConnection({
    host: process.env.DB_HOST || import.meta.env.DB_HOST || '127.0.0.1',
    port: Number(process.env.DB_PORT || import.meta.env.DB_PORT || 8889),
    user: process.env.DB_USER || import.meta.env.DB_USER,
    password: process.env.DB_PASSWORD || import.meta.env.DB_PASSWORD,
    database: process.env.DB_NAME || import.meta.env.DB_NAME,
  });
  const hash = createHash('sha256').update(token).digest('hex');
  const [sessions] = await connection.execute<mysql.RowDataPacket[]>(
    `SELECT s.id FROM sessions_admin s JOIN administrateurs a ON a.id=s.administrateur_id
     WHERE s.token_hash=? AND s.date_expiration>NOW() AND a.actif=1 LIMIT 1`,
    [hash],
  );
  if (!sessions.length) {
    Astro.cookies.delete('mm_admin_session', { path: '/' });
    return Astro.redirect('/admin/connexion/');
  }
  const [rows] = await connection.execute<mysql.RowDataPacket[]>(
    'SELECT * FROM demandes_devis WHERE id=? LIMIT 1',
    [id],
  );
  if (!rows.length) return new Response('Demande introuvable', { status: 404 });
  demande = rows[0] as Record<string, unknown>;
} finally {
  if (connection) await connection.end();
}

const d = demande!;
const estConciergerie = d.prestation_souhaitee === 'Conciergerie';
const estProfessionnel = d.prestation_souhaitee === 'Professionnel';
let reponsesConciergerie: Record<string, string> = {};
if (estConciergerie) {
  try {
    reponsesConciergerie = JSON.parse(String(d.commentaires ?? '{}')).conciergerie ?? {};
  } catch {}
}
let reponsesProfessionnel: Record<string, string> = {};
if (estProfessionnel) {
  try {
    reponsesProfessionnel = JSON.parse(String(d.commentaires ?? '{}')).professionnel ?? {};
  } catch {}
}
const labels: Record<string, string> = {
  reference_devis: 'Référence',
  type_devis: 'Type de devis',
  nom: 'Nom',
  prenom: 'Prénom',
  email: 'Adresse e-mail',
  telephone: 'Téléphone',
  adresse: 'Adresse de l’intervention',
  code_postal: 'Code postal',
  ville: 'Ville',
  type_logement: 'Type de logement',
  surface_m2: 'Surface (m²)',
  nombre_pieces: 'Nombre de pièces',
  nombre_salles_bain: 'Salles de bain',
  animaux_presents: 'Animaux présents',
  prestations: 'Prestations souhaitées',
  frequence: 'Fréquence souhaitée',
  duree_souhaitee: 'Durée souhaitée',
  disponibilites: 'Disponibilités',
  commentaires: 'Commentaires et précisions',
  statut: 'Statut',
  date_creation: 'Date de réception',
  date_modification: 'Dernière modification',
};
const ordre = [
  'reference_devis',
  'type_devis',
  'date_creation',
  'statut',
  'prenom',
  'nom',
  'email',
  'telephone',
  'adresse',
  'code_postal',
  'ville',
  'type_logement',
  'surface_m2',
  'nombre_pieces',
  'nombre_salles_bain',
  'animaux_presents',
  'prestations',
  'frequence',
  'duree_souhaitee',
  'disponibilites',
  'commentaires',
  'date_modification',
];
// Les renseignements complémentaires sont actuellement stockés dans commentaires.
// Les anciennes demandes restent compatibles : toute ligne non reconnue reste visible.
const notesConnues: Record<string, string> = {
  'Type de prestation': 'Type de prestation',
  Animaux: 'Types d’animaux',
  'Précisions services': 'Précisions sur les prestations',
  'Date de début': 'Date de début souhaitée',
  'Adresse de prestation': 'Adresse de prestation',
  'Complément adresse': 'Complément d’adresse',
  Message: 'Message du client',
  'Avance immédiate': 'Informations sur l’avance immédiate',
  Flexibilité: 'Horaires flexibles',
  Horaires: 'Horaires précis',
};
const notes: Record<string, string> = {};
const notesLibres: string[] = [];
for (const ligne of String(estConciergerie ? '' : (d.commentaires ?? '')).split(/\r?\n/)) {
  const position = ligne.indexOf(' : ');
  const cle = position >= 0 ? ligne.slice(0, position).trim() : '';
  if (cle && cle in notesConnues) {
    const valeur = ligne.slice(position + 3).trim();
    if (valeur) notes[cle] = valeur;
  } else if (ligne.trim()) {
    notesLibres.push(ligne);
  }
}
const groupes = [
  { titre: 'Demande', champs: ['reference_devis', 'type_devis', 'date_creation', 'statut'] },
  {
    titre: 'Coordonnées du client',
    champs: ['prenom', 'nom', 'email', 'telephone', 'adresse', 'code_postal', 'ville'],
    notes: ['Complément adresse'],
  },
  {
    titre: 'Logement',
    champs: ['type_logement', 'surface_m2', 'nombre_pieces', 'nombre_salles_bain', 'animaux_presents'],
    notes: ['Animaux'],
  },
  {
    titre: 'Prestations demandées',
    champs: ['prestations', 'frequence', 'duree_souhaitee'],
    notes: ['Type de prestation', 'Date de début', 'Précisions services'],
  },
  { titre: 'Disponibilités', champs: ['disponibilites'], notes: ['Horaires', 'Flexibilité'] },
  { titre: 'Informations complémentaires', champs: [], notes: ['Message', 'Avance immédiate'] },
];
const format = (value: unknown): string => {
  if (value === null || value === undefined || value === '') return 'Non renseigné';
  if (value instanceof Date)
    return new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeStyle: 'short' }).format(value);
  if (typeof value === 'boolean') return value ? 'Oui' : 'Non';
  if (Array.isArray(value))
    return (
      value.map((x) => (typeof x === 'object' && x !== null ? JSON.stringify(x) : String(x))).join(' • ') ||
      'Non renseigné'
    );
  if (typeof value === 'object')
    return (
      Object.entries(value)
        .map(([k, v]) => `${k} : ${String(v)}`)
        .join(' • ') || 'Non renseigné'
    );
  if (typeof value === 'string' && (value.startsWith('[') || value.startsWith('{'))) {
    try {
      const parsed = JSON.parse(value);
      if (Array.isArray(parsed))
        return (
          parsed.map((x) => (typeof x === 'object' ? JSON.stringify(x) : String(x))).join(' • ') ||
          'Non renseigné'
        );
      if (typeof parsed === 'object' && parsed)
        return Object.entries(parsed)
          .map(([k, v]) => `${k} : ${String(v)}`)
          .join(' • ');
    } catch {}
  }
  return String(value);
};
// Présentation des données : aucune modification des valeurs stockées dans MySQL.
const afficherChamp = (cle: string, valeur: unknown): string => {
  if (valeur === null || valeur === undefined || valeur === '') return 'Non renseigné';
  if (cle === 'surface_m2') {
    const nombre = Number(valeur);
    return Number.isFinite(nombre)
      ? `${new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 2 }).format(nombre)} m²`
      : format(valeur);
  }
  if (cle === 'type_devis' && estConciergerie) return 'Conciergerie';
  if (cle === 'type_devis' && estProfessionnel) return 'Professionnel';
  if (cle === 'type_devis') {
    const noms: Record<string, string> = { simple: 'Simple', detaille: 'Détaillé', détaillé: 'Détaillé' };
    return noms[String(valeur).toLowerCase()] ?? format(valeur);
  }
  if (cle === 'prestation_souhaitee') {
    const noms: Record<string, string> = {
      'grand-menage': 'Grand ménage',
      'menage-regulier': 'Ménage régulier',
      'menage-ponctuel': 'Ménage ponctuel',
      vitres: 'Nettoyage de vitres',
      repassage: 'Repassage',
    };
    return noms[String(valeur).toLowerCase()] ?? format(valeur);
  }
  if (cle === 'frequence') {
    const noms: Record<string, string> = {
      reguliere: 'Régulière',
      reguliere_hebdomadaire: 'Régulière',
      ponctuelle: 'Ponctuelle',
      'chaque-semaine': 'Chaque semaine',
    };
    return noms[String(valeur).toLowerCase()] ?? format(valeur);
  }
  return format(valeur);
};
// Date issue des notes du formulaire (AAAA-MM-JJ) : affichage français sans décalage horaire.
const afficherNote = (cle: string, valeur: string): string => {
  if (cle !== 'Date de début') return valeur;
  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(valeur.trim());
  if (!match) return valeur;
  const annee = Number(match[1]);
  const mois = Number(match[2]);
  const jour = Number(match[3]);
  const date = new Date(Date.UTC(annee, mois - 1, jour));
  if (date.getUTCFullYear() !== annee || date.getUTCMonth() !== mois - 1 || date.getUTCDate() !== jour)
    return valeur;
  const texte = new Intl.DateTimeFormat('fr-FR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(date);
  return jour === 1 ? texte.replace(/^1 /, '1er ') : texte;
};
const statusLabels: Record<string, string> = {
  nouvelle: 'Nouvelle',
  en_cours: 'En cours',
  devis_envoye: 'Devis envoyé',
  acceptee: 'Acceptée',
  refusee: 'Refusée',
};
const status = String(d.statut || 'nouvelle');
const ref = String(d.reference_devis || `#${id}`);
const autres = Object.keys(d).filter(
  (k) => !ordre.includes(k) && k !== 'id' && k !== 'prestation_souhaitee' && k !== 'date_suppression',
);
---

<html lang="fr" data-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{ref} | Maison & Monde</title>
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem('mm-admin-theme') || 'auto';
      } catch {}
    </script>

  </head>
  <body>
    <header class="top">
      <div class="brand">
        MAISON <span>&amp;</span> MONDE
      </div>
      <a href="/admin/">← Tableau de bord</a>
    </header>
    <main>
      <a class="back" href="/admin/#demandes">
        ← Retour aux demandes de devis
      </a>
      <div class="intro">
        <div class="eyebrow">GESTION DES CLIENTS · FICHE DÉTAILLÉE</div>
        <h1>Devis {estConciergerie ? 'Conciergerie' : 'Ménage'}</h1>
        <p>
          <strong>Référence : {ref}</strong>
        </p>
        <span class="badge">{statusLabels[status] || status}</span>
        <p>Informations transmises par le formulaire de devis Maison &amp; Monde.</p>
      </div>
      <section class="card gestion">
        <h2>Gérer cette demande</h2>
        <form method="POST" action="/api/admin/gerer-demande" class="statut-form">
          <input type="hidden" name="id" value={id} />
          <input type="hidden" name="action" value="statut" />
          <label for="nouveau-statut">Statut de la demande</label>
          <select id="nouveau-statut" name="statut">
            {Object.entries(statusLabels).map(([valeur, nom]) => (
              <option value={valeur} selected={status === valeur}>
                {nom}
              </option>
            ))}
          </select>
          <button type="submit" class="bouton-or mm-button">
            Enregistrer le statut
          </button>
        </form>
        <form method="POST" action="/api/admin/gerer-demande" class="suppression-form" id="form-corbeille">
          <input type="hidden" name="id" value={id} />
          <input type="hidden" name="action" value="supprimer" />
          <button type="submit" class="bouton-danger mm-button mm-button--danger">
            🗑 Placer dans la corbeille
          </button>
        </form>
        <p class="gestion-note">La suppression est réversible depuis la corbeille du tableau de bord.</p>
      </section>
      <dialog
        id="confirmation-corbeille"
        class="dialog-corbeille"
        aria-labelledby="titre-confirmation-corbeille"
        aria-describedby="texte-confirmation-corbeille"
      >
        <div class="dialog-interieur">
          <div class="dialog-icone" aria-hidden="true">
            🗑️
          </div>
          <h2 id="titre-confirmation-corbeille">Placer dans la corbeille ?</h2>
          <p id="texte-confirmation-corbeille">
            La demande <strong>{ref}</strong> sera retirée du tableau de bord. Vous pourrez la restaurer à
            tout moment depuis la corbeille.
          </p>
          <div class="dialog-actions">
            <button type="button" class="dialog-annuler mm-button mm-button--navy" id="annuler-corbeille">
              Annuler
            </button>
            <button type="button" class="dialog-confirmer mm-button mm-button--danger" id="confirmer-corbeille">
              Placer dans la corbeille
            </button>
          </div>
        </div>
      </dialog>
      <div class="cards">
        {estConciergerie && (
          <section class="card">
            <h2>Détails de la conciergerie</h2>
            <dl class="fields">
              {Object.entries(reponsesConciergerie)
                .filter(([, v]) => v)
                .map(([k, v]) => (
                  <div class="field full">
                    <dt>{k}</dt>
                    <dd class="preserve-whitespace">{v}</dd>
                  </div>
                ))}
            </dl>
          </section>
        )}
        {estProfessionnel && (
          <section class="card">
            <h2>Informations professionnelles</h2>
            <dl class="fields">
              {[
                ['Entreprise', reponsesProfessionnel.entreprise],
                ['Type d’établissement', reponsesProfessionnel.type_site],
                ['Service demandé', reponsesProfessionnel.service],
                ['Fréquence', reponsesProfessionnel.frequence],
                ['Message', reponsesProfessionnel.message],
              ]
                .filter(([, value]) => value)
                .map(([label, value]) => (
                  <div class="field full">
                    <dt>{label}</dt>
                  <dd class="preserve-whitespace">{value}</dd>
                  </div>
                ))}
            </dl>
          </section>
        )}
        {groupes.map((g) => (
          <section class="card">
            <h2>{g.titre}</h2>
            <dl class="fields">
              {g.champs
                .filter(
                  (k) =>
                    k in d &&
                    !(
                      estConciergerie &&
                      ['nombre_pieces', 'animaux_presents', 'duree_souhaitee', 'disponibilites'].includes(k)
                    ),
                )
                .map((k) => (
                  <div class:list={['field', ['prestations', 'disponibilites'].includes(k) && 'full']}>
                    <dt>{labels[k]}</dt>
                    <dd>
                      {k === 'email' && d[k] ? (
                        <a href={`mailto:${String(d[k])}`}>{String(d[k])}</a>
                      ) : k === 'telephone' && d[k] ? (
                        <a href={`tel:${String(d[k]).replace(/[^+\d]/g, '')}`}>{String(d[k])}</a>
                      ) : k === 'statut' ? (
                        statusLabels[status] || status
                      ) : k === 'animaux_presents' ? (
                        d[k] === null || d[k] === undefined ? (
                          'Non renseigné'
                        ) : d[k] ? (
                          'Oui'
                        ) : (
                          'Non'
                        )
                      ) : (
                        afficherChamp(k, d[k])
                      )}
                    </dd>
                  </div>
                ))}
              {g.notes
                ?.filter((k) => k in notes)
                .map((k) => (
                  <div class:list={['field', ['Précisions services', 'Message'].includes(k) && 'full']}>
                    <dt>{notesConnues[k]}</dt>
                    <dd>{afficherNote(k, notes[k])}</dd>
                  </div>
                ))}
              {g.titre === 'Prestations demandées' && d.prestation_souhaitee && (
                <div class="field">
                  <dt>Catégorie sélectionnée</dt>
                  <dd>{afficherChamp('prestation_souhaitee', d.prestation_souhaitee)}</dd>
                </div>
              )}
              {g.titre === 'Informations complémentaires' && notesLibres.length > 0 && (
                <div class="field full">
                  <dt>Autres précisions</dt>
                  <dd>{notesLibres.join('\n')}</dd>
                </div>
              )}
            </dl>
          </section>
        ))}
      </div>
      {autres.length > 0 && (
        <section class="card extra">
          <h2>Données techniques complémentaires</h2>
          <dl class="fields">
            {autres.map((k) => (
              <div class="field">
                <dt>{k.replace(/_/g, ' ')}</dt>
                <dd>{format(d[k])}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}
      <p class="footnote">
        Consultation privée : les informations de cette fiche ne sont accessibles qu'aux administrateurs
        connectés.
      </p>
    </main>
    <script>
      const formulaire = document.querySelector<HTMLFormElement>('#form-corbeille');
      const dialogue = document.querySelector<HTMLDialogElement>('#confirmation-corbeille');
      const annuler = document.querySelector<HTMLButtonElement>('#annuler-corbeille');
      const confirmer = document.querySelector<HTMLButtonElement>('#confirmer-corbeille');
      let envoiConfirme = false;

      formulaire?.addEventListener('submit', (evenement) => {
        if (envoiConfirme) return;
        evenement.preventDefault();
        if (dialogue?.showModal) dialogue.showModal();
      });
      annuler?.addEventListener('click', () => dialogue?.close());
      confirmer?.addEventListener('click', () => {
        if (!formulaire || envoiConfirme) return;
        envoiConfirme = true;
        confirmer.disabled = true;
        dialogue?.close();
        formulaire.requestSubmit();
      });
    </script>
  </body>
</html>
