                            </strong>
                            {liste.categorie === 'professionnel' &&
                              infosProfessionnel(demande.commentaires).entreprise && (
                                <small>{infosProfessionnel(demande.commentaires).entreprise}</small>
                              )}
                            <small>{demande.email || '—'}</small>
                          </td>

                          <td>{demande.ville || '—'}</td>
                          <td>{demande.telephone || '—'}</td>
                          <td>
                            {liste.categorie === 'conciergerie'
                              ? accompagnementConciergerie(demande.commentaires)
                              : liste.categorie === 'professionnel'
                                ? [
                                    infosProfessionnel(demande.commentaires).site,
                                    infosProfessionnel(demande.commentaires).service,
                                  ]
                                    .filter(Boolean)
                                    .join(' · ') || 'Besoin professionnel'
                                : demande.prestation_souhaitee || 'Ménage'}
                            <small>{demande.frequence || '—'}</small>
                          </td>

                          <td>
                            <span class={`badge badge-${demande.statut || 'inconnu'}`}>
                              {nomsStatuts[demande.statut || ''] || demande.statut || 'Non défini'}
                            </span>
                          </td>
                          <td>
                            <a
                              class="row-action"
                              href={`/admin/demandes/${demande.id}/`}
                              title="Voir la demande"
                              aria-label={`Voir la demande ${demande.reference_devis || demande.id}`}
                            >
                              →
                            </a>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <p data-aucun-resultat class="empty" hidden>
                  Aucune demande ne correspond à votre recherche.
                </p>
                {liste.demandes.length === 0 && <p class="empty">Aucune demande de devis enregistrée.</p>}
                <div class="panel-foot">
                  <span data-compteur-resultats>{liste.demandes.length} demande(s) affichée(s)</span>
                  <span>Maison & Monde · Suivi des devis</span>
                </div>
              </section>
            ))}
          </div>
          <section class="analytics" id="statistiques">
            <article class="panel graph">
              <div class="panel-head">
                <div class="section-title">
                  <span class="section-icon">
                    <svg
                      class="mm-icon"
                      viewBox="0 0 24 24"
                      width="21"
                      height="21"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M3 3v18h18" />
                      <path d="m7 16 4-5 3 3 6-8" />
                    </svg>
                  </span>
                  <div>
                    <h2>Évolution des demandes</h2>
                    <p>Les 7 derniers jours</p>
                  </div>
                </div>
              </div>
              <div class="graph-area">
                <svg
                  viewBox="0 0 480 190"
                  role="img"
                  aria-label="Graphique des demandes des sept derniers jours"
                  preserveAspectRatio="none"
                >
                  <defs>
                    <linearGradient id="areaFill" x1="0" x2="0" y1="0" y2="1">
                      <stop offset="0" stop-color="#d5a54c" stop-opacity=".3" />
                      <stop offset="1" stop-color="#d5a54c" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <path d="M30 43H450 M30 80H450 M30 118H450 M30 155H450" class="gridlines" />
                  <polygon points={`30,155 ${points} 450,155`} fill="url(#areaFill)" />
                  <polyline
                    points={points}
                    fill="none"
                    stroke="#d5a54c"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  {jours.map((j, i) => (
                    <circle
                      cx={30 + i * 70}
                      cy={155 - (j.nombre / maximum) * 112}
                      r="4"
                      fill="#d5a54c"
                      stroke="var(--card)"
                      stroke-width="2"
                    />
                  ))}
                </svg>
                <div class="days">
                  {jours.map((j) => (
                    <span>{j.label}</span>
                  ))}
                </div>
              </div>
              <div class="graph-summary">
                <div>
                  <strong>{jours.reduce((a, j) => a + j.nombre, 0)}</strong>
                  <small>Demandes sur 7 jours</small>
                </div>
                <div>
                  <strong>{total}</strong>
                  <small>Demandes affichées</small>
                </div>
              </div>
            </article>
            <article class="panel distribution">
              <div class="panel-head">
                <div class="section-title">
                  <span class="section-icon">
                    <svg
                      class="mm-icon"
                      viewBox="0 0 24 24"
                      width="21"
                      height="21"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="9" />
                      <path d="M12 3v9h9" />
                    </svg>
                  </span>
                  <div>
                    <h2>Répartition par statut</h2>
                    <p>Demandes enregistrées</p>
                  </div>
                </div>
              </div>
              <div class="donut-wrap">
                <div class="donut" style={`--portion:${pct}%`}>
                  <div>
                    <strong>{total}</strong>
                    <small>demandes</small>
                  </div>
                </div>
                <div class="legend">
                  <div>
                    <i class="dot gold-bg"></i>Nouvelles <strong>{nouvelles}</strong>
                  </div>
                  <div>
                    <i class="dot violet-bg"></i>En cours <strong>{enCours}</strong>
                  </div>
                  <div>
                    <i class="dot cyan-bg"></i>Devis envoyés <strong>{envoyees}</strong>
                  </div>
                  <div>
                    <i class="dot green-bg"></i>Acceptées <strong>{acceptees}</strong>
                  </div>
                </div>
              </div>
              <a href="#demandes" id="voir-nouvelles" class="notice notice-link">
                ✦ &nbsp;{' '}
                {nouvelles > 0
                  ? `${nouvelles} demande(s) à traiter.`
                  : 'Toutes les nouvelles demandes ont été traitées.'}
              </a>
            </article>
            <article class="panel activity" id="activite">
              <div class="panel-head">
                <div class="section-title">
                  <span class="section-icon">
                    <svg
                      class="mm-icon"
                      viewBox="0 0 24 24"
                      width="21"
                      height="21"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="9" />
                      <path d="M12 7v5l3 2" />
                    </svg>
                  </span>
                  <div>
                    <h2>Activité récente</h2>
                    <p>Dernières demandes reçues</p>
                  </div>
                </div>
              </div>
              <div class="activity-list">
                {demandes.slice(0, 4).map((d) => (
                  <div class="activity-item">
                    <span class="activity-marker">
                      <svg
                        class="mm-icon"
                        viewBox="0 0 24 24"
                        width="21"
                        height="21"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <path d="m3 7 9 7 9-7" />
                      </svg>
                    </span>
                    <div>
                      <strong>Demande {categorieDevis(d)}</strong>
                      <small>{d.reference_devis || `#${d.id}`}</small>
                    </div>
                    <time>{dateFR(d.date_creation)}</time>
                  </div>
                ))}
                {demandes.length === 0 && <p class="empty">Aucune activité récente.</p>}
              </div>
              <a href="#demandes" id="voir-toutes" class="all-requests">
                Voir toutes les demandes <span>→</span>
              </a>
            </article>
          </section>
          <section class="panel clients-panel" id="clients" aria-labelledby="clients-titre">
            <div class="panel-head">
              <div class="section-title">
                <span class="section-icon">
                  <svg
                    class="mm-icon"
                    viewBox="0 0 24 24"
                    width="21"
                    height="21"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="9" cy="8" r="3" />
                    <path d="M3 20v-2a6 6 0 0 1 12 0v2" />
                    <path d="M16 5a3 3 0 0 1 0 6M17 14a5 5 0 0 1 4 5v1" />
                  </svg>
                </span>
                <div>
                  <h2 id="clients-titre">Clients</h2>
                  <p>Contacts ayant envoyé une demande de devis.</p>
                </div>
              </div>
              <input
                type="search"
                id="recherche-clients"
                placeholder="Rechercher un client…"
                aria-label="Rechercher un client"
              />
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Client</th>
                    <th>E-mail</th>
                    <th>Téléphone</th>
                    <th>Ville</th>
                    <th>Demandes</th>
                    <th>Consulter</th>
                  </tr>
                </thead>
                <tbody>
                  {clients.map((c) => (
                    <tr
                      class="ligne-client"
                      data-client={[c.nom, c.prenom, c.email, c.entreprise, c.telephone, c.ville]
                        .filter(Boolean)
                        .join(' ')
                        .toLowerCase()}
                    >
                      <td>
                        <strong>{[c.prenom, c.nom].filter(Boolean).join(' ') || 'Non renseigné'}</strong>
                        {c.entreprise && <small>{c.entreprise}</small>}
                      </td>
                      <td>{c.email || '—'}</td>
                      <td>{c.telephone || '—'}</td>
                      <td>{c.ville || '—'}</td>
                      <td>{c.nombre_demandes}</td>
                      <td>
                        <a
                          class="row-action"
                          href={`/admin/clients/${c.id}/`}
                          aria-label={`Consulter la fiche client de ${c.prenom || ''} ${c.nom || ''}`}
                        >
                          →
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="empty" id="aucun-client" hidden>
              Aucun client trouvé.
            </p>
            {clients.length === 0 && <p class="empty">Aucun client enregistré.</p>}
            <div class="panel-foot">
              <span>{clients.length} client(s)</span>
              <span>Contacts issus des devis</span>
            </div>
          </section>
          <section class="panel corbeille-panel" id="corbeille">
            <div class="panel-head">
              <div class="section-title">
                <span class="section-icon">
                  <svg
                    class="mm-icon"
                    viewBox="0 0 24 24"
                    width="21"
                    height="21"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4 7h16M10 4h4M6 7l1 14h10l1-14M10 11v6M14 11v6" />
                  </svg>
                </span>
                <div>
                  <h2>Corbeille</h2>
                  <p>Demandes retirées du tableau de bord. Vous pouvez les restaurer.</p>
                </div>
              </div>
              {corbeille.length > 0 && (
                <button type="button" id="ouvrir-vidage" class="vider-corbeille mm-button mm-button--danger">
                  🗑 Vider la corbeille
                </button>
              )}
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Référence</th>
                    <th>Activité</th>
                    <th>Client</th>
                    <th>Restaurer</th>
                  </tr>
                </thead>
                <tbody>
                  {corbeille.map((d) => (
                    <tr>
                      <td class="reference">{d.reference_devis || `#${d.id}`}</td>
                      <td>{categorieDevis(d)}</td>
                      <td>{[d.prenom, d.nom].filter(Boolean).join(' ') || 'Non renseigné'}</td>
                      <td>
                        <form method="POST" action="/api/admin/gerer-demande">
                          <input type="hidden" name="id" value={d.id} />
                          <input type="hidden" name="action" value="restaurer" />
                          <button type="submit" class="restaurer mm-button">
                            ↩ Restaurer
                          </button>
                        </form>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {corbeille.length === 0 && <p class="empty">La corbeille est vide.</p>}
          </section>
          <dialog
            id="confirmation-vidage"
            class="dialog-vidage"
            aria-labelledby="vidage-titre"
            aria-describedby="vidage-description"
          >
            <div class="dialog-interieur">
              <span class="dialog-icone" aria-hidden="true">
                🗑
              </span>
              <h2 id="vidage-titre">Vider définitivement la corbeille ?</h2>
              <p id="vidage-description">
                Les {corbeille.length} demande(s) présentes dans la corbeille seront supprimées
                définitivement. Cette action est irréversible.
              </p>
              <div class="dialog-actions">
                <button type="button" id="annuler-vidage" class="annuler-vidage mm-button mm-button--navy">
                  Annuler
                </button>
                <form action="/api/admin/gerer-demande" method="POST">
                  <input type="hidden" name="action" value="vider_corbeille" />
                  <button type="submit" class="confirmer-vidage mm-button mm-button--danger">
                    Supprimer définitivement
                  </button>
                </form>
              </div>
            </div>
          </dialog>
          <footer class="footer">© Maison & Monde · Espace privé</footer>
        </main>
      </div>
    </div>
    <script>
      const selectTheme = document.querySelector<HTMLSelectElement>('#theme');

      if (selectTheme) {
        const themeActuel = document.documentElement.dataset.theme || 'auto';

        selectTheme.value = themeActuel;

        selectTheme.addEventListener('change', () => {
          const choix = selectTheme.value;

          document.documentElement.dataset.theme = choix;

          try {
            localStorage.setItem('mm-admin-theme', choix);
          } catch {
            // Le thème fonctionne même sans stockage local.
          }
        });
      }

      const rechercheGlobale = document.querySelector<HTMLInputElement>('#recherche-globale');
      const panneauxDevis = [...document.querySelectorAll<HTMLElement>('[data-devis-liste]')];
      const filtrer = () => {
        const global = (rechercheGlobale?.value || '').trim().toLowerCase();
        for (const panneau of panneauxDevis) {
          const texte = (panneau.querySelector<HTMLInputElement>('[data-recherche-liste]')?.value || '')
            .trim()
            .toLowerCase();
          const statut = panneau.querySelector<HTMLSelectElement>('[data-statut-liste]')?.value || '';
          const lignes = [...panneau.querySelectorAll<HTMLTableRowElement>('.ligne-demande')];
          let visibles = 0;
          for (const ligne of lignes) {
            const contenu = ligne.dataset.recherche || '';
            ligne.hidden = !(
              contenu.includes(texte) &&
              contenu.includes(global) &&
              (!statut || ligne.dataset.statut === statut)
            );
            if (!ligne.hidden) visibles++;
          }
          const compteur = panneau.querySelector<HTMLElement>('[data-compteur-resultats]');
          if (compteur) compteur.textContent = `${visibles} demande(s) affichée(s)`;
          const aucun = panneau.querySelector<HTMLElement>('[data-aucun-resultat]');
          if (aucun) aucun.hidden = visibles !== 0 || lignes.length === 0;
        }
      };
      panneauxDevis.forEach((panneau) => {
        panneau.querySelector('[data-recherche-liste]')?.addEventListener('input', filtrer);
        panneau.querySelector('[data-statut-liste]')?.addEventListener('change', filtrer);
      });
      rechercheGlobale?.addEventListener('input', filtrer);
      document.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          rechercheGlobale?.focus();
        }
      });
      const afficherDemandes = (statut = '') => {
        if (rechercheGlobale) rechercheGlobale.value = '';
        panneauxDevis.forEach((panneau) => {
          const recherche = panneau.querySelector<HTMLInputElement>('[data-recherche-liste]');
          const filtre = panneau.querySelector<HTMLSelectElement>('[data-statut-liste]');
          if (recherche) recherche.value = '';
          if (filtre) filtre.value = statut;
        });
        filtrer();
      };
      document
        .querySelector('#voir-nouvelles')
        ?.addEventListener('click', () => afficherDemandes('nouvelle'));
      document.querySelector('#voir-toutes')?.addEventListener('click', () => afficherDemandes());
      const rechercheClients = document.querySelector<HTMLInputElement>('#recherche-clients');
      const lignesClients = Array.from(document.querySelectorAll<HTMLTableRowElement>('.ligne-client'));
      rechercheClients?.addEventListener('input', () => {
        const texte = rechercheClients.value.trim().toLowerCase();
        let nombre = 0;
        for (const ligne of lignesClients) {
          ligne.hidden = !(ligne.dataset.client || '').includes(texte);
          if (!ligne.hidden) nombre++;
        }
        const aucun = document.querySelector<HTMLElement>('#aucun-client');
        if (aucun) aucun.hidden = nombre !== 0 || lignesClients.length === 0;
      });
      // Confirmation explicite avant suppression définitive.
      const dialogueVidage = document.querySelector<HTMLDialogElement>('#confirmation-vidage');
      document
        .querySelector<HTMLButtonElement>('#ouvrir-vidage')
        ?.addEventListener('click', () => dialogueVidage?.showModal());
      document
        .querySelector<HTMLButtonElement>('#annuler-vidage')
        ?.addEventListener('click', () => dialogueVidage?.close());
      dialogueVidage?.addEventListener('click', (event) => {
        if (event.target === dialogueVidage) dialogueVidage.close();
      });
      // Navigation latérale : lien actif selon la section ouverte.
      const liensMenu = Array.from(document.querySelectorAll<HTMLAnchorElement>('.sidebar nav a'));
      const sectionsMenu = [
        'demandes',
        'devis-menage',
        'devis-conciergerie',
        'statistiques',
        'activite',
        'clients',
        'corbeille',
      ];
      const activerMenu = (cible: string) => {
        for (const lien of liensMenu) {
          const actif = (lien.getAttribute('href') || '') === cible;
          lien.classList.toggle('active', actif);
          if (actif) lien.setAttribute('aria-current', 'location');
          else lien.removeAttribute('aria-current');
        }
        // Le panneau correspondant s'illumine en même temps que son bouton.
        document.querySelectorAll<HTMLElement>('.section-illuminee').forEach((section) => {
          section.classList.remove('section-illuminee');
        });
        const id = cible.startsWith('#') ? cible.slice(1) : '';
        const panneau = id ? document.getElementById(id) : document.querySelector<HTMLElement>('.hero');
        panneau?.classList.add('section-illuminee');
      };
      const synchroniserMenu = () => {
        const hash = window.location.hash;
        activerMenu(sectionsMenu.some((id) => hash === `#${id}`) ? hash : '/admin/');
      };
      liensMenu.forEach((lien) => {
        lien.addEventListener('click', () => {
          const destination = lien.getAttribute('href') || '/admin/';
          activerMenu(destination);
          if (destination === '/admin/' && window.location.pathname === '/admin/') {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });
      });
      window.addEventListener('hashchange', synchroniserMenu);
      synchroniserMenu();
      // Un bouton de raccourci vers les demandes active aussi le bon onglet.
      ['voir-nouvelles', 'voir-toutes'].forEach((id) => {
        document.getElementById(id)?.addEventListener('click', () => activerMenu('#demandes'));
      });
      filtrer();
    </script>
  </body>
</html>
