---
import mysql from 'mysql2/promise';
import { createHash } from 'node:crypto';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'private, no-store');

const token = Astro.cookies.get('mm_admin_session')?.value;

if (!token) {
  return Astro.redirect('/admin/connexion/');
}

const tokenHash = createHash('sha256')
  .update(token)
  .digest('hex');

type Demande = {
  id: number;
  reference_devis: string | null;
  nom: string | null;
  prenom: string | null;
  email: string | null;
  telephone: string | null;
  ville: string | null;
  type_devis: string;
  frequence: string | null;
  statut: string | null;
  date_creation: Date | null;
};

let connection: mysql.Connection | undefined;
let demandes: Demande[] = [];
let corbeille: Demande[] = [];

try {
  connection = await mysql.createConnection({
    host: import.meta.env.DB_HOST || '127.0.0.1',
    port: Number(import.meta.env.DB_PORT || 8889),
    user: import.meta.env.DB_USER,
    password: import.meta.env.DB_PASSWORD,
    database: import.meta.env.DB_NAME
  });

  // Vérifier la session avant de lire les données des clients.
  const [sessions] = await connection.execute<mysql.RowDataPacket[]>(
    `SELECT s.id
     FROM sessions_admin s
     INNER JOIN administrateurs a
       ON a.id = s.administrateur_id
     WHERE s.token_hash = ?
       AND s.date_expiration > NOW()
       AND a.actif = 1
     LIMIT 1`,
    [tokenHash]
  );

  if (sessions.length === 0) {
    Astro.cookies.delete('mm_admin_session', { path: '/' });
    return Astro.redirect('/admin/connexion/');
  }

  const [rows] = await connection.execute<mysql.RowDataPacket[]>(
    `SELECT
       id,
       reference_devis,
       nom,
       prenom,
       email,
       telephone,
       ville,
       type_devis,
       frequence,
       statut,
       date_creation
     FROM demandes_devis
     WHERE date_suppression IS NULL
     ORDER BY date_creation DESC, id DESC
     LIMIT 500`
  );

  demandes = rows as Demande[];
  const [supprimees] = await connection.execute<mysql.RowDataPacket[]>(
    `SELECT id, reference_devis, nom, prenom, email, telephone, ville, type_devis, frequence, statut, date_creation
     FROM demandes_devis WHERE date_suppression IS NOT NULL ORDER BY date_suppression DESC LIMIT 100`
  );
  corbeille = supprimees as Demande[];

} finally {
  if (connection) {
    await connection.end();
  }
}

const clients = Array.from(new Map(demandes.filter(d => d.email || d.telephone).map(d => [(d.email || d.telephone || '').trim().toLowerCase(), d])).values());
const demandesParClient = (client: Demande) => demandes.filter(d => (client.email && d.email?.toLowerCase() === client.email.toLowerCase()) || (!client.email && client.telephone && d.telephone === client.telephone)).length;
const total = demandes.length;
const nouvelles = demandes.filter(d => d.statut === 'nouvelle').length;
const enCours = demandes.filter(d => d.statut === 'en_cours').length;
const envoyees = demandes.filter(d => d.statut === 'devis_envoye').length;
const acceptees = demandes.filter(d => d.statut === 'acceptee').length;

const nomsStatuts: Record<string, string> = {
  nouvelle: 'Nouvelle',
  en_cours: 'En cours',
  devis_envoye: 'Devis envoyé',
  acceptee: 'Acceptée'
};

const dateFR = (date: Date | null) =>
  date
    ? new Intl.DateTimeFormat('fr-FR', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric'
      }).format(new Date(date))
    : '—';

const jours = Array.from({length: 7}, (_, i) => {
  const d = new Date(); d.setHours(0,0,0,0); d.setDate(d.getDate() - (6-i));
  return { label: new Intl.DateTimeFormat('fr-FR',{day:'2-digit',month:'2-digit'}).format(d), nombre: demandes.filter(x => x.date_creation && new Date(x.date_creation).toDateString() === d.toDateString()).length };
});
const maximum = Math.max(1, ...jours.map(j => j.nombre));
const points = jours.map((j,i) => `${30 + i*70},${155 - (j.nombre/maximum)*112}`).join(' ');
const pct = total ? Math.round(nouvelles/total*100) : 0;
---
<html lang="fr"><head><link rel="icon" type="image/png" href="/favicon.png" /><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="color-scheme" content="light dark"/><title>Administration | Maison & Monde</title><script is:inline>(()=>{try{document.documentElement.dataset.theme=localStorage.getItem('mm-admin-theme')||'auto'}catch{document.documentElement.dataset.theme='auto'}})();</script></head><body><div class="app"><aside class="sidebar"><div class="brand">MAISON <em>&</em> MONDE<small>Espace administrateur</small></div><nav aria-label="Navigation principale"><a class="active" href="/admin/"><span>◈</span> Tableau de bord</a><a href="#demandes"><span>▤</span> Demandes de devis</a><a href="#statistiques"><span>▥</span> Statistiques</a><a href="#activite"><span>◷</span> Activité récente</a><a href="#clients" id="lien-clients"><span>▦</span> Clients</a><a href="#corbeille"><span>♻</span> Corbeille</a></nav><div class="sidebar-bottom"><div class="profile"><span class="avatar">M</span><div>Maison & Monde<small>Administration</small></div></div><form action="/api/admin/deconnexion" method="POST"><button type="submit" class="logout">↪ &nbsp; Se déconnecter</button></form></div></aside><div class="content"><header class="topbar"><div class="top-title"><span class="top-search-icon">⌕</span><input id="recherche-globale" type="search" placeholder="Rechercher un client, une référence, un e-mail…" aria-label="Recherche globale"/><kbd>⌘ K</kbd></div><div class="top-actions"><label for="theme">Apparence</label><select id="theme" aria-label="Apparence"><option value="auto">🖥️ Automatique</option><option value="clair">☀️ Clair</option><option value="sombre">🌙 Sombre</option></select></div></header><main><section class="hero"><div class="hero-text"><div class="eyebrow">GESTION DES CLIENTS <span class="eyebrow-line"></span></div><h1>Tableau de bord<span class="gold-dot">.</span></h1><p>Suivez vos demandes de devis en toute simplicité.</p></div><div class="hero-decoration" aria-hidden="true"><div class="hero-circle">
  <img
    src="/images/logo-admin.png"
    alt="Logo Maison & Monde"
    class="hero-logo"
  />
</div><div class="hero-brand-name">MAISON <span>&amp;</span> MONDE</div><div class="hero-caption">L’excellence du service,<br/>le soin du détail.</div></div></section><section class="kpis" aria-label="Indicateurs"><article class="kpi blue"><div class="kpi-top"><span class="icon">▤</span><span>Total des demandes</span></div><div class="kpi-number">{total}</div><small>Demandes récentes affichées</small><div class="spark"></div></article><article class="kpi gold"><div class="kpi-top"><span class="icon">✉</span><span>Nouvelles</span></div><div class="kpi-number">{nouvelles}</div><small>À traiter</small><div class="spark"></div></article><article class="kpi violet"><div class="kpi-top"><span class="icon">◷</span><span>En cours</span></div><div class="kpi-number">{enCours}</div><small>En traitement</small><div class="spark"></div></article><article class="kpi cyan"><div class="kpi-top"><span class="icon">➤</span><span>Devis envoyés</span></div><div class="kpi-number">{envoyees}</div><small>En attente de réponse</small><div class="spark"></div></article><article class="kpi green"><div class="kpi-top"><span class="icon">✓</span><span>Acceptées</span></div><div class="kpi-number">{acceptees}</div><small>Demandes confirmées</small><div class="spark"></div></article></section><section class="panel requests" id="demandes"><div class="panel-head"><div class="section-title"><span class="section-icon">▤</span><div><h2>Demandes de devis</h2><p>Les dernières demandes reçues sur le site.</p></div></div><div class="filters"><input type="search" id="recherche" placeholder="Rechercher une demande…" aria-label="Rechercher une demande"/><select id="filtre-statut" aria-label="Filtrer par statut"><option value="">Tous les statuts</option><option value="nouvelle">Nouvelles</option><option value="en_cours">En cours</option><option value="devis_envoye">Devis envoyés</option><option value="acceptee">Acceptées</option></select></div></div><div class="table-wrap"><table><thead><tr><th>Date</th><th>Référence</th><th>Client</th><th>Ville</th><th>Téléphone</th><th>Fréquence</th><th>Statut</th><th>Actions</th></tr></thead><tbody>                {demandes.map((demande) => (
                  <tr
                    class="ligne-demande"
                    data-statut={demande.statut || ''}
                    data-recherche={[
                      demande.reference_devis,
                      demande.nom,
                      demande.prenom,
                      demande.email,
                      demande.telephone,
                      demande.ville
                    ].filter(Boolean).join(' ').toLowerCase()}
                  >
                    <td>{dateFR(demande.date_creation)}</td>

                    <td class="reference">
                      {demande.reference_devis || `#${demande.id}`}
                    </td>

                    <td>
                      <strong>
                        {[demande.prenom, demande.nom]
                          .filter(Boolean)
                          .join(' ') || 'Non renseigné'}
                      </strong>
                      <small>{demande.email || '—'}</small>
                    </td>

                    <td>{demande.ville || '—'}</td>
                    <td>{demande.telephone || '—'}</td>
                    <td>{demande.frequence || '—'}</td>

                    <td>
                      <span class={`badge badge-${demande.statut || 'inconnu'}`}>
                        {nomsStatuts[demande.statut || ''] ||
                          demande.statut ||
                          'Non défini'}
                      </span>
                    </td>
                    <td><a class="row-action" href={`/admin/demandes/${demande.id}/`} title="Voir la demande" aria-label={`Voir la demande ${demande.reference_devis || demande.id}`}>→</a></td>
                  </tr>
                ))}</tbody></table></div><p id="aucun-resultat" class="empty" hidden>Aucune demande ne correspond à votre recherche.</p>{demandes.length === 0 && <p class="empty">Aucune demande de devis enregistrée.</p>}<div class="panel-foot"><span id="compteur-resultats">{demandes.length} demande(s) affichée(s)</span><span>Maison & Monde · Suivi des devis</span></div></section><section class="analytics" id="statistiques"><article class="panel graph"><div class="panel-head"><div class="section-title"><span class="section-icon">▥</span><div><h2>Évolution des demandes</h2><p>Les 7 derniers jours</p></div></div></div><div class="graph-area"><svg viewBox="0 0 480 190" role="img" aria-label="Graphique des demandes des sept derniers jours" preserveAspectRatio="none"><defs><linearGradient id="areaFill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#d5a54c" stop-opacity=".3"/><stop offset="1" stop-color="#d5a54c" stop-opacity="0"/></linearGradient></defs><path d="M30 43H450 M30 80H450 M30 118H450 M30 155H450" class="gridlines"/><polygon points={`30,155 ${points} 450,155`} fill="url(#areaFill)"/><polyline points={points} fill="none" stroke="#d5a54c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>{jours.map((j,i)=><circle cx={30+i*70} cy={155-(j.nombre/maximum)*112} r="4" fill="#d5a54c" stroke="var(--card)" stroke-width="2" />)}</svg><div class="days">{jours.map(j=><span>{j.label}</span>)}</div></div><div class="graph-summary"><div><strong>{jours.reduce((a,j)=>a+j.nombre,0)}</strong><small>Demandes sur 7 jours</small></div><div><strong>{total}</strong><small>Demandes affichées</small></div></div></article><article class="panel distribution"><div class="panel-head"><div class="section-title"><span class="section-icon">◕</span><div><h2>Répartition par statut</h2><p>Demandes enregistrées</p></div></div></div><div class="donut-wrap"><div class="donut" style={`--portion:${pct}%`}><div><strong>{total}</strong><small>demandes</small></div></div><div class="legend"><div><i class="dot gold-bg"></i>Nouvelles <strong>{nouvelles}</strong></div><div><i class="dot violet-bg"></i>En cours <strong>{enCours}</strong></div><div><i class="dot cyan-bg"></i>Devis envoyés <strong>{envoyees}</strong></div><div><i class="dot green-bg"></i>Acceptées <strong>{acceptees}</strong></div></div></div><a href="#demandes" id="voir-nouvelles" class="notice notice-link">✦ &nbsp; {nouvelles > 0 ? `${nouvelles} demande(s) à traiter.` : 'Toutes les nouvelles demandes ont été traitées.'}</a></article><article class="panel activity" id="activite"><div class="panel-head"><div class="section-title"><span class="section-icon">◷</span><div><h2>Activité récente</h2><p>Dernières demandes reçues</p></div></div></div><div class="activity-list">{demandes.slice(0,4).map(d=><div class="activity-item"><span class="activity-marker">✉</span><div><strong>Demande reçue</strong><small>{d.reference_devis || `#${d.id}`}</small></div><time>{dateFR(d.date_creation)}</time></div>)}{demandes.length===0 && <p class="empty">Aucune activité récente.</p>}</div><a href="#demandes" id="voir-toutes" class="all-requests">Voir toutes les demandes <span>→</span></a></article></section><section class="panel clients-panel" id="clients" aria-labelledby="clients-titre"><div class="panel-head"><div class="section-title"><span class="section-icon">▦</span><div><h2 id="clients-titre">Clients</h2><p>Contacts ayant envoyé une demande de devis.</p></div></div><input type="search" id="recherche-clients" placeholder="Rechercher un client…" aria-label="Rechercher un client"/></div><div class="table-wrap"><table><thead><tr><th>Client</th><th>E-mail</th><th>Téléphone</th><th>Ville</th><th>Demandes</th><th>Consulter</th></tr></thead><tbody>{clients.map(c => <tr class="ligne-client" data-client={[c.nom,c.prenom,c.email,c.telephone,c.ville].filter(Boolean).join(' ').toLowerCase()}><td><strong>{[c.prenom,c.nom].filter(Boolean).join(' ') || 'Non renseigné'}</strong></td><td>{c.email || '—'}</td><td>{c.telephone || '—'}</td><td>{c.ville || '—'}</td><td>{demandesParClient(c)}</td><td><a class="row-action" href={`/admin/demandes/${c.id}/`} aria-label={`Consulter la demande de ${c.prenom || ''} ${c.nom || ''}`}>→</a></td></tr>)}</tbody></table></div><p class="empty" id="aucun-client" hidden>Aucun client trouvé.</p>{clients.length === 0 && <p class="empty">Aucun client enregistré.</p>}<div class="panel-foot"><span>{clients.length} client(s)</span><span>Contacts issus des devis</span></div></section><section class="panel corbeille-panel" id="corbeille"><div class="panel-head"><div class="section-title"><span class="section-icon">♻</span><div><h2>Corbeille</h2><p>Demandes retirées du tableau de bord. Vous pouvez les restaurer.</p></div></div>{corbeille.length > 0 && <button type="button" id="ouvrir-vidage" class="vider-corbeille">🗑 Vider la corbeille</button>}</div><div class="table-wrap"><table><thead><tr><th>Référence</th><th>Client</th><th>Restaurer</th></tr></thead><tbody>{corbeille.map(d => <tr><td class="reference">{d.reference_devis || `#${d.id}`}</td><td>{[d.prenom,d.nom].filter(Boolean).join(' ') || 'Non renseigné'}</td><td><form method="POST" action="/api/admin/gerer-demande"><input type="hidden" name="id" value={d.id}/><input type="hidden" name="action" value="restaurer"/><button type="submit" class="restaurer">↩ Restaurer</button></form></td></tr>)}</tbody></table></div>{corbeille.length === 0 && <p class="empty">La corbeille est vide.</p>}</section><dialog id="confirmation-vidage" class="dialog-vidage" aria-labelledby="vidage-titre" aria-describedby="vidage-description"><div class="dialog-interieur"><span class="dialog-icone" aria-hidden="true">🗑</span><h2 id="vidage-titre">Vider définitivement la corbeille ?</h2><p id="vidage-description">Les {corbeille.length} demande(s) présentes dans la corbeille seront supprimées définitivement. Cette action est irréversible.</p><div class="dialog-actions"><button type="button" id="annuler-vidage" class="annuler-vidage">Annuler</button><form action="/api/admin/gerer-demande" method="POST"><input type="hidden" name="action" value="vider_corbeille"/><button type="submit" class="confirmer-vidage">Supprimer définitivement</button></form></div></div></dialog><footer class="footer">© Maison & Monde · Espace privé</footer></main></div></div>    <script>
      const selectTheme = document.querySelector<HTMLSelectElement>('#theme');

      if (selectTheme) {
        const themeActuel =
          document.documentElement.dataset.theme || 'auto';

        selectTheme.value = themeActuel;

        selectTheme.addEventListener('change', () => {
          const choix = selectTheme.value;

          document.documentElement.dataset.theme = choix;

          try {
            localStorage.setItem('mm-admin-theme', choix);
          } catch {
            // Le thème fonctionne même sans stockage local.
          }
        });
      }

      const recherche =
        document.querySelector<HTMLInputElement>('#recherche');

      const filtreStatut =
        document.querySelector<HTMLSelectElement>('#filtre-statut');

      const lignes = Array.from(
        document.querySelectorAll<HTMLTableRowElement>('.ligne-demande')
      );

      const compteur =
        document.querySelector<HTMLElement>('#compteur-resultats');

      const aucunResultat =
        document.querySelector<HTMLElement>('#aucun-resultat');

      const filtrer = () => {
        const texte = (recherche?.value || '').trim().toLowerCase();
        const statut = filtreStatut?.value || '';

        let visibles = 0;

        for (const ligne of lignes) {
          const correspondTexte =
            (ligne.dataset.recherche || '').includes(texte);

          const correspondStatut =
            !statut || ligne.dataset.statut === statut;

          const afficher = correspondTexte && correspondStatut;

          ligne.hidden = !afficher;

          if (afficher) visibles++;
        }

        if (compteur) {
          compteur.textContent = `${visibles} demande(s) affichée(s)`;
        }

        if (aucunResultat) {
          aucunResultat.hidden = visibles !== 0 || lignes.length === 0;
        }
      };

      const rechercheGlobale = document.querySelector<HTMLInputElement>('#recherche-globale');
      rechercheGlobale?.addEventListener('input', () => {
        if (recherche) { recherche.value = rechercheGlobale.value; filtrer(); }
      });
      document.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault(); rechercheGlobale?.focus();
        }
      });
      const afficherDemandes = (statut = '') => {
        if (recherche) recherche.value = '';
        if (rechercheGlobale) rechercheGlobale.value = '';
        if (filtreStatut) filtreStatut.value = statut;
        filtrer();
      };
      document.querySelector('#voir-nouvelles')?.addEventListener('click', () => afficherDemandes('nouvelle'));
      document.querySelector('#voir-toutes')?.addEventListener('click', () => afficherDemandes());
      document.querySelectorAll<HTMLAnchorElement>('a[href="#demandes"]').forEach(lien => {
        if (lien.id !== 'voir-nouvelles' && lien.id !== 'voir-toutes') lien.addEventListener('click', () => afficherDemandes());
      });
      const rechercheClients = document.querySelector<HTMLInputElement>('#recherche-clients');
      const lignesClients = Array.from(document.querySelectorAll<HTMLTableRowElement>('.ligne-client'));
      rechercheClients?.addEventListener('input', () => {
        const texte = rechercheClients.value.trim().toLowerCase();
        let nombre = 0;
        for (const ligne of lignesClients) {
          ligne.hidden = !(ligne.dataset.client || '').includes(texte);
          if (!ligne.hidden) nombre++;
        }
        const aucun = document.querySelector<HTMLElement>('#aucun-client');
        if (aucun) aucun.hidden = nombre !== 0 || lignesClients.length === 0;
      });
      // Confirmation explicite avant suppression définitive.
      const dialogueVidage = document.querySelector<HTMLDialogElement>('#confirmation-vidage');
      document.querySelector<HTMLButtonElement>('#ouvrir-vidage')?.addEventListener('click', () => dialogueVidage?.showModal());
      document.querySelector<HTMLButtonElement>('#annuler-vidage')?.addEventListener('click', () => dialogueVidage?.close());
      dialogueVidage?.addEventListener('click', (event) => {
        if (event.target === dialogueVidage) dialogueVidage.close();
      });
      // Navigation latérale : lien actif selon la section ouverte.
      const liensMenu = Array.from(document.querySelectorAll<HTMLAnchorElement>('.sidebar nav a'));
      const sectionsMenu = ['demandes', 'statistiques', 'activite', 'clients', 'corbeille'];
      const activerMenu = (cible: string) => {
        for (const lien of liensMenu) {
          const actif = (lien.getAttribute('href') || '') === cible;
          lien.classList.toggle('active', actif);
          if (actif) lien.setAttribute('aria-current', 'location');
          else lien.removeAttribute('aria-current');
        }
        // Le panneau correspondant s'illumine en même temps que son bouton.
        document.querySelectorAll<HTMLElement>('.section-illuminee').forEach(section => {
          section.classList.remove('section-illuminee');
        });
        const id = cible.startsWith('#') ? cible.slice(1) : '';
        const panneau = id ? document.getElementById(id) : document.querySelector<HTMLElement>('.hero');
        panneau?.classList.add('section-illuminee');
      };
      const synchroniserMenu = () => {
        const hash = window.location.hash;
        activerMenu(sectionsMenu.some(id => hash === `#${id}`) ? hash : '/admin/');
      };
      liensMenu.forEach(lien => {
        lien.addEventListener('click', () => {
          const destination = lien.getAttribute('href') || '/admin/';
          activerMenu(destination);
          if (destination === '/admin/' && window.location.pathname === '/admin/') {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });
      });
      window.addEventListener('hashchange', synchroniserMenu);
      synchroniserMenu();
      // Un bouton de raccourci vers les demandes active aussi le bon onglet.
      ['voir-nouvelles', 'voir-toutes'].forEach(id => {
        document.getElementById(id)?.addEventListener('click', () => activerMenu('#demandes'));
      });
      recherche?.addEventListener('input', filtrer);
      filtreStatut?.addEventListener('change', filtrer);
    </script>
</body></html>
<style>
