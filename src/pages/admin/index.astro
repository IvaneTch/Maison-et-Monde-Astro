---
import '../../styles/admin-dashboard.css';
import mysql from 'mysql2/promise';
import { createHash } from 'node:crypto';
import { categorieDevis, accompagnementConciergerie, infosProfessionnel } from '../../lib/devis-admin';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'private, no-store');

const token = Astro.cookies.get('mm_admin_session')?.value;

if (!token) {
  return Astro.redirect('/admin/connexion/');
}

const tokenHash = createHash('sha256').update(token).digest('hex');

type Demande = {
  id: number;
  reference_devis: string | null;
  nom: string | null;
  prenom: string | null;
  email: string | null;
  telephone: string | null;
  ville: string | null;
  type_devis: string;
  prestation_souhaitee: string | null;
  prestations: unknown;
  commentaires: string | null;
  frequence: string | null;
  statut: string | null;
  date_creation: Date | null;
};
type Client = {
  id: number;
  entreprise: string | null;
  prenom: string | null;
  nom: string | null;
  email: string | null;
  telephone: string | null;
  ville: string | null;
  nombre_demandes: number;
};

let connection: mysql.Connection | undefined;
let demandes: Demande[] = [];
let corbeille: Demande[] = [];
let clients: Client[] = [];
let rappelsNouveaux = 0;

try {
  connection = await mysql.createConnection({
    host: process.env.DB_HOST || import.meta.env.DB_HOST || '127.0.0.1',
    port: Number(process.env.DB_PORT || import.meta.env.DB_PORT || 8889),
    user: process.env.DB_USER || import.meta.env.DB_USER,
    password: process.env.DB_PASSWORD || import.meta.env.DB_PASSWORD,
    database: process.env.DB_NAME || import.meta.env.DB_NAME,
  });

  // Vérifier la session avant de lire les données des clients.
  const [sessions] = await connection.execute<mysql.RowDataPacket[]>(
    `SELECT s.id
     FROM sessions_admin s
     INNER JOIN administrateurs a
       ON a.id = s.administrateur_id
     WHERE s.token_hash = ?
       AND s.date_expiration > NOW()
       AND a.actif = 1
     LIMIT 1`,
    [tokenHash],
  );

  if (sessions.length === 0) {
    Astro.cookies.delete('mm_admin_session', { path: '/' });
    return Astro.redirect('/admin/connexion/');
  }

  const [rows] = await connection.execute<mysql.RowDataPacket[]>(
    `SELECT
       id,
       reference_devis,
       nom,
       prenom,
       email,
       telephone,
       ville,
       CASE WHEN prestation_souhaitee IN ('Conciergerie','Professionnel') THEN prestation_souhaitee ELSE type_devis END AS type_devis,
       prestation_souhaitee, prestations, commentaires,
       frequence,
       statut,
       date_creation
     FROM demandes_devis
     WHERE date_suppression IS NULL
     ORDER BY date_creation DESC, id DESC
     LIMIT 500`,
  );

  demandes = rows as Demande[];
  const [supprimees] = await connection.execute<mysql.RowDataPacket[]>(
    `SELECT id, reference_devis, nom, prenom, email, telephone, ville, prestation_souhaitee, prestations, commentaires, CASE WHEN prestation_souhaitee IN ('Conciergerie','Professionnel') THEN prestation_souhaitee ELSE type_devis END AS type_devis, frequence, statut, date_creation
     FROM demandes_devis WHERE date_suppression IS NOT NULL ORDER BY date_suppression DESC LIMIT 100`,
  );
  corbeille = supprimees as Demande[];
  const [lignesClients] = await connection.execute<mysql.RowDataPacket[]>(
    `SELECT
     c.id,
     c.prenom,
     c.nom,
     c.email,
     c.entreprise,
     c.telephone,
     c.ville,
     COUNT(d.id) AS nombre_demandes
   FROM clients c
   LEFT JOIN demandes_devis d
     ON d.client_id = c.id
     AND d.date_suppression IS NULL
   WHERE c.date_suppression IS NULL
   GROUP BY
     c.id, c.prenom, c.nom, c.email, c.entreprise, c.telephone, c.ville
   ORDER BY c.id DESC`,
  );

  clients = lignesClients as Client[];
  const [rappels] = await connection.execute<mysql.RowDataPacket[]>(
    `SELECT COUNT(*) AS total FROM demandes_contact WHERE type_demande='rappel' AND statut='nouvelle'`,
  );
  rappelsNouveaux = Number(rappels[0]?.total || 0);
} finally {
  if (connection) {
    await connection.end();
  }
}

const listesDevis = [
  {
    id: 'devis-menage',
    titre: 'Devis Ménage',
    categorie: 'menage',
    demandes: demandes.filter((d) => categorieDevis(d) === 'Ménage'),
  },
  {
    id: 'devis-conciergerie',
    titre: 'Devis Conciergerie',
    categorie: 'conciergerie',
    demandes: demandes.filter((d) => categorieDevis(d) === 'Conciergerie'),
  },
  {
    id: 'devis-professionnel',
    titre: 'Devis Professionnel',
    categorie: 'professionnel',
    demandes: demandes.filter((d) => categorieDevis(d) === 'Professionnel'),
  },
];
const total = demandes.length;
const nouvelles = demandes.filter((d) => d.statut === 'nouvelle').length;
const enCours = demandes.filter((d) => d.statut === 'en_cours').length;
const envoyees = demandes.filter((d) => d.statut === 'devis_envoye').length;
const acceptees = demandes.filter((d) => d.statut === 'acceptee').length;

const nomsStatuts: Record<string, string> = {
  nouvelle: 'Nouvelle',
  en_cours: 'En cours',
  devis_envoye: 'Devis envoyé',
  acceptee: 'Acceptée',
  refusee: 'Refusée',
};

const dateFR = (date: Date | null) =>
  date
    ? new Intl.DateTimeFormat('fr-FR', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
      }).format(new Date(date))
    : '—';

const jours = Array.from({ length: 7 }, (_, i) => {
  const d = new Date();
  d.setHours(0, 0, 0, 0);
  d.setDate(d.getDate() - (6 - i));
  return {
    label: new Intl.DateTimeFormat('fr-FR', { day: '2-digit', month: '2-digit' }).format(d),
    nombre: demandes.filter(
      (x) => x.date_creation && new Date(x.date_creation).toDateString() === d.toDateString(),
    ).length,
  };
});
const maximum = Math.max(1, ...jours.map((j) => j.nombre));
const points = jours.map((j, i) => `${30 + i * 70},${155 - (j.nombre / maximum) * 112}`).join(' ');
const pct = total ? Math.round((nouvelles / total) * 100) : 0;
const nouvellesMenage = demandes.filter(
  (d) => d.statut === 'nouvelle' && categorieDevis(d) === 'Ménage',
).length;
const nouvellesConciergerie = demandes.filter(
  (d) => d.statut === 'nouvelle' && categorieDevis(d) === 'Conciergerie',
).length;
const nouvellesProfessionnel = demandes.filter(
  (d) => d.statut === 'nouvelle' && categorieDevis(d) === 'Professionnel',
).length;
