---
import '../../styles/admin-connexion.css';
export const prerender = false;

const erreur = Astro.url.searchParams.get('erreur');
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Connexion administrateur | Maison & Monde</title>
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        try {
          document.documentElement.dataset.theme = localStorage.getItem('mm-admin-theme') || 'auto';
        } catch {
          document.documentElement.dataset.theme = 'auto';
        }
      })();
    </script>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>

  <body>
    <main class="page">
      <section class="connexion">
        <div class="logo">
          MAISON <span>&</span> MONDE
        </div>
        <div class="theme-switch">
          <label for="theme">Apparence</label>
          <select id="theme">
            <option value="auto">🖥️ Automatique</option>
            <option value="clair">☀️ Clair</option>
            <option value="sombre">🌙 Sombre</option>
          </select>
        </div>

        <div class="ligne"></div>

        <h1>Espace administrateur</h1>
        <p class="description">Connectez-vous pour gérer les demandes de devis.</p>

        {erreur && <div class="erreur">Adresse e-mail ou mot de passe incorrect.</div>}

        <form action="/api/admin/connexion" method="POST">
          <label for="email">Adresse e-mail</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="Votre adresse e-mail"
            autocomplete="username"
            required
          />

          <label for="password">Mot de passe</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="Votre mot de passe"
            autocomplete="current-password"
            required
          />

          <button class="mm-button" type="submit">Se connecter</button>
        </form>

        <p class="retour">
          <a href="/">← Retour au site Maison & Monde</a>
        </p>
      </section>
    </main>
  </body>
</html>

<script>
  const themeSelect = document.querySelector<HTMLSelectElement>('#theme');
  if (themeSelect) {
    themeSelect.value = document.documentElement.dataset.theme || 'auto';
    themeSelect.addEventListener('change', () => {
      document.documentElement.dataset.theme = themeSelect.value;
      try {
        localStorage.setItem('mm-admin-theme', themeSelect.value);
      } catch {}
    });
  }
</script>
