---
import '../../../styles/admin-client-details.css';
import mysql from 'mysql2/promise';
import { createHash } from 'node:crypto';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'private, no-store');

// Vérification de la connexion administrateur
const token = Astro.cookies.get('mm_admin_session')?.value;

if (!token) {
  return Astro.redirect('/admin/connexion/');
}

const id = Number(Astro.params.id);

if (!Number.isSafeInteger(id) || id < 1) {
  return new Response('Client introuvable', { status: 404 });
}

type Client = mysql.RowDataPacket & {
  id: number;
  type_client: 'particulier' | 'professionnel';
  prenom: string | null;
  nom: string | null;
  entreprise: string | null;
  email: string | null;
  telephone: string | null;
  adresse: string | null;
  code_postal: string | null;
  ville: string | null;
  notes: string | null;
};

type Demande = mysql.RowDataPacket & {
  id: number;
  reference_devis: string | null;
  prenom: string | null;
  nom: string | null;
  email: string | null;
  telephone: string | null;
  adresse: string | null;
  code_postal: string | null;
  ville: string | null;
  statut: string | null;
  date_creation: Date | string | null;
  type_devis: string | null;
};

let client: Client | undefined;
let historique: Demande[] = [];
let connection: mysql.Connection | undefined;

try {
  connection = await mysql.createConnection({
    host: process.env.DB_HOST || import.meta.env.DB_HOST || '127.0.0.1',
    port: Number(process.env.DB_PORT || import.meta.env.DB_PORT || 8889),
    user: process.env.DB_USER || import.meta.env.DB_USER,
    password: process.env.DB_PASSWORD || import.meta.env.DB_PASSWORD,
    database: process.env.DB_NAME || import.meta.env.DB_NAME,
  });

  const hash = createHash('sha256').update(token).digest('hex');
  const [sessions] = await connection.execute<mysql.RowDataPacket[]>(
    `SELECT s.id FROM sessions_admin s
     JOIN administrateurs a ON a.id = s.administrateur_id
     WHERE s.token_hash = ? AND s.date_expiration > NOW()
       AND a.actif = 1 LIMIT 1`,
    [hash],
  );

  if (!sessions.length) {
    Astro.cookies.delete('mm_admin_session', { path: '/' });
    return Astro.redirect('/admin/connexion/');
  }

  const [clients] = await connection.execute<Client[]>(
    `SELECT
     id,
     type_client,
     prenom,
     nom,
     entreprise,
     email,
     telephone,
     adresse,
     code_postal,
     ville,
     notes
   FROM clients
   WHERE id = ?
     AND date_suppression IS NULL
   LIMIT 1`,
    [id],
  );
  client = clients[0];
  if (!client) return new Response('Client introuvable', { status: 404 });

  const [demandes] = await connection.execute<Demande[]>(
    `SELECT id, reference_devis, CASE WHEN prestation_souhaitee='Conciergerie' THEN 'Conciergerie' ELSE type_devis END AS type_devis, statut, date_creation
     FROM demandes_devis
     WHERE client_id = ? AND date_suppression IS NULL
     ORDER BY date_creation DESC, id DESC`,
    [id],
  );
  historique = demandes;
} finally {
  if (connection) await connection.end();
}

const ficheClient = client!;

const nomComplet = [ficheClient.prenom, ficheClient.nom].filter(Boolean).join(' ') || 'Client sans nom';

const afficher = (valeur: unknown) => {
  if (valeur === null || valeur === undefined || String(valeur).trim() === '') {
    return 'Non renseigné';
  }

  return String(valeur);
};

const dateFR = (valeur: Date | string | null) => {
  if (!valeur) return '—';

  const date = new Date(valeur);

  if (Number.isNaN(date.getTime())) return '—';

  return new Intl.DateTimeFormat('fr-FR', {
    dateStyle: 'medium',
  }).format(date);
};

const statuts: Record<string, string> = {
  nouvelle: 'Nouvelle',
  en_cours: 'En cours',
  devis_envoye: 'Devis envoyé',
  acceptee: 'Acceptée',
};
---

<!doctype html>
<html lang="fr" data-theme="auto">
  <head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="robots" content="noindex,nofollow" />

    <link rel="icon" type="image/png" href="/favicon.png" />

    <title>{nomComplet} | Clients | Maison & Monde</title>

    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem('mm-admin-theme') || 'auto';
      } catch {}
    </script>

  </head>

  <body>
    <header class="top">
      <div class="brand">
        MAISON <span>&amp;</span> MONDE
      </div>

      <a href="/admin/">← Tableau de bord</a>
    </header>

    <main>
      <a class="back" href="/admin/#clients">
        ← Retour à la liste des clients
      </a>
      {Astro.url.searchParams.get('modifie') === '1' && (
        <div class="success-message">✓ Les informations du client ont été enregistrées avec succès.</div>
      )}
      <div class="intro">
        <div class="eyebrow">GESTION DES CLIENTS · FICHE CLIENT</div>

        <h1>{nomComplet}</h1>

        <span class="badge">{historique.length} demande(s) de devis</span>

        <p>Coordonnées et historique des demandes enregistrées.</p>
      </div>

      <div class="cards">
        <!-- Coordonnées -->

        <section class="card">
          <h2>Coordonnées du client</h2>

          <dl class="fields">
            <div class="field">
              <dt>Prénom</dt>
              <dd>{afficher(ficheClient.prenom)}</dd>
            </div>

            <div class="field">
              <dt>Nom</dt>
              <dd>{afficher(ficheClient.nom)}</dd>
            </div>

            <div class="field">
              <dt>Adresse e-mail</dt>
              <dd>
                {ficheClient.email ? (
                  <a href={`mailto:${ficheClient.email}`}>{ficheClient.email}</a>
                ) : (
                  'Non renseigné'
                )}
              </dd>
            </div>

            <div class="field">
              <dt>Téléphone</dt>
              <dd>
                {ficheClient.telephone ? (
                  <a href={`tel:${ficheClient.telephone.replace(/[^+\d]/g, '')}`}>{ficheClient.telephone}</a>
                ) : (
                  'Non renseigné'
                )}
              </dd>
            </div>
          </dl>
        </section>

        <!-- Adresse -->

        <section class="card">
          <h2>Adresse renseignée</h2>

          <dl class="fields">
            <div class="field full">
              <dt>Adresse de l'intervention</dt>
              <dd>{afficher(ficheClient.adresse)}</dd>
            </div>

            <div class="field">
              <dt>Code postal</dt>
              <dd>{afficher(ficheClient.code_postal)}</dd>
            </div>

            <div class="field">
              <dt>Ville</dt>
              <dd>{afficher(ficheClient.ville)}</dd>
            </div>
          </dl>

          <p class="muted">
            Adresse enregistrée dans la fiche client. Elle peut être différente de l’adresse d’intervention
            indiquée dans une demande.
          </p>
        </section>
      </div>
      <!-- Modification de la fiche client -->

      <button
        type="button"
        class="edit-client-button mm-button"
        id="edit-client-button"
        aria-expanded="false"
        aria-controls="edit-client-section"
      >
        ✏️ Modifier la fiche client
      </button>

      <section class="card history" id="edit-client-section" hidden>
        <h2>✏️ Modifier les informations du client</h2>

        <form method="POST" action="/api/admin/gerer-client/">
          <input type="hidden" name="action" value="modifier" />
          <input type="hidden" name="id" value={ficheClient.id} />

          <div class="fields">
            <div class="field">
              <label for="type_client">Type de client</label>
              <select id="type_client" name="type_client">
                <option value="particulier" selected={ficheClient.type_client === 'particulier'}>
                  Particulier
                </option>
                <option value="professionnel" selected={ficheClient.type_client === 'professionnel'}>
                  Professionnel
                </option>
              </select>
            </div>

            <div class="field">
              <label for="entreprise">Entreprise</label>
              <input id="entreprise" name="entreprise" value={ficheClient.entreprise || ''} />
            </div>

            <div class="field">
              <label for="prenom">Prénom</label>
              <input id="prenom" name="prenom" value={ficheClient.prenom || ''} />
            </div>

            <div class="field">
              <label for="nom">Nom</label>
              <input id="nom" name="nom" value={ficheClient.nom || ''} />
            </div>

            <div class="field">
              <label for="email">Adresse e-mail</label>
              <input id="email" type="email" name="email" value={ficheClient.email || ''} />
            </div>

            <div class="field">
              <label for="telephone">Téléphone</label>
              <input id="telephone" name="telephone" value={ficheClient.telephone || ''} />
            </div>

            <div class="field full">
              <label for="adresse">Adresse</label>
              <input id="adresse" name="adresse" value={ficheClient.adresse || ''} />
            </div>

            <div class="field">
              <label for="code_postal">Code postal</label>
              <input id="code_postal" name="code_postal" value={ficheClient.code_postal || ''} />
            </div>

            <div class="field">
              <label for="ville">Ville</label>
              <input id="ville" name="ville" value={ficheClient.ville || ''} />
            </div>

            <div class="field full">
              <label for="notes">Notes internes</label>
              <textarea id="notes" name="notes" rows="4">{ficheClient.notes || ''}</textarea>
            </div>
          </div>

          <button type="submit" class="save-client mm-button">
            Enregistrer les modifications
          </button>
        </form>
      </section>
      <!-- Historique des demandes -->

      <section class="card history">
        <h2>Historique des demandes</h2>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Référence</th>
                <th>Type</th>
                <th>Statut</th>
                <th>Consulter</th>
              </tr>
            </thead>

            <tbody>
              {historique.map((d) => (
                <tr>
                  <td>{dateFR(d.date_creation)}</td>

                  <td>{afficher(d.reference_devis)}</td>

                  <td>{afficher(d.type_devis)}</td>

                  <td>{statuts[d.statut || ''] || afficher(d.statut)}</td>

                  <td>
                    <a class="request-link" href={`/admin/demandes/${d.id}/`}>
                      Voir →
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <p class="footnote">
        Fiche privée, accessible uniquement aux administrateurs connectés. Les demandes placées dans la
        corbeille ne figurent pas dans l'historique.
      </p>
    </main>
    <script>
      const bouton = document.getElementById('edit-client-button');
      const formulaire = document.getElementById('edit-client-section');

      if (bouton && formulaire) {
        bouton.addEventListener('click', () => {
          const ouvrir = formulaire.hidden;

          formulaire.hidden = !ouvrir;
          bouton.setAttribute('aria-expanded', String(ouvrir));

          bouton.textContent = ouvrir ? '✕ Fermer la modification' : '✏️ Modifier la fiche client';

          if (ouvrir) {
            formulaire.scrollIntoView({
              behavior: 'smooth',
              block: 'start',
            });
          }
        });
      }
    </script>
  </body>
</html>
