---
import DevisSimpleModal from '../components/DevisSimpleModal.astro';
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Devis simple | Maison & Monde</title>
  </head>

  <body>
    <main>
      <h1>Maison & Monde</h1>
      <p>Obtenez gratuitement votre devis personnalisé.</p>

      <button type="button" data-open-devis-simple>
        Demander mon devis gratuit
      </button>
    </main>

    <DevisSimpleModal />
  </body>
</html>

<style>
  body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #eaf5ff, #ffffff);
    color: #102d57;
  }

  main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
    box-sizing: border-box;
  }

  h1 {
    font-family: Georgia, serif;
    font-size: 42px;
  }

  button {
    background: #07559c;
    color: white;
    border: none;
    border-radius: 30px;
    padding: 18px 30px;
    font-size: 17px;
    cursor: pointer;
  }
</style>