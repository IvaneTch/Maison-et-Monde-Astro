---
import '../styles/devis-simple-page.css';
import InfoPage from '../components/InfoPage.astro';
---

<InfoPage
  title="Demande de devis | Maison & Monde"
  heading="Un devis adapté à votre projet"
  description="Choisissez une demande rapide, un devis ménage détaillé ou un devis conciergerie personnalisé."
  intro="Votre demande est gratuite et sans engagement. Choisissez le parcours qui correspond à vos besoins."
>
  <div class="devis-paths">
    <section>
      <h2>Un devis rapide</h2>
      <p>Quelques coordonnées et vos prestations pour être recontacté.</p>
      <button class="sp-button mm-button" type="button" data-open-devis-simple>
        Faire une demande rapide →
      </button>
    </section>
    <section>
      <h2>Ménage et repassage</h2>
      <p>Décrivez votre logement, vos priorités et vos disponibilités.</p>
      <a class="sp-button mm-button" href="/devis-detaille/">
        Mon devis Ménage →
      </a>
    </section>
    <section>
      <h2>Conciergerie</h2>
      <p>Un parcours dédié à votre logement en location et à vos services.</p>
      <a class="sp-button mm-button" href="/conciergerie/demande-de-devis/">
        Mon devis Conciergerie →
      </a>
    </section>
  </div>
</InfoPage>
