---
import InterventionAreas from '../../components/InterventionAreas.astro';
import '../../styles/services-occasionnels.css';
import SectionBand from '../../components/SectionBand.astro';
import Layout from '../../layouts/Layout.astro';

const formules = [
  {
    id: 'ponctuel',
    nom: 'Ménage ponctuel',
    prix: '32,50 €',
    prixReduit: '16,25 €',
    description: 'Une intervention à la demande pour retrouver un intérieur impeccable.',
    image: '/images/menage-ponctuel.webp',
    prestations: [
      'Nettoyage des sols et surfaces',
      'Dépoussiérage des meubles',
      'Cuisine, salle de bain et sanitaires',
      'Remise en ordre des pièces',
      'Intervention adaptée à vos priorités',
      'Nettoyage ciblé selon vos besoins',
    ],
  },
  {
    id: 'grand-menage',
    nom: 'Grand ménage',
    prix: '34,50 €',
    prixReduit: '17,25 €',
    description: 'Un nettoyage approfondi pour les moments où votre logement en a le plus besoin.',
    image: '/images/grand-menage.paris.webp',
    prestations: [
      'Nettoyage approfondi des pièces',
      'Dégraissage des surfaces de cuisine',
      'Détartrage des sanitaires',
      'Dépoussiérage des zones accessibles',
      'Nettoyage des portes et plinthes',
      'Prestations définies selon l’état du logement',
    ],
  },
  {
    id: 'repassage',
    nom: 'Repassage à domicile',
    prix: '29,00 €',
    prixReduit: '14,50 €',
    description:
      'Confiez-nous votre linge pour un repassage soigné, directement à votre domicile, selon vos besoins.',
    image: '/images/service-repassage-domicile-paris.webp',
    prestations: [
      'Repassage des vêtements du quotidien',
      'Repassage des chemises et pantalons',
      'Repassage du linge de maison',
      'Pliage et rangement du linge',
      'Intervention ponctuelle ou complémentaire',
      'Prestations adaptées à la quantité de linge',
    ],
  },
];
---

<Layout
  title="Services de ménage occasionnels à Paris | Maison & Monde"
  description="Ménage ponctuel, grand ménage et repassage à Paris et en Île-de-France. Découvrez nos prestations occasionnelles et demandez votre devis gratuit."
>
  <div class="page-menage">
    <section class="introduction" aria-labelledby="titre-menage">
      <div class="hero-copy">
        <span class="sur-titre">MAISON &amp; MONDE</span>
        <h1 id="titre-menage">
          Ménage occasionnel
          <br />à domicile
        </h1>
        <p>
          Besoin d’un nettoyage ponctuel, d’un grand ménage ou d’un service de repassage ? Maison & Monde
          intervient à Paris et en Île-de-France selon vos besoins, sans engagement régulier.
        </p>
        <div class="hero-atouts" aria-label="Nos engagements">
          <span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z" />
            </svg>{' '}
            Un intérieur
            <br />
            plus sain
          </span>
          <span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 4C10 4 4 9 4 16a4 4 0 0 0 4 4c7 0 12-6 12-16Z" />
              <path d="M4 21c3-7 7-10 12-13" />
            </svg>{' '}
            Plus de temps
            <br />
            pour vous
          </span>
          <span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
            </svg>{' '}
            Un service
            <br />
            de confiance
          </span>
        </div>
      </div>
      <div class="hero-visual">
        <img
          src="/images/menage-ponctuel-salon-paris.webp"
          alt="Intervenante Maison & Monde effectuant un ménage occasionnel dans un appartement parisien"
          width="996"
          height="514"
          fetchpriority="high"
          srcset="/images/menage-ponctuel-salon-paris-480.webp 480w, /images/menage-ponctuel-salon-paris-960.webp 960w, /images/menage-ponctuel-salon-paris.webp 996w"
          sizes="(max-width: 780px) 100vw, 50vw"
        />
      </div>
    </section>

    <div class="vague-hero" aria-hidden="true"></div>

    <section class="section-formules">
      <div class="section-titre">
        <span class="sur-titre">DES INTERVENTIONS ADAPTÉES À VOS BESOINS</span>
        <h2>Nos services occasionnels</h2>
        <p>Cliquez sur un service pour découvrir les prestations proposées.</p>
      </div>

      <div class="grille-formules">
        {formules.map((formule) => (
          <article class="carte-formule" data-formule={formule.id}>
            <div class="carte-contenu">
              <div class="carte-face">
                {formule.id === 'grand-menage' && <span class="badge-choix">✦ Nettoyage approfondi</span>}
                <img
                  class="photo-formule"
                  src={formule.image}
                  alt={`Intérieur soigné illustrant la ${formule.nom.toLowerCase()}`}
                  width="240"
                  height="240"
                  loading="lazy"
                />

                <h3>{formule.nom}</h3>

                <p class="description">{formule.description}</p>
                <ul class="prestations-apercu">
                  {formule.prestations.slice(0, 5).map((prestation) => (
                    <li>
                      <span aria-hidden="true">✓</span>
                      {prestation}
                    </li>
                  ))}
                </ul>

                <div class="tarif">
                  <span class="tarif-label">Tarif horaire TTC</span>
                  <strong class="tarif-devis">{formule.prix} / h</strong>
                </div>

                <div class="credit-impot">
                  <span>Avec le crédit d’impôt de 50 %*</span>
                  <strong class="credit-texte">
                    {formule.prixReduit}
                    <small> / heure</small>
                  </strong>
                </div>

                <button
                  type="button"
                  class="bouton-decouvrir mm-button"
                  aria-expanded="false"
                  aria-controls={`prestations-${formule.id}`}
                >
                  Découvrir la prestation
                  <span aria-hidden="true">↓</span>
                </button>
              </div>

              <div class="carte-details" id={`prestations-${formule.id}`}>
                <h3>{formule.nom}</h3>

                <p>Prestations possibles :</p>

                <ul>
                  {formule.prestations.map((prestation) => (
                    <li>
                      <span class="check" aria-hidden="true">
                        ✓
                      </span>
                      {prestation}
                    </li>
                  ))}
                </ul>

                <a class="bouton-choisir mm-button" href={`/devis-detaille/?service=${formule.id}`}>
                  Demander un devis
                  <span aria-hidden="true">→</span>
                </a>

                <button type="button" class="bouton-retour mm-button mm-button--navy">
                  ← Retour
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>

      <p class="mention-fiscale">
        * Crédit d’impôt de 50 % selon les conditions d’éligibilité prévues par la réglementation en vigueur.
      </p>
    </section>
    <SectionBand theme="occasionnel" className="avantages-section" />

    <section class="avantages" aria-labelledby="titre-avantages">
      <h2 id="titre-avantages">
        <span>Pourquoi choisir Maison &amp; Monde ?</span>
      </h2>
      <div class="avantages-grille">
        <div>
          <span class="avantage-icone">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6 3h12l5 7-11 12L1 10l5-7Z" />
              <path d="M1 10h22M6 3l3 7 3 12 3-12 3-7" />
            </svg>
          </span>
          <p>
            <strong>Intervenantes expérimentées</strong>
            <small>Des professionnelles de confiance</small>
          </p>
        </div>
        <div>
          <span class="avantage-icone">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 2 20 5v6c0 5.4-3.4 9-8 11-4.6-2-8-5.6-8-11V5l8-3Z" />
              <path d="m8 12 2.7 2.7L16.5 9" />
            </svg>
          </span>
          <p>
            <strong>Service fiable et sécurisé</strong>
            <small>Un suivi personnalisé de vos prestations</small>
          </p>
        </div>
        <div>
          <span class="avantage-icone">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 4C10 4 4 9 4 16a4 4 0 0 0 4 4c7 0 12-6 12-16Z" />
              <path d="M4 21c3-7 7-10 12-13" />
            </svg>
          </span>
          <p>
            <strong>Produits de qualité et respectueux</strong>
            <small>Pour un intérieur sain et agréable</small>
          </p>
        </div>
        <div>
          <span class="avantage-icone">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="M12 6v6l4 2" />
            </svg>
          </span>
          <p>
            <strong>Horaires flexibles</strong>
            <small>Selon vos besoins et votre mode de vie</small>
          </p>
        </div>
      </div>
    </section>

    <section class="bandeau-devis" aria-labelledby="titre-devis">
      <div class="bandeau-photo">
        <img
          src="/images/grand-menage-salle-de-bain-paris.webp"
          alt="Salle de bain haut de gamme impeccablement nettoyée à Paris"
          loading="lazy"
          width="1600"
          height="895"
          srcset="/images/grand-menage-salle-de-bain-paris-480.webp 480w, /images/grand-menage-salle-de-bain-paris-960.webp 960w, /images/grand-menage-salle-de-bain-paris.webp 1600w"
          sizes="(max-width: 780px) 100vw, 50vw"
        />
      </div>
      <div class="bandeau-texte">
        <h2 id="titre-devis">
          Un nettoyage ponctuel,
          <br />
          un intérieur impeccable
        </h2>
        <p>Une intervention adaptée à vos besoins, avec un devis gratuit et sans engagement.</p>
        <a class="mm-button" href="/demande-de-devis/">
          Demander un devis <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="ornement-devis" aria-hidden="true"></div>
    </section>
  </div>
  <InterventionAreas />
</Layout>

<script>
  const cartes = document.querySelectorAll<HTMLElement>('.carte-formule');

  cartes.forEach((carte) => {
    const ouvrir = carte.querySelector<HTMLButtonElement>('.bouton-decouvrir');
    const fermer = carte.querySelector<HTMLButtonElement>('.bouton-retour');

    const afficherDetails = () => {
      carte.classList.add('ouverte');
      ouvrir?.setAttribute('aria-expanded', 'true');
    };

    const masquerDetails = () => {
      carte.classList.remove('ouverte');
      ouvrir?.setAttribute('aria-expanded', 'false');
    };

    ouvrir?.addEventListener('click', afficherDetails);
    fermer?.addEventListener('click', masquerDetails);
  });
</script>
