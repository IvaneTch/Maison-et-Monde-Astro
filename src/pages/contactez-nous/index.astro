---
import '../../styles/contactez-nous.css';
import SectionBand from '../../components/SectionBand.astro';
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import Icon from '../../components/ConciergerieIcon.astro';
import { entreprise, bureaux } from '../../data/entreprise';
import '../../styles/services.css';
---

<Layout
  title="Contactez Maison & Monde | Paris et Île-de-France"
  description="Contactez Maison & Monde pour votre ménage, repassage, nettoyage professionnel ou projet de conciergerie. Téléphone, e-mail et demande de rappel."
>
  <div class="sp contact-page">
    <section class="sp-hero">
      <div class="sp-copy">
        <p class="sp-eyebrow">UN PREMIER ÉCHANGE, EN TOUTE SIMPLICITÉ</p>
        <h1>
          Parlons de
          <br />
          <em>votre projet.</em>
        </h1>
        <p>
          Une question, un besoin ponctuel ou un accompagnement régulier ? Notre équipe est à votre écoute.
        </p>
        <div class="sp-trust">
          <span>
            <Icon name="phone" />
            {entreprise.horaires}
          </span>
          <span>
            <Icon name="pin" />
            {entreprise.zone}
          </span>
        </div>
      </div>
      <div class="sp-visual">
        <img
          src="/images/hero-devis-detaille.webp"
          alt="Préparation d’une demande de service dans un appartement parisien"
          width="1586"
          height="992"
          fetchpriority="high"
          srcset="/images/hero-devis-detaille-480.webp 480w, /images/hero-devis-detaille-960.webp 960w, /images/hero-devis-detaille.webp 1586w"
          sizes="(max-width: 780px) 100vw, 50vw"
        />
        <span class="sp-orbit" aria-hidden="true"></span>
      </div>
    </section>
    <SectionBand theme="contact" />

    <section class="sp-section">
      <div class="sp-wrap contact-layout">
        <aside class="contact-details">
          <p class="sp-eyebrow">MAISON & MONDE</p>
          <h2>
            À votre écoute,
            <br />
            <em>près de chez vous.</em>
          </h2>
          <div>
            <Icon name="phone" />
            <h3>Appelez-nous</h3>
            <a href="tel:+33980386848">{entreprise.telephone}</a>
            <a href="tel:+33745292585">{entreprise.mobile}</a>
            <p>{entreprise.horaires}</p>
          </div>
          {bureaux.map((bureau) => (
            <div>
              <Icon name="pin" />
              <h3>{bureau.nom}</h3>
              <p>
                {bureau.adresse}
                <br />
                {bureau.codePostal} {bureau.ville}
              </p>
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${bureau.adresse} ${bureau.codePostal} ${bureau.ville}`)}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                Voir l’itinéraire ↗
              </a>
            </div>
          ))}
          <p>Contactez-nous pour convenir d’un échange avant de vous déplacer dans nos bureaux.</p>
          <div>
            <h3>Écrivez-nous</h3>
            <a href={`mailto:${entreprise.email}`}>{entreprise.email}</a>
          </div>
          <p>
            Pour décrire votre logement, utilisez le <a href="/devis-detaille/">devis Ménage</a> ou le{' '}
            <a href="/conciergerie/demande-de-devis/">devis Conciergerie</a>. Les entreprises peuvent{' '}
            <a href="/devis-professionnel/">demander un devis professionnel dédié</a>.
          </p>
        </aside>
        <div class="contact-panel">
          <p class="sp-eyebrow">VOTRE MESSAGE</p>
          <h2>
            Comment pouvons-nous <em>vous aider ?</em>
          </h2>
          <p>Les champs marqués d’un * sont obligatoires.</p>
          <ContactForm />
        </div>
      </div>
    </section>
  </div>
</Layout>
