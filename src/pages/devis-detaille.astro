<script is:inline>
  (() => {
    const correspondances = {
      'ponctuel': ['Ménage ponctuel', 'Ménage à domicile'],
      'grand-menage': ['Grand ménage', 'Grand nettoyage'],
      'vitres': ['Nettoyage des vitres', 'Nettoyage de vitres']
    };
    const service = new URLSearchParams(window.location.search).get('service');
    if (!service || !Object.prototype.hasOwnProperty.call(correspondances, service)) return;
    const [nom, caseACocher] = correspondances[service];
    const champ = document.getElementById('prestation-souhaitee');
    const message = document.getElementById('prestation-selectionnee');
    if (champ) champ.value = nom;
    if (message) { message.textContent = 'Prestation sélectionnée : ' + nom; message.hidden = false; }
    const input = [...document.querySelectorAll('input[name="services"]')].find(el => el.value === caseACocher);
    if (input) { input.checked = true; input.dispatchEvent(new Event('change', { bubbles: true })); }
    const ponctuelle = document.querySelector('input[name="type_prestation"][value="Ponctuelle"]');
    if (ponctuelle) { ponctuelle.checked = true; ponctuelle.dispatchEvent(new Event('change', { bubbles: true })); }
  })();
</script>
<script is:inline>
(()=>{const form=document.querySelector('#quote-form');if(!form)return;const sections=[...form.querySelectorAll('[data-step]')],completed=document.querySelector('#completed');let step=1;const names=['Votre logement','Vos prestations','Fréquence et durée','Vos disponibilités','Vos coordonnées'];const checked=(name)=>[...form.querySelectorAll(`[name="${name}"]:checked`)].map(x=>x.value);const val=(name)=>form.elements.namedItem(name)?.value||'';
function validate(n){const section=sections[n-1];if(n===2&&!checked('services').length){alert('Choisissez au moins une prestation.');return false}if(n===3){if(!checked('type_prestation').length){alert('Choisissez le type de prestation.');return false}if(val('type_prestation')==='Régulière'&&!checked('frequence').length){alert('Choisissez une fréquence.');return false}}if(n===4&&!checked('disponibilites').length){alert('Choisissez au moins un créneau.');return false}for(const input of section.querySelectorAll('input,select,textarea')){if(input.closest('[hidden]'))continue;if(input.type==='radio'){if(input.required&&!checked(input.name).length){alert('Merci de compléter les champs obligatoires.');return false}continue}if(!input.checkValidity()){input.reportValidity();return false}}return true}
function summary(n){if(n===1)return [val('logement'),val('surface')+' m²',val('pieces')+' pièces',checked('animaux')[0]==='Oui'?'Animaux : '+checked('type_animaux').join(', '):'Sans animaux'].filter(Boolean).join(' · ');if(n===2)return checked('services').join(', ');if(n===3)return [val('type_prestation'),val('type_prestation')==='Régulière'?val('frequence'):'',val('duree')].filter(Boolean).join(' · ');if(n===4)return checked('disponibilites').join(', ');return ''}
function show(n){step=n;sections.forEach((s,i)=>s.hidden=i!==n-1);completed.innerHTML='';for(let i=1;i<n;i++){const row=document.createElement('div');row.className='completed-row';const strong=document.createElement('strong');strong.textContent='✓ '+names[i-1];const detail=document.createElement('span');detail.textContent=summary(i);const btn=document.createElement('button');btn.type='button';btn.textContent='Modifier';btn.addEventListener('click',()=>show(i));row.append(strong,detail,btn);completed.append(row)}document.querySelector('#progress-fill').style.width=n*20+'%';document.querySelector('#progress-label').textContent='Étape '+n+' sur 5';document.querySelector('#progress-name').textContent=names[n-1];document.querySelector('.quote-wrap').scrollIntoView({behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'})}
form.querySelectorAll('.next').forEach(b=>b.addEventListener('click',()=>{if(validate(step))show(step+1)}));form.querySelectorAll('.back').forEach(b=>b.addEventListener('click',()=>show(step-1)));form.querySelectorAll('[name="animaux"]').forEach(r=>r.addEventListener('change',()=>document.querySelector('#animal-details').hidden=val('animaux')!=='Oui'));form.querySelectorAll('[name="type_prestation"]').forEach(r=>r.addEventListener('change',()=>document.querySelector('#frequency-field').hidden=val('type_prestation')!=='Régulière'));
form.addEventListener('submit',async e=>{e.preventDefault();if(!validate(5))return;const button=form.querySelector('button[type=submit]');button.disabled=true;const oldLabel=button.textContent;button.textContent='Enregistrement…';try{const data=new FormData(form);
const prestation=new URLSearchParams(window.location.search).get('service')||'';
data.set('prestation_souhaitee',prestation);const response=await fetch('/api/devis',{method:'POST',body:data});const result=await response.json();if(!response.ok||!result.ok)throw new Error(result.error||'Enregistrement impossible.');const labels={'ponctuel':'Ménage ponctuel','grand-menage':'Grand ménage','vitres':'Nettoyage des vitres'};document.querySelector('#success-service').textContent=labels[prestation]||'Devis personnalisé';document.querySelector('#success-reference').textContent=result.reference||'—';form.hidden=true;document.querySelector('#quote-result').hidden=false;document.querySelector('#quote-result').scrollIntoView({behavior:'smooth'});}catch(error){alert(error.message||'Erreur de connexion. Veuillez réessayer.');}finally{button.disabled=false;button.textContent=oldLabel;}});})();
</script>
