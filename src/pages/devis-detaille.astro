/* Réseaux sociaux : quatre icônes homogènes */
.footer-social {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
}
.footer-social a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 44px;
  width: 44px;
  height: 44px;
  border: 1.5px solid #e9a34c;
  border-radius: 50%;
  color: #ffffff;
  text-decoration: none;
  transition: background-color .2s ease, color .2s ease, transform .2s ease;
}
.footer-social a:hover,
.footer-social a:focus-visible {
  background: #e9a34c;
  color: #071b30;
  transform: translateY(-2px);
}
.footer-social svg {
  display: block;
  width: 23px;
  height: 23px;
  flex-shrink: 0;
}

/* Carrousel principal Maison & Monde */
.hero .hero-slides{position:absolute;inset:0;z-index:-1;overflow:hidden}
.hero .hero-slide{position:absolute;inset:0;background-size:cover;background-position:center;opacity:0;transition:opacity 1s ease}
.hero .hero-slide.is-active{opacity:1}
.hero .hero-slides::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,25,45,.98) 0%,rgba(5,25,45,.92) 27%,rgba(5,25,45,.66) 52%,rgba(5,25,45,.12) 100%);pointer-events:none}
.hero .hero-arrow{position:absolute;z-index:5;top:49%;transform:translateY(-50%);height:44px;width:44px;border:1px solid rgba(255,255,255,.75);border-radius:50%;background:rgba(5,25,45,.6);color:#fff;font-size:32px;cursor:pointer;display:flex;align-items:center;justify-content:center;line-height:1}
.hero .hero-arrow-prev{left:16px}.hero .hero-arrow-next{right:16px}
.hero .hero-arrow:hover{background:#e9a34c;color:#071b30}
.hero .hero-dots{position:absolute;z-index:5;bottom:31px;left:50%;transform:translateX(-50%);display:flex;gap:10px}
.hero .hero-dots button{width:10px;height:10px;padding:0;border:0;border-radius:50%;background:rgba(255,255,255,.55);cursor:pointer}
.hero .hero-dots button.is-active{background:#e9a34c}
@media(max-width:768px){.hero .hero-arrow{width:32px;height:32px;font-size:24px;top:auto;bottom:74px;transform:none}.hero .hero-arrow-prev{left:8px}.hero .hero-arrow-next{right:8px}.hero .hero-dots{bottom:22px}.hero .hero-slide{background-position:58% center}}
@media(prefers-reduced-motion:reduce){.hero .hero-slide{transition:none}}

/* NOS PRESTATIONS — photo intégrée, texte protégé et transition douce (ordinateur) */
@media (min-width: 1001px) {
  .services-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  /* La photo commence dans la colonne centrale, sans recouvrir le texte. */
  .services-section::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: url('/images/femme-de-menage-professionnelle-paris-ile-de-france-maison-et-monde.jpg')
                71% 51% / 59% auto no-repeat;
    -webkit-mask-image: linear-gradient(to right, transparent 29%, rgba(0,0,0,.15) 38%, #000 53%, #000 89%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 29%, rgba(0,0,0,.15) 38%, #000 53%, #000 89%, transparent 100%);
  }

  /* Voile crème pour garantir une parfaite lisibilité du texte. */
  .services-section::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(to right,
      #faf8f3 0%, #faf8f3 29%,
      rgba(250,248,243,.98) 34%,
      rgba(250,248,243,.70) 40%,
      rgba(250,248,243,0) 54%);
  }

  .services-section .services-image {
    background: none;
    min-height: 360px;
    z-index: 2;
  }
  .services-section .services-text,
  .services-section .services-list {
    position: relative;
    z-index: 3;
  }
  .services-section .services-blue-curve { z-index: 4; }
}
/* Correction iPad horizontal : section À propos */
@media (min-width: 769px) and (max-width: 1199px) {
  .about-section {
    min-height: 520px;
  }

  .about-content {
    max-width: 38%;
    position: relative;
    z-index: 3;
  }

  .about-content h2 {
    font-size: clamp(26px, 3vw, 36px);
  }

  .about-content p {
    font-size: 14px;
    line-height: 1.6;
  }
}

/* Première section : hauteur adaptée aux écrans d'ordinateur */
@media (min-width: 1200px) {
  .hero {
    min-height: calc(100svh - 88px);
    padding-top: 70px;
    padding-bottom: 70px;
  }
}

/* Hauteur stable du carrousel sur mobile */
@media (max-width: 680px) {
  .hero {
    height: 690px;
    min-height: 690px;
    box-sizing: border-box;
  }

  .hero-slides,
  .hero-slide {
    height: 100%;
  }
}


