  <script is:inline>
    (() => {
      const correspondances = {
        ponctuel: ['Ménage ponctuel', 'Ménage à domicile'],
        'grand-menage': ['Grand ménage', 'Grand nettoyage'],
        vitres: ['Nettoyage des vitres', 'Nettoyage de vitres'],
        test: ['Formule Test', 'Ménage à domicile'],
        repassage: ['Repassage à domicile', 'Repassage'],
      };
      const params = new URLSearchParams(window.location.search);
      const secteurPostal = params.get('code_postal');
      if (/^(?:750(?:0[1-9]|1[0-9]|20)|92160)$/.test(secteurPostal || '')) {
        document.querySelector('[name=code_postal]').value = secteurPostal;
        document.querySelector('[name=ville]').value = secteurPostal === '92160' ? 'Antony' : 'Paris';
      }
      const formule = params.get('formule');
      const formules = {
        classique: 'Formule Classique',
        confort: 'Formule Confort',
        expert: 'Formule Expert',
      };
      if (formule && Object.prototype.hasOwnProperty.call(formules, formule)) {
        document.querySelector('#prestation-souhaitee').value = formules[formule];
        const message = document.querySelector('#prestation-selectionnee');
        message.textContent = 'Prestation sélectionnée : ' + formules[formule];
        message.hidden = false;
        document.querySelector('[name="services"][value="Ménage à domicile"]').checked = true;
        const reguliere = document.querySelector('[name="type_prestation"][value="Régulière"]');
        reguliere.checked = true;
        document.querySelector('#frequency-field').hidden = false;
      }
      const service = params.get('service');
      if (!service || !Object.prototype.hasOwnProperty.call(correspondances, service)) return;
      const [nom, caseACocher] = correspondances[service];
      const champ = document.getElementById('prestation-souhaitee');
      const message = document.getElementById('prestation-selectionnee');
      if (champ) champ.value = nom;
      if (message) {
        message.textContent =
          'Prestation sélectionnée : ' + (service === 'vitres' ? 'Ménage avec vitres simples' : nom);
        message.hidden = false;
      }
      const input = [...document.querySelectorAll('input[name="services"]')].find(
        (el) => el.value === caseACocher,
      );
      if (input) {
        input.checked = true;
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }
      if (service === 'vitres')
        document.querySelector('[name=services][value="Ménage à domicile"]').checked = true;
      const ponctuelle = document.querySelector('input[name="type_prestation"][value="Ponctuelle"]');
      if (ponctuelle) {
        ponctuelle.checked = true;
        ponctuelle.dispatchEvent(new Event('change', { bubbles: true }));
      }
      if (service === 'test') {
        const duree = document.querySelector('select[name="duree"]');
        if (duree) {
          const valeurs = ['3 h', '3 h 30', '4 h', '5 h', '6 h', '7 h'];
          duree.replaceChildren(
            new Option('Choisir une durée (3 à 7 h)', ''),
            ...valeurs.map((v) => new Option(v, v)),
          );
          duree.value = '';
        }
      }
    })();
  </script>
  <script is:inline>
    (() => {
      const form = document.querySelector('#quote-form');
      if (!form) return;
      const sections = [...form.querySelectorAll('[data-step]')],
        completed = document.querySelector('#completed');
      let step = 1;
      const names = [
        'Votre logement',
        'Vos prestations',
        'Fréquence et durée',
        'Vos disponibilités',
        'Vos coordonnées',
      ];
      const checked = (name) => [...form.querySelectorAll(`[name="${name}"]:checked`)].map((x) => x.value);
      const val = (name) => form.elements.namedItem(name)?.value || '';
      function clearError() {
        form.querySelectorAll('.mm-field-error').forEach((el) => el.remove());
        form.querySelectorAll('.mm-invalid').forEach((el) => el.classList.remove('mm-invalid'));
        form.querySelectorAll('[aria-invalid="true"]').forEach((el) => el.removeAttribute('aria-invalid'));
      }
      function fieldError(input, message) {
        clearError();
        const group = input.closest('fieldset') || input.closest('label') || input;
        const anchor =
          input.type === 'radio' || input.type === 'checkbox'
            ? group.querySelector('.option-grid,.choice-row') || group
            : input;
        const tip = document.createElement('div');
        tip.className = 'mm-field-error';
        tip.setAttribute('role', 'alert');
        tip.textContent = '⚠ ' + message;
        anchor.insertAdjacentElement('afterend', tip);
        if (input.type === 'radio' || input.type === 'checkbox') group.classList.add('mm-invalid');
        else input.classList.add('mm-invalid');
        input.setAttribute('aria-invalid', 'true');
        anchor.scrollIntoView({ behavior: 'smooth', block: 'center' });
        if (input.type !== 'radio' && input.type !== 'checkbox') input.focus({ preventScroll: true });
        return false;
      }
      function first(name) {
        return form.querySelector(`[name="${name}"]`);
      }
      function validate(n) {
        clearError();
        const section = sections[n - 1];
        if (n === 2 && !checked('services').length)
          return fieldError(first('services'), 'Choisissez au moins une prestation.');
        if (
          n === 2 &&
          checked('services').includes('Nettoyage de vitres') &&
          !checked('services').some((s) => ['Ménage à domicile', 'Grand nettoyage'].includes(s))
        )
          return fieldError(
            first('services'),
            'Les vitres simples sont proposées avec le ménage. Sélectionnez aussi Ménage à domicile ou Grand nettoyage.',
          );
        if (n === 3) {
          if (!checked('type_prestation').length)
            return fieldError(first('type_prestation'), 'Choisissez le type de prestation.');
          if (val('type_prestation') === 'Régulière' && !checked('frequence').length)
            return fieldError(first('frequence'), 'Choisissez une fréquence.');
          if (
            new URLSearchParams(location.search).get('service') === 'test' &&
            !['3 h', '3 h 30', '4 h', '5 h', '6 h', '7 h'].includes(val('duree'))
          )
            return fieldError(first('duree'), 'Pour la Formule Test, choisissez une durée de 3 à 7 heures.');
        }
        if (n === 4 && !checked('disponibilites').length)
          return fieldError(first('disponibilites'), 'Choisissez au moins un créneau.');
        for (const input of section.querySelectorAll('input,select,textarea')) {
          const hiddenGroup = input.closest('[hidden]');
          if (input.type === 'hidden' || (hiddenGroup && hiddenGroup !== section)) continue;
          if (input.type === 'radio' || input.type === 'checkbox') {
            if (input.required && !checked(input.name).length)
              return fieldError(input, 'Veuillez sélectionner une option.');
            continue;
          }
          if (!input.checkValidity()) {
            const message = input.validity.valueMissing
              ? 'Veuillez compléter ce champ obligatoire.'
              : input.validity.typeMismatch
                ? 'Veuillez vérifier le format de cette information.'
                : input.validity.rangeUnderflow || input.validity.rangeOverflow
                  ? 'Veuillez saisir une valeur autorisée.'
                  : 'Veuillez vérifier cette information.';
            return fieldError(input, message);
          }
        }
        return true;
      }
      form.addEventListener('input', (e) => {
        if (e.target.matches('input,select,textarea')) clearError();
      });
      form.addEventListener('change', (e) => {
        if (e.target.matches('input,select,textarea')) clearError();
      });

      function summary(n) {
        if (n === 1)
          return [
            val('logement'),
            val('surface') + ' m²',
            val('pieces') + ' pièces',
            checked('animaux')[0] === 'Oui'
              ? 'Animaux : ' + checked('type_animaux').join(', ')
              : 'Sans animaux',
          ]
            .filter(Boolean)
            .join(' · ');
        if (n === 2) return checked('services').join(', ');
        if (n === 3)
          return [
            val('type_prestation'),
            val('type_prestation') === 'Régulière' ? val('frequence') : '',
            val('duree'),
          ]
            .filter(Boolean)
            .join(' · ');
        if (n === 4) return checked('disponibilites').join(', ');
        return '';
      }
      function show(n) {
        step = n;
        sections.forEach((s, i) => (s.hidden = i !== n - 1));
        completed.innerHTML = '';
        for (let i = 1; i < n; i++) {
          const row = document.createElement('div');
          row.className = 'completed-row';
          const strong = document.createElement('strong');
          strong.textContent = '✓ ' + names[i - 1];
          const detail = document.createElement('span');
          detail.textContent = summary(i);
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = 'Modifier';
          btn.addEventListener('click', () => show(i));
          row.append(strong, detail, btn);
          completed.append(row);
        }
        document.querySelector('#progress-fill').style.width = n * 20 + '%';
        document.querySelector('#progress-label').textContent = 'Étape ' + n + ' sur 5';
        document.querySelector('#progress-name').textContent = names[n - 1];
        document.querySelector('.quote-wrap').scrollIntoView({
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
          block: 'start',
        });
      }
      form.querySelectorAll('.next').forEach((b) =>
        b.addEventListener('click', () => {
          if (validate(step)) show(step + 1);
        }),
      );
      form.querySelectorAll('.back').forEach((b) => b.addEventListener('click', () => show(step - 1)));
      form
        .querySelectorAll('[name="animaux"]')
        .forEach((r) =>
          r.addEventListener(
            'change',
            () => (document.querySelector('#animal-details').hidden = val('animaux') !== 'Oui'),
          ),
        );
      form
        .querySelectorAll('[name="type_prestation"]')
        .forEach((r) =>
          r.addEventListener(
            'change',
            () =>
              (document.querySelector('#frequency-field').hidden = val('type_prestation') !== 'Régulière'),
          ),
        );
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (step < 5) {
          if (validate(step)) show(step + 1);
          return;
        }
        for (let n = 1; n <= 5; n++) {
          if (!validate(n)) {
            show(n);
            validate(n);
            return;
          }
        }
        const button = form.querySelector('button[type=submit]');
        button.disabled = true;
        const oldLabel = button.textContent;
        button.textContent = 'Enregistrement…';
        try {
          const data = new FormData(form);
          const prestation = new URLSearchParams(window.location.search).get('service') || '';
          const champPrestation = form.querySelector('[name="prestation_souhaitee"]');
          data.set('prestation_souhaitee', champPrestation?.value || '');
          const response = await fetch('/api/devis', { method: 'POST', body: data });
          const result = await response.json();
          if (!response.ok || !result.ok) throw new Error(result.error || 'Enregistrement impossible.');
          const labels = {
            ponctuel: 'Ménage ponctuel',
            'grand-menage': 'Grand ménage',
            vitres: 'Ménage avec vitres simples',
            test: 'Formule Test',
            repassage: 'Repassage à domicile',
          };
          document.querySelector('#success-service').textContent = labels[prestation] || 'Devis personnalisé';
          document.querySelector('#success-reference').textContent = result.reference || '—';
          form.hidden = true;
          document.querySelector('#quote-result').hidden = false;
          document.querySelector('#quote-result').scrollIntoView({ behavior: 'smooth' });
        } catch (error) {
          const message = error.message || 'Erreur de connexion. Veuillez réessayer.';
          let notice = form.querySelector('.mm-submit-error');
          if (!notice) {
            notice = document.createElement('p');
            notice.className = 'mm-submit-error';
            notice.setAttribute('role', 'alert');
            form.querySelector('[data-step="5"] .actions')?.before(notice);
          }
          notice.textContent = message;
          notice.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } finally {
          button.disabled = false;
          button.textContent = oldLabel;
        }
      });
    })();
  </script>

  <!-- Maison & Monde : profondeur douce et mouvement discret (ordinateur uniquement) -->

  <script is:inline>
    // Animation d'entrée uniquement pour les blocs visibles : ne touche pas aux étapes masquées du formulaire.
    if (window.matchMedia('(min-width: 900px) and (prefers-reduced-motion: no-preference)').matches) {
      const initDepth = () => {
        const elements = document.querySelectorAll('.quote-hero-copy, .quote-hero-visual, .quote-progress');
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('mm-depth-reveal');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12 },
          );
          elements.forEach((el) => observer.observe(el));
        }
      };
      if (document.readyState === 'loading')
        document.addEventListener('DOMContentLoaded', initDepth, { once: true });
      else initDepth();
    }
  </script>

  <!-- Maison & Monde : relief cohérent des barres de progression et des récapitulatifs -->
