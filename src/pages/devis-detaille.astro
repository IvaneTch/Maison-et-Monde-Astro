---
import SectionBand from '../components/SectionBand.astro';
import '../styles/devis-menage.css';
import Layout from '../layouts/Layout.astro';
const entreprise = 'Maison & Monde';
---

<Layout
  title="Devis ménage détaillé | Maison & Monde"
  description="Décrivez votre logement, vos prestations et vos disponibilités pour un devis ménage personnalisé à Paris."
>
  <div class="quote-main">
    <svg class="quote-clip-definitions" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id="devis-hero-curve" clipPathUnits="objectBoundingBox">
          <path d="M .16 0 C -.12 .20, .00 .56, .30 .81 C .46 .96, .62 1, .82 1 L 1 1 L 1 0 Z" />
        </clipPath>
      </defs>
    </svg>
    <section class="quote-hero">
      <div class="quote-hero-copy">
        <p class="quote-eyebrow">DEMANDE DE DEVIS</p>
        <h1>
          Un devis personnalisé
          <br />
          en <em>quelques étapes</em>
        </h1>
        <p>
          Répondez à quelques questions pour nous décrire vos besoins.
          <br />
          Votre demande est gratuite et sans engagement.
        </p>
        <div class="quote-trust">
          <span>
            <svg
              class="ui-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="M12 7v5l3 2" />
            </svg>{' '}
            Rapide et simple
          </span>
          <span>
            <svg
              class="ui-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6 2h9l5 5v15H6zM15 2v5h5M9 12h8m-8 4h8" />
            </svg>{' '}
            Gratuit et sans engagement
          </span>
          <span>
            <svg
              class="ui-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m12 2 9 4v6c0 6-4 9-9 10-5-1-9-4-9-10V6z" />
              <path d="m8 12 3 3 5-6" />
            </svg>{' '}
            Devis personnalisé
          </span>
        </div>
      </div>
      <div class="quote-hero-visual">
        <img
          src="/images/hero-devis-detaille.webp"
          alt="Cliente remplissant une demande de devis sur tablette dans un appartement parisien avec vue sur Montmartre"
          srcset="/images/hero-devis-detaille-480.webp 480w, /images/hero-devis-detaille-960.webp 960w, /images/hero-devis-detaille.webp 1586w"
          sizes="(max-width: 780px) 100vw, 50vw"
          width="1586"
          height="992"
        />
      </div>
    </section>
    <SectionBand theme="devis-menage" />

    <div class="quote-wrap">
      <div class="quote-progress" aria-label="Progression du formulaire">
        <div class="progress-fill" id="progress-fill"></div>
        <span id="progress-label">Étape 1 sur 5</span>
        <span id="progress-name">Votre logement</span>
      </div>
      <div class="quote-steps" aria-hidden="true">
        <span>
          ① <small>Logement</small>
        </span>
        <span>
          ② <small>Prestations</small>
        </span>
        <span>
          ③ <small>Fréquence</small>
        </span>
        <span>
          ④ <small>Disponibilités</small>
        </span>
        <span>
          ⑤ <small>Coordonnées</small>
        </span>
      </div>
      <form id="quote-form" novalidate>
        <input type="hidden" name="prestation_souhaitee" id="prestation-souhaitee" value="" />
        <p id="prestation-selectionnee" hidden class="selected-service-message"></p>
        <div id="completed" aria-live="polite"></div>
        <section class="quote-card" data-step="1">
          <div class="card-heading">
            <span class="step-badge">1</span>
            <div>
              <h2>Votre logement</h2>
              <p>Commençons par quelques informations sur le lieu d’intervention.</p>
            </div>
          </div>
          <fieldset>
            <legend>
              Type de logement <b>*</b>
            </legend>
            <div class="option-grid four" data-choice="logement">
              <label class="option">
                <input type="radio" name="logement" value="Appartement" required />
                <span>
                  <svg
                    class="option-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="5" y="3" width="14" height="18" rx="1" />
                    <path d="M9 7h2m3 0h2M9 11h2m3 0h2M9 15h2m3 0h2M11 21v-4h3v4" />
                  </svg>
                  <small>Appartement</small>
                </span>
              </label>
              <label class="option">
                <input type="radio" name="logement" value="Maison" />
                <span>
                  <svg
                    class="option-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m3 11 9-8 9 8M5 10v11h14V10M9 21v-7h6v7" />
                  </svg>
                  <small>Maison</small>
                </span>
              </label>
              <label class="option">
                <input type="radio" name="logement" value="Bureau / local professionnel" />
                <span>
                  <svg
                    class="option-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M3 9h18l-2-6H5L3 9Zm1 0v12h16V9M9 21v-8h6v8" />
                  </svg>
                  <small>Bureau / local pro</small>
                </span>
              </label>
              <label class="option">
                <input type="radio" name="logement" value="Autre" />
                <span>
                  <svg
                    class="option-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="5" cy="12" r="1" />
                    <circle cx="12" cy="12" r="1" />
                    <circle cx="19" cy="12" r="1" />
                  </svg>
                  <small>Autre</small>
                </span>
              </label>
            </div>
          </fieldset>
          <div class="form-grid">
            <label>
              Surface exacte (m²) *
              <input name="surface" type="number" min="1" max="10000" placeholder="Ex. : 65" required />
            </label>
            <label>
              Nombre de pièces *<input name="pieces" type="number" min="1" max="100" value="2" required />
            </label>
            <label>
              Nombre de salles de bain *
              <input name="bains" type="number" min="0" max="30" value="1" required />
            </label>
            <fieldset>
              <legend>Animaux présents ? *</legend>
              <div class="choice-row">
                <label>
                  <input type="radio" name="animaux" value="Oui" required /> Oui
                </label>
                <label>
                  <input type="radio" name="animaux" value="Non" /> Non
                </label>
              </div>
            </fieldset>
          </div>
          <div id="animal-details" hidden>
            <fieldset>
              <legend>Quels animaux ?</legend>
              <div class="choice-row">
                <label>
                  <input type="checkbox" name="type_animaux" value="Chat" /> Chat
                </label>
                <label>
                  <input type="checkbox" name="type_animaux" value="Chien" /> Chien
                </label>
                <label>
                  <input type="checkbox" name="type_animaux" value="Autre" /> Autre
                </label>
              </div>
            </fieldset>
          </div>
          <aside class="quote-help">
            <div class="quote-help-photo" role="img" aria-label="Immeuble parisien élégant"></div>
            <div class="quote-help-content">
              <div class="quote-help-icon">
                <svg
                  class="ui-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m3 11 9-8 9 8M5 10v11h14V10M9 21v-7h6v7" />
                </svg>
              </div>
              <h3>Pourquoi ces informations ?</h3>
              <p>
                Elles nous permettent de vous proposer un devis précis et adapté à votre logement et à vos
                besoins.
              </p>
              <div class="help-feature">
                <svg
                  class="ui-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="5" y="3" width="14" height="18" rx="1" />
                  <path d="M9 7h2m3 0h2M9 11h2m3 0h2M9 15h2m3 0h2M11 21v-4h3v4" />
                </svg>
                <p>
                  <strong>Surface et pièces</strong>
                  <br />
                  Pour estimer le temps nécessaire à l’intervention.
                </p>
              </div>
              <div class="help-feature">
                <svg
                  class="ui-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="6" cy="8" r="1" />
                  <circle cx="11" cy="5" r="1" />
                  <circle cx="16" cy="7" r="1" />
                  <circle cx="20" cy="11" r="1" />
                  <path d="M7 17c0-3 3-5 5-5s5 2 5 5-2 4-5 3-5 0-5-3" />
                </svg>
                <p>
                  <strong>Animaux</strong>
                  <br />
                  Pour adapter nos produits et notre organisation.
                </p>
              </div>
              <div class="help-feature">
                <svg
                  class="ui-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" />
                  <circle cx="12" cy="10" r="2" />
                </svg>
                <p>
                  <strong>Votre secteur</strong>
                  <br />
                  Pour vérifier notre zone d’intervention.
                </p>
              </div>
            </div>
          </aside>
          <div class="actions">
            <button type="button" class="next mm-button">
              Continuer <span>→</span>
            </button>
          </div>
        </section>
        <section class="quote-card" data-step="2" hidden>
          <div class="card-heading">
            <span class="step-badge">2</span>
            <div>
              <h2>Vos prestations</h2>
              <p>Sélectionnez un ou plusieurs services.</p>
            </div>
          </div>
          <fieldset>
            <legend>Quels services souhaitez-vous ? *</legend>
            <div class="option-grid four services">
              <label class="option">
                <input type="checkbox" name="services" value="Ménage à domicile" />
                <span>
                  <svg
                    class="option-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m12 2 2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5Z" />
                  </svg>
                  <small>Ménage à domicile</small>
                </span>
              </label>
              <label class="option">
                <input type="checkbox" name="services" value="Repassage" />
                <span>
                  <svg
                    class="option-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M3 16h18l-3-8c-1-3-4-4-8-4H8l-2 7H3v5Zm0 0v3h18v-3M9 8h5" />
                  </svg>
                  <small>Repassage</small>
                </span>
              </label>
              <label class="option">
                <input type="checkbox" name="services" value="Nettoyage de vitres" />
                <span>
                  <svg
                    class="option-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="4" y="3" width="16" height="18" rx="1" />
                    <path d="M12 3v18M4 12h16" />
                  </svg>
                  <small>Vitres simples avec le ménage</small>
                </span>
              </label>
              <label class="option">
                <input type="checkbox" name="services" value="Canapés / textiles" />
                <span>
                  <svg
                    class="option-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4 11V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3M4 17v3m16-3v3M2 12a2 2 0 0 1 4 0v3h12v-3a2 2 0 0 1 4 0v6H2z" />
                  </svg>
                  <small>Canapés / textiles</small>
                </span>
              </label>
              <label class="option">
                <input type="checkbox" name="services" value="Grand nettoyage" />
                <span>
                  <svg
                    class="option-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m17 3-7 11M8 13l6 4-4 5-7-5z" />
                  </svg>
                  <small>Grand nettoyage</small>
                </span>
              </label>
              <label class="option">
                <input type="checkbox" name="services" value="Déménagement léger" />
                <span>
                  <svg
                    class="option-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M3 6h11v12H3zM14 10h4l3 4v4h-7M7 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4m11 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4" />
                  </svg>
                  <small>Déménagement léger</small>
                </span>
              </label>
              <label class="option">
                <input type="checkbox" name="services" value="Conciergerie" />
                <span>
                  <svg
                    class="option-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="8" cy="9" r="5" />
                    <path d="m12 12 9 9m-4-4 2-2" />
                  </svg>
                  <small>Conciergerie</small>
                </span>
              </label>
              <label class="option">
                <input type="checkbox" name="services" value="Autre demande" />
                <span>
                  <svg
                    class="option-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="5" cy="12" r="1" />
                    <circle cx="12" cy="12" r="1" />
                    <circle cx="19" cy="12" r="1" />
                  </svg>
                  <small>Autre demande</small>
                </span>
              </label>
            </div>
          </fieldset>
          <label>
            Précisions sur les prestations (facultatif)
            <textarea
              name="details_services"
              rows="3"
              placeholder="Ex. : nettoyage des vitres et encadrements, repassage de chemises…"
            ></textarea>
          </label>
          <div class="actions">
            <button type="button" class="back mm-button mm-button--navy">
              ← Retour
            </button>
            <button type="button" class="next mm-button">
              Continuer →
            </button>
          </div>
        </section>
        <section class="quote-card" data-step="3" hidden>
          <div class="card-heading">
            <span class="step-badge">3</span>
            <div>
              <h2>Fréquence et durée</h2>
              <p>Indiquez le rythme et la durée souhaités.</p>
            </div>
          </div>
          <fieldset>
            <legend>Type de prestation *</legend>
            <div class="option-grid two">
              <label class="option">
                <input type="radio" name="type_prestation" value="Régulière" required />
                <span>
                  <svg
                    class="option-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="3" y="5" width="18" height="16" rx="2" />
                    <path d="M7 3v4m10-4v4M3 10h18" />
                  </svg>
                  <small>Régulière</small>
                </span>
              </label>
              <label class="option">
                <input type="radio" name="type_prestation" value="Ponctuelle" />
                <span>
                  <svg
                    class="option-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                  </svg>
                  <small>Ponctuelle</small>
                </span>
              </label>
            </div>
          </fieldset>
          <fieldset id="frequency-field">
            <legend>Fréquence souhaitée *</legend>
            <div class="option-grid four">
              <label class="option">
                <input type="radio" name="frequence" value="Chaque semaine" />
                <span>
                  <small>Chaque semaine</small>
                </span>
              </label>
              <label class="option">
                <input type="radio" name="frequence" value="Toutes les 2 semaines" />
                <span>
                  <small>Toutes les 2 semaines</small>
                </span>
              </label>
              <label class="option">
                <input type="radio" name="frequence" value="Une fois par mois" />
                <span>
                  <small>Une fois par mois</small>
                </span>
              </label>
              <label class="option">
                <input type="radio" name="frequence" value="Autre fréquence" />
                <span>
                  <small>Autre fréquence</small>
                </span>
              </label>
            </div>
          </fieldset>
          <div class="form-grid">
            <label>
              Durée souhaitée par intervention *
              <select name="duree" required>
                <option value="">Choisir une durée</option>
                <option>1 h</option>
                <option>1 h 30</option>
                <option>2 h</option>
                <option>2 h 30</option>
                <option>3 h</option>
                <option>3 h 30</option>
                <option>4 h</option>
                <option>5 h</option>
                <option>6 h ou plus</option>
                <option>À définir ensemble</option>
              </select>
            </label>
            <label>
              Date de début souhaitée (facultatif)
              <input type="date" name="date_debut" />
            </label>
          </div>
          <div class="actions">
            <button type="button" class="back mm-button mm-button--navy">
              ← Retour
            </button>
            <button type="button" class="next mm-button">
              Continuer →
            </button>
          </div>
        </section>
        <section class="quote-card" data-step="4" hidden>
          <div class="card-heading">
            <span class="step-badge">4</span>
            <div>
              <h2>Vos disponibilités</h2>
              <p>Choisissez vos jours et créneaux préférés. Plusieurs choix possibles.</p>
            </div>
          </div>
          <div class="availability-scroll">
            <table class="availability">
              <thead>
                <tr>
                  <th>Jour</th>
                  <th>
                    Matin
                    <br />
                    <small>8 h – 12 h</small>
                  </th>
                  <th>
                    Après-midi
                    <br />
                    <small>12 h – 18 h</small>
                  </th>
                  <th>
                    Soir
                    <br />
                    <small>Après 18 h</small>
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th>Lundi</th>
                  <td>
                    <input
                      type="checkbox"
                      name="disponibilites"
                      value="Lundi matin"
                      aria-label="Lundi matin"
                    />
                  </td>
                  <td>
                    <input
                      type="checkbox"
                      name="disponibilites"
                      value="Lundi après-midi"
                      aria-label="Lundi après-midi"
                    />
                  </td>
                  <td>
                    <input type="checkbox" name="disponibilites" value="Lundi soir" aria-label="Lundi soir" />
                  </td>
                </tr>
                <tr>
                  <th>Mardi</th>
                  <td>
                    <input
                      type="checkbox"
                      name="disponibilites"
                      value="Mardi matin"
                      aria-label="Mardi matin"
                    />
                  </td>
                  <td>
                    <input
                      type="checkbox"
                      name="disponibilites"
                      value="Mardi après-midi"
                      aria-label="Mardi après-midi"
                    />
                  </td>
                  <td>
                    <input type="checkbox" name="disponibilites" value="Mardi soir" aria-label="Mardi soir" />
                  </td>
                </tr>
                <tr>
                  <th>Mercredi</th>
                  <td>
                    <input
                      type="checkbox"
                      name="disponibilites"
                      value="Mercredi matin"
                      aria-label="Mercredi matin"
                    />
                  </td>
                  <td>
                    <input
                      type="checkbox"
                      name="disponibilites"
                      value="Mercredi après-midi"
                      aria-label="Mercredi après-midi"
                    />
                  </td>
                  <td>
                    <input
                      type="checkbox"
                      name="disponibilites"
                      value="Mercredi soir"
                      aria-label="Mercredi soir"
                    />
                  </td>
                </tr>
                <tr>
                  <th>Jeudi</th>
                  <td>
                    <input
                      type="checkbox"
                      name="disponibilites"
                      value="Jeudi matin"
                      aria-label="Jeudi matin"
                    />
                  </td>
                  <td>
                    <input
                      type="checkbox"
                      name="disponibilites"
                      value="Jeudi après-midi"
                      aria-label="Jeudi après-midi"
                    />
                  </td>
                  <td>
                    <input type="checkbox" name="disponibilites" value="Jeudi soir" aria-label="Jeudi soir" />
                  </td>
                </tr>
                <tr>
