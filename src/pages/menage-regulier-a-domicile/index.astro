---
import '../../styles/menage-regulier-a-domicile.css';
import SectionBand from '../../components/SectionBand.astro';
import Layout from '../../layouts/Layout.astro';

const formules = [
  {
    id: 'classique',
    nom: 'Formule Classique',
    prix: '29,00 €',
    prixReduit: '14,50 €',
    description: 'L’essentiel pour un intérieur propre et agréable.',
    image: '/images/menage-appartement-paris-salon.webp',
    prestations: [
      'Entretien des sols',
      'Dépoussiérage des surfaces',
      'Nettoyage des salles de bains et WC',
      'Nettoyage et désinfection de la cuisine',
      'Remise en place des coussins et plaids',
      'Faire les lits',
      'Repassage rapide',
      'Étendre et plier le linge',
    ],
  },
  {
    id: 'confort',
    nom: 'Formule Confort',
    prix: '31,00 €',
    prixReduit: '15,50 €',
    description: 'Un entretien complet pour davantage de tranquillité.',
    image: '/images/nettoyage-chambre-domicile-paris.webp',
    prestations: [
      'Toutes les prestations de la formule Classique',
      'Entretien des appareils électroménagers',
      'Rangement des objets et des livres',
      'Nettoyage des vitres et encadrements',
      'Chargement et mise en route du lave-vaisselle',
      'Arrosage des plantes',
      'Repassage soigné',
      'Changement du linge de maison',
    ],
  },
  {
    id: 'expert',
    nom: 'Formule Expert',
    prix: '35,00 €',
    prixReduit: '17,50 €',
    description: 'Notre formule la plus complète, adaptée aux besoins exigeants.',
    image: '/images/nettoyage-salle-de-bain-paris.webp',
    prestations: [
      'Toutes les prestations de la formule Confort',
      'Gestion complète du linge',
      'Rangement des placards et tiroirs',
      'Entretien des terrasses',
      'Petits travaux de couture',
      'Courses et rangement des courses',
      'Entretien des espaces des animaux',
      'Prestations personnalisées selon vos besoins',
    ],
  },
];
---

<Layout title="Ménage régulier à domicile | Maison & Monde">
  <div class="page-menage">
    <section class="introduction" aria-labelledby="titre-menage">
      <div class="hero-copy">
        <span class="sur-titre">MAISON &amp; MONDE</span>
        <h1 id="titre-menage">
          Ménage régulier
          <br />à domicile
        </h1>
        <p>
          Profitez d’un intérieur propre et accueillant grâce à nos prestations de ménage régulier à Paris et
          en Île-de-France. Découvrez nos trois formules adaptées à vos besoins.
        </p>
        <div class="hero-atouts" aria-label="Nos engagements">
          <span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z" />
            </svg>{' '}
            Un intérieur
            <br />
            plus sain
          </span>
          <span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 4C10 4 4 9 4 16a4 4 0 0 0 4 4c7 0 12-6 12-16Z" />
              <path d="M4 21c3-7 7-10 12-13" />
            </svg>{' '}
            Plus de temps
            <br />
            pour vous
          </span>
          <span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
            </svg>{' '}
            Un service
            <br />
            de confiance
          </span>
        </div>
      </div>
      <div class="hero-visual">
        <img
          src="/images/femme-de-menage-domicile-paris.webp"
          alt="Intervenante Maison & Monde réalisant un ménage régulier dans un appartement parisien"
          width="1000"
          height="700"
          fetchpriority="high"
          srcset="/images/femme-de-menage-domicile-paris-480.webp 480w, /images/femme-de-menage-domicile-paris-960.webp 960w, /images/femme-de-menage-domicile-paris.webp 1600w"
          sizes="(max-width: 780px) 100vw, 50vw"
        />
      </div>
    </section>

    <div class="vague-hero" aria-hidden="true"></div>

    <section class="section-formules">
      <div class="section-titre">
        <span class="sur-titre">DES SERVICES ADAPTÉS À VOTRE QUOTIDIEN</span>
        <h2>Nos formules de ménage</h2>
        <p>Survolez une formule ou cliquez dessus pour découvrir les prestations incluses.</p>
      </div>

      <div class="grille-formules">
        {formules.map((formule) => (
          <article class="carte-formule" data-formule={formule.id}>
            <div class="carte-contenu">
              <div class="carte-face">
                {formule.id === 'confort' && <span class="badge-choix">♛ Le plus choisi</span>}
                <img
                  class="photo-formule"
                  src={formule.image}
                  alt={`Intérieur soigné illustrant la ${formule.nom.toLowerCase()}`}
                  width="240"
                  height="240"
                  loading="lazy"
                />

                <h3>{formule.nom}</h3>

                <p class="description">{formule.description}</p>
                <ul class="prestations-apercu">
                  {formule.prestations.slice(0, 5).map((prestation) => (
                    <li>
                      <span aria-hidden="true">✓</span>
                      {prestation}
                    </li>
                  ))}
                </ul>

                <div class="tarif">
                  <span class="tarif-label">À partir de</span>
                  <strong>
                    {formule.prix}
                    <small>/heure</small>
                  </strong>
                </div>

                <div class="credit-impot">
                  <span>Avec le crédit d’impôt de 50 %</span>
                  <strong>
                    {formule.prixReduit}
                    <small>/heure</small>
                  </strong>
                </div>

                <button
                  type="button"
                  class="bouton-decouvrir"
                  aria-expanded="false"
                  aria-controls={`prestations-${formule.id}`}
                >
                  Voir toutes les prestations
                  <span aria-hidden="true">↓</span>
                </button>
              </div>

              <div class="carte-details" id={`prestations-${formule.id}`}>
                <h3>{formule.nom}</h3>

                <p>Prestations incluses :</p>

                <ul>
                  {formule.prestations.map((prestation) => (
                    <li>
                      <span class="check" aria-hidden="true">
                        ✓
                      </span>
                      {prestation}
                    </li>
                  ))}
                </ul>

                <a class="bouton-choisir" href={`/devis-detaille/?formule=${formule.id}`}>
                  Choisir cette formule
                  <span aria-hidden="true">→</span>
                </a>

                <button type="button" class="bouton-retour">
                  ← Retour
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>

      <p class="mention-fiscale">
        * Crédit d’impôt de 50 % selon les conditions d’éligibilité prévues par la réglementation en vigueur.
      </p>
    </section>
    <SectionBand theme="regulier" />

    <section class="avantages" aria-labelledby="titre-avantages">
      <h2 id="titre-avantages">
        <span>Pourquoi choisir Maison &amp; Monde ?</span>
      </h2>
      <div class="avantages-grille">
        <div>
          <span class="avantage-icone">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6 3h12l5 7-11 12L1 10l5-7Z" />
              <path d="M1 10h22M6 3l3 7 3 12 3-12 3-7" />
            </svg>
          </span>
          <p>
            <strong>Intervenantes expérimentées</strong>
            <small>Des professionnelles de confiance</small>
          </p>
        </div>
        <div>
          <span class="avantage-icone">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 2 20 5v6c0 5.4-3.4 9-8 11-4.6-2-8-5.6-8-11V5l8-3Z" />
              <path d="m8 12 2.7 2.7L16.5 9" />
            </svg>
          </span>
          <p>
            <strong>Service fiable et sécurisé</strong>
            <small>Un suivi personnalisé de vos prestations</small>
          </p>
        </div>
        <div>
          <span class="avantage-icone">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 4C10 4 4 9 4 16a4 4 0 0 0 4 4c7 0 12-6 12-16Z" />
              <path d="M4 21c3-7 7-10 12-13" />
            </svg>
          </span>
          <p>
            <strong>Produits de qualité et respectueux</strong>
            <small>Pour un intérieur sain et agréable</small>
          </p>
        </div>
        <div>
          <span class="avantage-icone">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="M12 6v6l4 2" />
            </svg>
          </span>
          <p>
            <strong>Horaires flexibles</strong>
            <small>Selon vos besoins et votre mode de vie</small>
          </p>
        </div>
      </div>
    </section>

    <section class="bandeau-devis" aria-labelledby="titre-devis">
      <div class="bandeau-photo">
        <img
          src="/images/entreprise-nettoyage-appartement-paris.webp"
          alt="Salon lumineux et soigneusement entretenu à Paris"
          loading="lazy"
          width="1000"
          height="650"
          srcset="/images/entreprise-nettoyage-appartement-paris-480.webp 480w, /images/entreprise-nettoyage-appartement-paris-960.webp 960w, /images/entreprise-nettoyage-appartement-paris.webp 1600w"
          sizes="(max-width: 780px) 100vw, 50vw"
        />
      </div>
      <div class="bandeau-texte">
        <h2 id="titre-devis">
          Un intérieur propre,
          <br />
          du temps pour l’essentiel
        </h2>
        <p>Demandez dès maintenant votre devis gratuit et sans engagement.</p>
        <a href="/demande-de-devis/">
          Demander un devis <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="ornement-devis" aria-hidden="true"></div>
    </section>
  </div>
</Layout>

<script>
  const cartes = document.querySelectorAll<HTMLElement>('.carte-formule');

  cartes.forEach((carte) => {
    const ouvrir = carte.querySelector<HTMLButtonElement>('.bouton-decouvrir');
    const fermer = carte.querySelector<HTMLButtonElement>('.bouton-retour');

    const afficherDetails = () => {
      carte.classList.add('ouverte');
      ouvrir?.setAttribute('aria-expanded', 'true');
    };

    const masquerDetails = () => {
      carte.classList.remove('ouverte');
      ouvrir?.setAttribute('aria-expanded', 'false');
    };

    ouvrir?.addEventListener('click', afficherDetails);
    fermer?.addEventListener('click', masquerDetails);
  });
</script>
