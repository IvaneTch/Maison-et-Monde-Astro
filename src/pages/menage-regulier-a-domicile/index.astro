---
import Layout from '../../layouts/Layout.astro';

const formules = [
  {
    id: 'classique',
    nom: 'Formule Classique',
    prix: '29,00 €',
    prixReduit: '14,50 €',
    description: 'L’essentiel pour un intérieur propre et agréable.',
    image: '/images/menage-appartement-paris-salon.jpg',
    prestations: [
      'Entretien des sols',
      'Dépoussiérage des surfaces',
      'Nettoyage des salles de bains et WC',
      'Nettoyage et désinfection de la cuisine',
      'Remise en place des coussins et plaids',
      'Faire les lits',
      'Repassage rapide',
      'Étendre et plier le linge'
    ]
  },
  {
    id: 'confort',
    nom: 'Formule Confort',
    prix: '31,00 €',
    prixReduit: '15,50 €',
    description: 'Un entretien complet pour davantage de tranquillité.',
    image: '/images/nettoyage-chambre-domicile-paris.jpg',
    prestations: [
      'Toutes les prestations de la formule Classique',
      'Entretien des appareils électroménagers',
      'Rangement des objets et des livres',
      'Nettoyage des vitres et encadrements',
      'Chargement et mise en route du lave-vaisselle',
      'Arrosage des plantes',
      'Repassage soigné',
      'Changement du linge de maison'
    ]
  },
  {
    id: 'expert',
    nom: 'Formule Expert',
    prix: '35,00 €',
    prixReduit: '17,50 €',
    description: 'Notre formule la plus complète, adaptée aux besoins exigeants.',
    image: '/images/nettoyage-salle-de-bain-paris.jpg',
    prestations: [
      'Toutes les prestations de la formule Confort',
      'Gestion complète du linge',
      'Rangement des placards et tiroirs',
      'Entretien des terrasses',
      'Petits travaux de couture',
      'Courses et rangement des courses',
      'Entretien des espaces des animaux',
      'Prestations personnalisées selon vos besoins'
    ]
  }
];
---

<Layout title="Ménage régulier à domicile | Maison & Monde">

  <main class="page-menage">

    <section class="introduction" aria-labelledby="titre-menage">
      <div class="hero-copy">
        <span class="sur-titre">MAISON &amp; MONDE</span>
        <h1 id="titre-menage">Ménage régulier<br />à domicile</h1>
        <p>Profitez d’un intérieur propre et accueillant grâce à nos prestations de ménage régulier à Paris et en Île-de-France. Découvrez nos trois formules adaptées à vos besoins.</p>
        <div class="hero-atouts" aria-label="Nos engagements">
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/></svg> Un intérieur<br />plus sain</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 4C10 4 4 9 4 16a4 4 0 0 0 4 4c7 0 12-6 12-16Z"/><path d="M4 21c3-7 7-10 12-13"/></svg> Plus de temps<br />pour vous</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg> Un service<br />de confiance</span>
        </div>
      </div>
      <div class="hero-visual">
        <img src="/images/femme-de-menage-domicile-paris.jpg" alt="Intervenante Maison & Monde réalisant un ménage régulier dans un appartement parisien" width="1000" height="700" fetchpriority="high" />
      </div>
    </section>

    <div class="vague-hero" aria-hidden="true"></div>

    <section class="section-formules">

      <div class="section-titre">
        <span class="sur-titre">DES SERVICES ADAPTÉS À VOTRE QUOTIDIEN</span>
        <h2>Nos formules de ménage</h2>
        <p>
          Survolez une formule ou cliquez dessus pour découvrir
          les prestations incluses.
        </p>
      </div>

      <div class="grille-formules">

        {formules.map((formule) => (

          <article class="carte-formule" data-formule={formule.id}>

            <div class="carte-contenu">

              <div class="carte-face">

                {formule.id === 'confort' && <span class="badge-choix">♛ Le plus choisi</span>}
                <img class="photo-formule" src={formule.image} alt={`Intérieur soigné illustrant la ${formule.nom.toLowerCase()}`} width="240" height="240" loading="lazy" />

                <h3>{formule.nom}</h3>

                <p class="description">{formule.description}</p>
                <ul class="prestations-apercu">
                  {formule.prestations.slice(0, 5).map((prestation) => <li><span aria-hidden="true">✓</span>{prestation}</li>)}
                </ul>

                <div class="tarif">
                  <span class="tarif-label">À partir de</span>
                  <strong>{formule.prix}<small>/heure</small></strong>
                </div>

                <div class="credit-impot">
                  <span>Avec le crédit d’impôt de 50 %</span>
                  <strong>{formule.prixReduit}<small>/heure</small></strong>
                </div>

                <button
                  type="button"
                  class="bouton-decouvrir"
                  aria-expanded="false"
                  aria-controls={`prestations-${formule.id}`}
                >
                  Voir toutes les prestations
                  <span aria-hidden="true">↓</span>
                </button>

              </div>

              <div
                class="carte-details"
                id={`prestations-${formule.id}`}
              >

                <h3>{formule.nom}</h3>

                <p>Prestations incluses :</p>

                <ul>
                  {formule.prestations.map((prestation) => (
                    <li>
                      <span class="check" aria-hidden="true">✓</span>
                      {prestation}
                    </li>
                  ))}
                </ul>

                <a
                  class="bouton-choisir"
                  href={`/devis-detaille/?formule=${formule.id}`}
                >
                  Choisir cette formule
                  <span aria-hidden="true">→</span>
                </a>

                <button type="button" class="bouton-retour">
                  ← Retour
                </button>

              </div>

            </div>

          </article>

        ))}

      </div>

      <p class="mention-fiscale">
        * Crédit d’impôt de 50 % selon les conditions d’éligibilité
        prévues par la réglementation en vigueur.
      </p>

    </section>

    <section class="avantages" aria-labelledby="titre-avantages">
      <h2 id="titre-avantages"><span>Pourquoi choisir Maison &amp; Monde ?</span></h2>
      <div class="avantages-grille">
        <div><span class="avantage-icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12l5 7-11 12L1 10l5-7Z"/><path d="M1 10h22M6 3l3 7 3 12 3-12 3-7"/></svg></span><p><strong>Intervenantes expérimentées</strong><small>Des professionnelles de confiance</small></p></div>
        <div><span class="avantage-icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 20 5v6c0 5.4-3.4 9-8 11-4.6-2-8-5.6-8-11V5l8-3Z"/><path d="m8 12 2.7 2.7L16.5 9"/></svg></span><p><strong>Service fiable et sécurisé</strong><small>Un suivi personnalisé de vos prestations</small></p></div>
        <div><span class="avantage-icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 4C10 4 4 9 4 16a4 4 0 0 0 4 4c7 0 12-6 12-16Z"/><path d="M4 21c3-7 7-10 12-13"/></svg></span><p><strong>Produits de qualité et respectueux</strong><small>Pour un intérieur sain et agréable</small></p></div>
        <div><span class="avantage-icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/></svg></span><p><strong>Horaires flexibles</strong><small>Selon vos besoins et votre mode de vie</small></p></div>
      </div>
    </section>

    <section class="bandeau-devis" aria-labelledby="titre-devis">
      <div class="bandeau-photo"><img src="/images/entreprise-nettoyage-appartement-paris.jpg" alt="Salon lumineux et soigneusement entretenu à Paris" loading="lazy" width="1000" height="650" /></div>
      <div class="bandeau-texte">
        <h2 id="titre-devis">Un intérieur propre,<br />du temps pour l’essentiel</h2>
        <p>Demandez dès maintenant votre devis gratuit et sans engagement.</p>
        <a href="/demande-de-devis/">Demander un devis <span aria-hidden="true">→</span></a>
      </div>
      <div class="ornement-devis" aria-hidden="true"></div>
    </section>

  </main>

</Layout>

<script>
  const cartes = document.querySelectorAll<HTMLElement>('.carte-formule');

  cartes.forEach((carte) => {
    const ouvrir = carte.querySelector<HTMLButtonElement>('.bouton-decouvrir');
    const fermer = carte.querySelector<HTMLButtonElement>('.bouton-retour');

    const afficherDetails = () => {
      carte.classList.add('ouverte');
      ouvrir?.setAttribute('aria-expanded', 'true');
    };

    const masquerDetails = () => {
      carte.classList.remove('ouverte');
      ouvrir?.setAttribute('aria-expanded', 'false');
    };

    ouvrir?.addEventListener('click', afficherDetails);
    fermer?.addEventListener('click', masquerDetails);
  });
</script>

<style>
  .page-menage{--navy:#092747;--gold:#efa91f;--blue:#e8f5ff;color:var(--navy);background:linear-gradient(180deg,#fff 0%,#f0f9ff 70%,#fff 100%);overflow:hidden;font-family:Arial,Helvetica,sans-serif}
  .introduction{max-width:1600px;margin:auto;display:grid;grid-template-columns:47% 53%;align-items:stretch;min-height:510px;position:relative;background:#fff}
  .hero-copy{padding:92px 20px 70px clamp(30px,7vw,125px);position:relative;z-index:2}
  .hero-copy:before{content:"";position:absolute;left:-170px;top:-120px;width:430px;height:550px;border:60px solid rgba(184,223,250,.22);border-radius:48%;pointer-events:none;z-index:-1;transform:rotate(-22deg)}
  .hero-copy:after{content:"";position:absolute;left:-70px;bottom:6px;width:190px;height:190px;border-radius:100% 0 100% 0;border:2px solid rgba(115,177,224,.35);transform:rotate(-20deg);pointer-events:none}
  .sur-titre{display:block;color:#db9419;font-size:12px;font-weight:800;letter-spacing:2px;margin-bottom:15px}
  .hero-copy h1{font-size:clamp(39px,4.3vw,65px);line-height:1.06;letter-spacing:-1.9px;margin:0 0 22px;font-weight:850;color:var(--navy)}
  .hero-copy>p{font-size:16px;color:#526c88;line-height:1.7;max-width:530px;margin:0}
  .hero-atouts{display:flex;gap:25px;margin-top:34px;justify-content:flex-start}
  .hero-atouts span{display:flex;gap:10px;align-items:center;font-size:12px;line-height:1.4;font-weight:750}
  .hero-atouts b{font-size:31px;font-weight:400;color:var(--gold)}
  .hero-visual{min-width:0;overflow:hidden;border-radius:44% 0 0 35% / 65% 0 0 40%;border-left:3px solid var(--gold);position:relative}
  .hero-visual img{display:block;width:100%;height:100%;object-fit:cover;object-position:54% center}
  .vague-hero{height:36px;position:relative;margin-top:-13px;z-index:3;pointer-events:none;background:#fff;border-bottom:2px solid var(--gold);border-radius:0 0 50% 40% / 0 0 85% 100%}
  .section-formules{padding:65px 28px 65px;background:radial-gradient(ellipse at 0% 12%,rgba(188,223,247,.40),transparent 32%),linear-gradient(180deg,#fff 0%,#edf8ff 100%);position:relative}
  .section-formules:before{content:"";position:absolute;left:-80px;top:140px;width:200px;height:280px;border-radius:50%;border:35px solid rgba(163,208,243,.18);transform:rotate(35deg);pointer-events:none}
  .section-titre{text-align:center;margin-bottom:60px;position:relative}.section-titre .sur-titre{font-size:12px;margin-bottom:12px}
  .section-titre h2{font-size:clamp(33px,3.5vw,48px);margin:0 0 14px;letter-spacing:-1px;color:var(--navy)}.section-titre p{font-size:15px;color:#5d7690;margin:0}
  .grille-formules{max-width:1260px;margin:auto;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px;align-items:stretch;position:relative}
  .carte-formule{background:#fff;border:1px solid #e0eaf3;border-radius:24px;box-shadow:0 18px 35px rgba(8,37,66,.15),0 5px 10px rgba(8,37,66,.06);transition:transform .25s,box-shadow .25s;position:relative;min-width:0}
  .carte-formule[data-formule="confort"]{border:2px solid var(--gold);box-shadow:0 20px 38px rgba(190,137,35,.17),0 5px 12px rgba(8,37,66,.08)}
  .carte-formule:hover{transform:translateY(-7px);box-shadow:0 25px 50px rgba(8,37,66,.22)}
  .carte-contenu{height:100%}.carte-face,.carte-details{padding:0 25px 27px;box-sizing:border-box;height:100%}
  .carte-face{display:flex;flex-direction:column;align-items:center;text-align:center}
  .photo-formule{width:205px;height:205px;max-width:80%;object-fit:cover;border-radius:50%;margin-top:-28px;border:5px solid #fff;box-shadow:0 6px 22px rgba(4,36,69,.15)}
  .badge-choix{position:absolute;top:-17px;right:-12px;background:linear-gradient(100deg,#ffcc5d,#efa513);color:#fff;border-radius:22px;padding:10px 18px;font-size:12px;font-weight:800;white-space:nowrap;z-index:2;box-shadow:0 4px 10px rgba(171,109,11,.22)}
  .carte-face h3{font-size:27px;letter-spacing:-.5px;margin:20px 0 10px;color:var(--navy)}
  .description{font-size:14px;color:#627993;line-height:1.5;min-height:44px;margin:0 0 20px}
  .prestations-apercu{list-style:none;text-align:left;padding:0;margin:0 0 23px;width:100%;flex:1}
  .prestations-apercu li{font-size:13px;color:#45617d;display:flex;align-items:flex-start;gap:11px;line-height:1.5;margin:11px 0}
  .prestations-apercu li span{background:var(--gold);color:white;display:inline-grid;place-items:center;flex-shrink:0;width:18px;height:18px;border-radius:50%;font-size:11px;font-weight:800}
  .tarif{display:flex;flex-direction:column;gap:3px;margin:9px 0 15px}.tarif-label{font-size:13px;color:#627993}.tarif strong{font-size:33px;color:var(--navy)}.tarif small,.credit-impot small{font-size:12px;font-weight:500}
  .credit-impot{background:#e2f2ff;border-radius:13px;padding:15px 10px;width:100%;box-sizing:border-box}
  .credit-impot span{display:block;color:#207cc5;font-size:12px;margin-bottom:6px}.credit-impot strong{font-size:29px;color:#0878c9;display:block}
  .bouton-decouvrir{width:100%;margin-top:15px;background:#07294c;color:white;border:0;border-radius:30px;padding:15px 10px;font-weight:800;font-size:13px;cursor:pointer;box-shadow:0 4px 9px rgba(8,37,66,.1)}
  .carte-formule[data-formule="confort"] .bouton-decouvrir{background:linear-gradient(90deg,#efac25,#ffca57);color:#17314d}
  .bouton-decouvrir span{margin-left:5px}.carte-details{display:none;padding:33px 25px;text-align:left}
  .carte-details h3{font-size:26px;margin:0 0 9px}.carte-details>p{color:#66778b;font-size:14px}
  .carte-details ul{padding:0;list-style:none;margin:23px 0}.carte-details li{display:flex;gap:11px;font-size:14px;line-height:1.5;margin:12px 0;color:#536b80}.check{color:#d69a32;font-weight:900}
  .bouton-choisir{display:flex;justify-content:center;gap:10px;background:#f3b747;color:#092b4d;text-decoration:none;padding:14px;border-radius:26px;font-size:13px;font-weight:800}
  .bouton-retour{display:block;margin:20px auto 0;background:none;border:0;color:#56728e;cursor:pointer}
  .carte-formule.ouverte .carte-face{display:none}.carte-formule.ouverte .carte-details{display:block}
  .mention-fiscale{text-align:center;color:#708298;font-size:12px;margin:29px auto 0}
  .avantages{max-width:1300px;margin:15px auto 55px;background:#fff;border-radius:90px;padding:45px 60px 55px;box-shadow:0 12px 45px rgba(10,48,78,.06)}
  .avantages h2{text-align:center;font-size:28px;margin:0 0 40px;display:flex;gap:22px;align-items:center;justify-content:center;color:var(--navy)}
  .avantages h2:before,.avantages h2:after{content:"";display:block;width:52px;height:2px;background:var(--gold)}
  .avantages-grille{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px}
  .avantages-grille>div{display:flex;flex-direction:column;align-items:center;text-align:center;gap:12px;padding:0 16px;border-right:1px solid #e4eef7}.avantages-grille>div:last-child{border-right:0}
  .avantages-grille>div>span{width:72px;height:72px;display:grid;place-items:center;flex-shrink:0;background:#e8f5ff;border-radius:50%;color:#2682d1;font-size:40px}
  .avantages-grille p{margin:3px 0}.avantages-grille strong{font-size:16px;line-height:1.35;display:block}.avantages-grille small{display:block;color:#74849a;font-size:13px;line-height:1.5;margin-top:10px}
  .bandeau-devis{max-width:1440px;margin:0 auto 55px;display:grid;grid-template-columns:54% 46%;align-items:center;min-height:330px;background:#fff;position:relative;border-radius:70px;overflow:hidden;box-shadow:0 10px 30px rgba(12,54,87,.05)}
  .bandeau-photo{height:330px;overflow:hidden;position:relative}.bandeau-photo:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent 58%,white)}.bandeau-photo img{width:100%;height:100%;object-fit:cover}
  .bandeau-texte{padding:35px 70px 35px 10px;position:relative;z-index:2}.bandeau-texte h2{font-size:clamp(28px,3vw,41px);line-height:1.15;margin:0 0 15px}.bandeau-texte p{font-size:16px;color:#61748b;max-width:430px;line-height:1.5}.bandeau-texte a{display:inline-flex;gap:16px;align-items:center;background:linear-gradient(90deg,#efaa1c,#ffca51);border-radius:30px;padding:16px 32px;text-decoration:none;font-size:14px;font-weight:800;color:#092b4d;margin-top:12px}
  .ornement-devis{position:absolute;right:-90px;bottom:-105px;width:260px;height:280px;border:38px solid rgba(150,207,247,.30);border-radius:50%;transform:rotate(-25deg);pointer-events:none}
  .bandeau-devis:after{content:"";position:absolute;inset:auto -2% 0 -2%;height:22px;border-bottom:2px solid var(--gold);border-radius:50%;pointer-events:none}
  @media(max-width:1050px){.hero-copy{padding:70px 20px 50px 35px}.hero-atouts{gap:12px;flex-wrap:wrap}.grille-formules{gap:18px}.carte-face{padding:0 16px 22px}.photo-formule{width:170px;height:170px}.carte-face h3{font-size:23px}.avantages{border-radius:40px;padding:30px}.avantages-grille{grid-template-columns:repeat(2,1fr)}.avantages-grille>div:nth-child(2){border-right:0}}
  @media(max-width:700px){.introduction{display:flex;flex-direction:column-reverse}.hero-visual{height:290px;border-radius:0 0 35% 12% / 0 0 20% 8%;border-left:0;border-bottom:3px solid var(--gold)}.hero-copy{padding:30px 22px 44px}.hero-copy h1{font-size:39px}.hero-copy>p{font-size:14px}.hero-atouts{margin-top:23px;justify-content:space-between}.hero-atouts span{font-size:10px;gap:5px}.hero-atouts b{font-size:23px}.vague-hero{height:15px}.section-formules{padding:45px 18px 48px}.section-titre{margin-bottom:58px}.section-titre h2{font-size:32px}.section-titre p{font-size:13px}.grille-formules{grid-template-columns:1fr;gap:55px;max-width:440px}.carte-face{padding:0 24px 25px}.photo-formule{width:195px;height:195px}.badge-choix{right:-8px}.avantages{margin:0 14px 35px;border-radius:30px;padding:30px 16px}.avantages h2{font-size:20px;gap:10px}.avantages h2:before,.avantages h2:after{width:25px}.avantages-grille{gap:22px}.avantages-grille>div{gap:7px;padding:0 4px}.avantages-grille>div>span{width:53px;height:53px;font-size:28px}.avantages-grille strong{font-size:12px}.avantages-grille small{font-size:11px}.bandeau-devis{display:block;margin:0 12px 35px;border-radius:28px}.bandeau-photo{height:225px}.bandeau-photo:after{background:linear-gradient(0deg,#fff,transparent 50%)}.bandeau-texte{padding:15px 26px 40px}.bandeau-texte h2{font-size:28px}.bandeau-texte p{font-size:14px}}
  @media(prefers-reduced-motion:reduce){.carte-formule{transition:none}}

  /* Ajustements fidèles à la maquette validée */
  .page-menage .hero-copy h1{display:block!important;visibility:visible!important;opacity:1!important;color:#092747!important;font-size:clamp(42px,4.4vw,68px)!important;line-height:1.07!important;font-weight:850!important;letter-spacing:-1.8px!important;max-width:620px}
  .page-menage .hero-copy{isolation:isolate}
  .page-menage .hero-copy:before{z-index:-1}
  .page-menage .hero-atouts b{font-size:43px;min-width:43px;text-align:center;line-height:1}
  .page-menage .hero-atouts span{font-size:14px;gap:12px}
  .page-menage .avantages-grille>div>span{width:86px;height:86px;font-size:49px}
  .page-menage .bouton-decouvrir{min-height:55px;padding:17px 16px;font-size:15px;border-radius:32px}
  .page-menage .bouton-choisir{min-height:52px;align-items:center;font-size:15px;padding:16px 20px}
  .page-menage .bandeau-texte a{font-size:16px;min-height:54px;padding:17px 36px}
  .page-menage .badge-choix{right:-7px;top:-14px}
  .page-menage .carte-formule{box-shadow:0 20px 45px rgba(8,37,66,.19),0 5px 14px rgba(8,37,66,.07)}
