---
import SeoHead from '../components/SeoHead.astro';
import FloatingContact from '../components/FloatingContact.astro';
import '../styles/global.css';
import '../styles/bandeaux.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DevisSimpleModal from '../components/DevisSimpleModal.astro';
import CookieNotice from '../components/CookieNotice.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Maison & Monde | Ménage à domicile à Paris',
  description = 'Maison & Monde : ménage, repassage et nettoyage à Paris et en Île-de-France.',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <SeoHead title={title} description={description} />
  </head>

  <body>
    <a class="skip-link" href="#contenu-principal">
      Aller au contenu
    </a>
    <Header />
    <main id="contenu-principal">
      <slot />
    </main>
    <Footer />
    <DevisSimpleModal />
    <FloatingContact />
    <CookieNotice />
  </body>
</html>
