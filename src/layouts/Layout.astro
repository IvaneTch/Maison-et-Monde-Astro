---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DevisSimpleModal from "../components/DevisSimpleModal.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Maison & Monde | Ménage à domicile à Paris",
  description = "Maison & Monde : ménage, repassage et nettoyage à Paris et en Île-de-France.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <DevisSimpleModal />
  </body>
</html>