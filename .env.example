# Copier en .env sur la machine cible ; ne jamais versionner les mots de passe.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=maison_monde

# Valeurs publiques intégrées lors de npm run build.
PUBLIC_SITE_URL=https://maisonetmonde.fr
# Rester false pour toute préproduction ; activer uniquement lors de la mise en ligne validée.
PUBLIC_INDEXABLE=false

# Serveur Node (derrière un reverse proxy HTTPS en production).
HOST=127.0.0.1
PORT=4321

# Notifications internes : le formulaire reste opérationnel sans SMTP.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=info@maisonetmonde.fr
MAIL_TO=info@maisonetmonde.fr
